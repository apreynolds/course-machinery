#!/usr/bin/env bash
#
# pg-answer-variation — check that a .pg problem's ANSWERS change with the seed
# Usage: pg-answer-variation [-n SEEDS] [-q] FILE.pg|DIR ...
#
#   -n SEEDS   how many seeds to try, starting at 1 (default 8)
#   -q         print only the problems with a finding, not the ones that vary
#   -h         this text
#
# WHY THIS EXISTS. A harvested problem can look randomised and not be. The
# coefficients move, the graph is redrawn, and the correct answer is a literal
# that never changes -- so a student scores full marks by always giving the same
# response, and learns nothing. Nothing errors, so `pr-pg-render' is clean and a
# seed sweep reports 40/40 passing. Only comparing the ANSWERS across seeds finds
# it. Found 2026-09-10 in the CCCS collection, building MATH1003's practice sets.
#
# A CHOICE blank is one whose answer comes from a small closed set: a PopUp,
# radio buttons, checkboxes -- and a String, because in these corpora str_cmp is
# used for classification words (even/odd/neither, yes/no, None). A constant
# choice is gameable in a way a constant formula is not. String was added
# 2026-09-13: Determine_EOO_Abs_Even.pg is "even" on every seed and passed here
# while pg-profile, which already counted strings, flagged it.
#
# THREE VERDICTS, graded exactly as pg-profile grades them, so the two tools can
# never disagree about the same problem:
#
#   CONSTANT-CHOICE  every blank, a choice blank included, is the same on every
#                    seed. The problem is a giveaway and the classification it
#                    claims to assess is not assessed. This sets the exit status.
#
#   CHOICE-FIXED     a choice blank never changes while other blanks do. Only
#                    that one skill goes free, and it is a judgement whether the
#                    set relies on this problem for it -- so it is reported, not
#                    failed. Question2.pg's "enter None" part is the example of a
#                    fixed choice that is not a defect at all.
#
#   CONSTANT         every blank is the same, with no choice blank among them.
#                    Sometimes legitimate: a problem can randomise its wording
#                    while its domain and range genuinely do not depend on the
#                    draw. Still one-shot, so reported, not failed.
#
# Checking choice blanks separately is essential. A problem can vary in a formula
# blank while its classification never moves, which makes a whole-answer check
# report "varies" on exactly the problem most worth catching.
#
# Until 2026-09-13 any fixed choice failed, even with every other blank varying,
# which is stricter than pg-profile and would have failed Question2.pg.
#
# Exit status is 1 if any problem is CONSTANT-CHOICE, so this is usable as a gate
# before a candidate goes into a set.
#
# This does NOT prove a problem is good. It proves the answers move. Read the
# rendered output as well.

set -uo pipefail

seeds=8
quiet=0
targets=()

usage() { sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -n) shift; seeds=$1 ;;
        -q) quiet=1 ;;
        -*) echo "pg-answer-variation: unknown option $1" >&2; exit 2 ;;
        *)  targets+=("$1") ;;
    esac
    shift
done

if [ ${#targets[@]} -eq 0 ]; then
    echo "pg-answer-variation: nothing to check. Give a .pg file or a directory." >&2
    exit 2
fi

if ! command -v pr-pg-render > /dev/null; then
    echo "pg-answer-variation: pr-pg-render not found on PATH." >&2
    exit 2
fi

# The answer-type strings pr-pg-render prints for a choice blank (see above).
# Matched case-insensitively on the type column; keep in step with pg-profile's
# CHOICE_TYPES.
CHOICE_TYPES='popup|radio|checkbox|select|multiple|string'

# Collect the files first, so a directory and a file can be mixed freely.
files=()
for t in "${targets[@]}"; do
    if [ -d "$t" ]; then
        while IFS= read -r f; do files+=("$f"); done < <(find "$t" -name '*.pg' | sort)
    elif [ -f "$t" ]; then
        files+=("$t")
    else
        echo "pg-answer-variation: no such file or directory: $t" >&2
        exit 2
    fi
done

failed=0
n_const=0
n_choice=0
n_fixed=0
n_ok=0

for f in "${files[@]}"; do
    all_seen=""
    choice_seen=""
    has_choice=0

    for s in $(seq 1 "$seeds"); do
        # One render per seed. The answer lines look like
        #   AnSwEr0001   Value (PopUp)  Yes, it's a function.
        lines=$(pr-pg-render -s "$s" "$f" 2>/dev/null | grep -a '^ *AnSwEr')

        all_seen+="$(printf '%s' "$lines" | sed 's/^ *AnSwEr[0-9]*  *//' | tr '\n' '|')"$'\n'

        choice=$(printf '%s' "$lines" | grep -aiE "\((${CHOICE_TYPES})[^)]*\)")
        if [ -n "$choice" ]; then
            has_choice=1
            choice_seen+="$(printf '%s' "$choice" | sed 's/^ *AnSwEr[0-9]*  *//' | tr '\n' '|')"$'\n'
        fi
    done

    name=$(basename "$f" .pg)
    d_all=$(printf '%s' "$all_seen" | sort -u | grep -c . || true)
    d_choice=$(printf '%s' "$choice_seen" | sort -u | grep -c . || true)

    if [ "$d_all" -eq 0 ]; then
        printf '  NO ANSWERS      %s\n' "$name"
        continue
    fi

    if [ "$has_choice" -eq 1 ] && [ "$d_choice" -le 1 ] && [ "$d_all" -le 1 ]; then
        printf '  CONSTANT-CHOICE %s\n' "$name"
        printf '                  every blank, a choice blank included, is the same on all %s seeds\n' "$seeds"
        failed=1
        n_choice=$((n_choice + 1))
    elif [ "$has_choice" -eq 1 ] && [ "$d_choice" -le 1 ]; then
        printf '  CHOICE-FIXED    %s\n' "$name"
        printf '                  a choice answer never changes over %s seeds, though other blanks do -- free marks on that skill\n' "$seeds"
        n_fixed=$((n_fixed + 1))
    elif [ "$d_all" -le 1 ]; then
        printf '  CONSTANT        %s\n' "$name"
        printf '                  every blank identical on all %s seeds -- check whether that is legitimate\n' "$seeds"
        n_const=$((n_const + 1))
    else
        [ "$quiet" -eq 0 ] && printf '  varies          %-58s %s distinct\n' "$name" "$d_all"
        n_ok=$((n_ok + 1))
    fi
done

echo
printf '%s problems: %s vary, %s with a fixed choice, %s constant, %s constant including a choice\n' \
       "${#files[@]}" "$n_ok" "$n_fixed" "$n_const" "$n_choice"

exit "$failed"
