\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Hyperlinks}[2026/11/06 hyperref (loaded last) + \string\demo, \string\interactive]

% hyperref for the course classes, plus \demo (links out to an interactive tool)
% and \interactive (the same, with a catalogue entry behind it).
%
% Requires the loading class to have done, before \ProcessOptions:
%     \PassOptionsToPackage{dvipsnames}{xcolor}
% (named colours below need it, and xcolor's options must be set before anything
% else pulls xcolor in).

\RequirePackage{etoolbox} % \AtEndPreamble
\RequirePackage{xcolor}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% PER-CLASS HOOKS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Same pattern as TitleBlock.sty: defaults are the plain/lecture ones; a class
% overrides with \renewcommand before \begin{document}. They are read inside the
% \AtEndPreamble block below, i.e. late, so an override anywhere in the class or
% the document's preamble still wins.
\providecommand{\LinkColor}{black}
\providecommand{\UrlColor}{RoyalBlue}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% HYPERREF -- LOADED LAST
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% hyperref patches a great deal of LaTeX (\ref, sectioning, \tableofcontents,
% amsthm...), so anything loaded AFTER it can silently undo those patches. It
% must therefore load after every package the DOCUMENT loads, not merely after
% this class -- which is what \AtEndPreamble gives and \AtEndOfClass does not.
\AtEndPreamble{%
  \RequirePackage{hyperref}%
  \hypersetup{%
    colorlinks    = true,%
    linkcolor     = \LinkColor,%
    citecolor     = black,%
    urlcolor      = \UrlColor,%
    pdfstartview  = Fit,%
    pdfmenubar    = true,%
    pdftoolbar    = true,%
    bookmarksopen = false,%
  }%
}

% RETIRED 2026-08-13: a back-to-top anchor (\TopAnchorName = CourseTop, emitted at
% \AtBeginDocument) and \BackToTopLink{<stuff>} to jump to it. Its only caller was
% the grey arrow in LectureNotes' projector footer, which went unused in the room.
% Both are gone; nothing else referenced them.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \secref -- A CROSS-REFERENCE BY NAME
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   ...for online assessments (see \secref{sec:webwork}).
%       -> ...for online assessments (see the WeBWorK section).
%
% NO NUMBER, deliberately. A bare "see 3.4" makes the reader hold a coordinate
% and go hunting; the title tells them what they are being sent to, which is the
% thing they actually wanted to know. Numbers stay on the headings and in the
% table of contents, where they are an index rather than a sentence.
%
% But the number was also doing a second job -- signalling "this is a pointer" --
% and dropping it alone turns half a syllabus circular: "we use WeBWorK for
% assessments (see WeBWorK)", "five biweekly Tests (see Tests)". That is what the
% surrounding words are for. Same split as \demo below: the FORMAT hook owns the
% wording, the macro owns the linking, and only the title goes inside the link,
% because "the" and "section" are not part of what is being named.
%
% THE "the" IS INSIDE THE HOOK. Write `see \secref{x}', never `see the
% \secref{x}' -- the latter renders "the the WeBWorK section". A reference whose
% grammar the hook cannot produce (a plural, "sections A and B") should be
% written out by hand rather than bent into this.
%
% \nameref does NOT exist yet at this point in the file: it arrives with hyperref,
% which the block above defers to \AtEndPreamble. Harmless -- \secref is a body
% macro and nothing here is evaluated until the document proper.
\providecommand{\SecRefFormat}[1]{the #1 section}
\newcommand{\secref}[1]{\SecRefFormat{\hyperref[#1]{\nameref*{#1}}}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \demo -- LINK OUT TO AN INTERACTIVE TOOL
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   \demo{https://www.desmos.com/calculator/xxxxxxxx}
%   \demo[geogebra]{https://example.org/some/opaque/url}
%
% THE PRINCIPLE: students do not care which tool it is -- only the author does.
% A class that meets "LINK: DESMOS", "Desmos demo" and "LET'S EXPLORE WITH
% DESMOS!" on three consecutive pages is reading three different things when it
% is always the same thing: press here, a graph moves. So every demo gets ONE
% student-facing label, and the tool's identity is author-only metadata.
%
% Hence the optional argument is ACCEPTED AND DISCARDED (the same store-only
% idiom as ProblemMeta/FactMeta): it names the tool for a human reading the
% source, worth giving when the URL's domain does not already say. Nothing about
% it reaches the page.
%
% WHY THIS RATHER THAN A BARE \href, even for a one-off link:
%   - one student-facing label, so the notes do not invent new wording per page;
%   - one place to restyle every such link (\DemoLabel/\DemoMarker/\DemoFormat)
%     instead of hunting \href calls;
%   - the scheme-less-URL check below, which catches a dead link that renders
%     perfectly;
%   - and they stay countable: one macro means every interactive link in a
%     course can be listed, or fed to curl, with a grep -- rot found on your
%     schedule rather than in front of a class.
%
% Lives here rather than in TextRef.sty deliberately: a demo link has nothing to
% do with the textbook (it is your own Desmos page as often as not), and
% Hyperlinks is loaded by LectureNotes, CourseDocument AND Assessment, so \demo
% works in a syllabus and in a worked solution too.
%
% Assessment was the late arrival, and the reason it used to be excluded is
% worth keeping: a link on printed paper is a dead end. That judges the class by
% its student paper alone, though -- the -SOLUTIONS and -INSTRUCTOR copies are
% read on screen, and a solution is the natural home for "here is the graph
% moving". Put \demo in solutions, not in question stems.

% Knobs. The marker is \triangleright rather than the heavier \blacktriangleright
% because the latter is an amssymb symbol and this package deliberately requires
% no maths font (Assessment-adjacent classes may load neither).
\providecommand{\DemoLabel}{interactive graph}
\providecommand{\DemoMarker}{\ensuremath{\triangleright}}

% The whole rendering in one hook, so a course can restyle it (bracket it, put
% it on its own line, drop the marker) without touching the macro.
\providecommand{\DemoFormat}[1]{\href{#1}{\DemoMarker\,\DemoLabel}}

% SCHEME CHECK. A URL with no "://" is a RELATIVE URI: the viewer resolves it
% against the document's own location -- a local file path -- so the link is
% silently dead. `www.cbc.ca' pasted without its `https://' is the whole failure,
% and it looks perfectly fine on the page, which is what makes it worth catching.
% Same principle as TextRef's unresolved keys: degrade if you must, but say so.
%
% \Demo@scan is delimited-argument string surgery. The URL is always followed by
% a spare "://" so the pattern is guaranteed to match; whatever lands in #2 tells
% us whether the URL had a separator of its own:
%   https://x  ->  "https://x://"  -> #1=https, #2=x://  (non-empty: has scheme)
%   www.cbc.ca ->  "www.cbc.ca://" -> #1=the URL, #2=    (empty: no scheme)
% When #2 comes back empty there was no separator, and #1 is then the whole URL
% -- so the warning can name it without any bookkeeping.
\def\Demo@scan#1://#2\Demo@nil{%
  \ifstrempty{#2}%
    {\PackageWarning{Hyperlinks}{\string\demo\space URL has no scheme and will
       not be clickable: #1}}%
    {}%
}
\newcommand{\Demo@check}[1]{\Demo@scan#1://\Demo@nil}

\NewDocumentCommand{\demo}{o m}{\Demo@check{#2}\DemoFormat{#2}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \interactive -- A \demo WITH A CATALOGUE ENTRY BEHIND IT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   \interactive{evt-closed-interval}
%   \interactive[../../interactives/]{evt-closed-interval}   from a deeper file
%
% Prints a thumbnail of the graph, the same student-facing link label \demo
% prints, and a one-line caption saying WHAT the graph shows. Everything comes
% from one catalogue entry, a directory per graph:
%
%   <topic>/interactives/<slug>/meta.tex        \InteractiveMeta{...}, below
%   <topic>/interactives/<slug>/thumbnail.png   exported from the tool
%   (and, for GeoGebra/Jupyter, the substantive file itself)
%
% WHY A CATALOGUE AND NOT JUST \demo. Three things a bare URL cannot do: be
% SEARCHED before you build a graph that already exists (the duplicated Desmos
% graph that started this); say where the graph came from (mine, or an outdated
% book link); and tell the student what they are about to see. The uniform
% label principle above still holds for the tool's identity -- the caption is
% the new, student-facing part, and it says what moves, not which tool moves it.
%
% PER TOPIC, deliberately, beside figures/ and problems/: a graph belongs to
% the mathematics it shows, which is a topic repo's business.
%
% THE DIRECTORY ARGUMENT is literal, like \importproblem's, resolved against
% the file doing the calling (\import@path is prepended, so a problem file
% pulled in by \import or \subimport works too). The default suits a lecture,
% which sits one level below its topic root (ARCHITECTURE.md, "Import paths
% stay literal").
%
% PENDING ENTRIES BUILD CLEANLY. An entry is usually written before its graph
% exists -- the URL is empty and there is no thumbnail yet -- and a lecture
% that cites it must still meet the zero-warning bar. So a pending entry is NOT
% a warning: the thumbnail's place shows a plain frame, the label prints
% unlinked, and the instructor copy alone says "pending". The two things that
% ARE warnings are a slug with no meta.tex at all (a typo, never a plan) and a
% URL without a scheme (\demo's check, reused).

% \InteractiveMeta{url = ..., tool = ..., source = ..., shows = ..., tags = ...,
% section = ...} -- STORE-ONLY everywhere, the same idiom as \ProblemMeta: it
% compiles to nothing, and find tools grep it. Only inside \interactive is it
% given a meaning, locally, so the call can read the url and shows fields.
% Wrap any value containing a comma in braces.
\providecommand{\InteractiveMeta}[1]{}

% Knobs. Thumbnail width as a fraction of the line; the gap between the
% thumbnail and the text; the instructor-copy note for a pending entry.
\providecommand{\InteractiveDir}{../interactives/}
\providecommand{\InteractiveThumbWidth}{0.32\linewidth}
\providecommand{\InteractiveGap}{1em}
\providecommand{\InteractivePendingNote}{pending: no graph built yet}

% The fields \interactive reads. Every documented key is defined, so a
% misspelt one stops the build and names itself (keyval's own error), rather
% than being quietly ignored.
\RequirePackage{keyval}
\define@key{intmeta}{url}{\def\Int@url{#1}}
\define@key{intmeta}{shows}{\def\Int@shows{#1}}
\define@key{intmeta}{tool}{}
\define@key{intmeta}{source}{}
\define@key{intmeta}{tags}{}
\define@key{intmeta}{section}{}
\newcommand{\Int@read}[1]{\setkeys{intmeta}{#1}}

% The thumbnail, or a frame of the same width standing in for it.
\newcommand{\Int@thumb}{%
  \IfFileExists{\Int@path thumbnail.png}%
    {\includegraphics[width=\linewidth]{\Int@path thumbnail.png}}%
    {\fbox{\parbox[c][0.6\linewidth][c]{\dimexpr\linewidth-2\fboxsep-2\fboxrule}%
       {\centering\DemoMarker\,\DemoLabel}}}%
}

% The whole rendering, in one hook like \DemoFormat: thumbnail on the left,
% link label and caption on the right, both vertically centred. Inside it,
% \Int@url and \Int@shows hold the entry's fields (either may be empty).
\providecommand{\InteractiveFormat}{%
  \par\noindent
  \begin{minipage}[c]{\InteractiveThumbWidth}%
    \ifdefempty{\Int@url}{\Int@thumb}{\href{\Int@url}{\Int@thumb}}%
  \end{minipage}%
  \hspace{\InteractiveGap}%
  \begin{minipage}[c]{\dimexpr\linewidth-\InteractiveThumbWidth-\InteractiveGap\relax}%
    \raggedright
    \ifdefempty{\Int@url}{\DemoMarker\,\DemoLabel}{\DemoFormat{\Int@url}}%
    \ifdefempty{\Int@shows}{}{\par\Int@shows}%
    \ifdefempty{\Int@url}
      {\ifdef{\InstructorInline}{\par\InstructorInline{\InteractivePendingNote}}{}}%
      {}%
  \end{minipage}%
  \par
}

\NewDocumentCommand{\interactive}{O{\InteractiveDir} m}{%
  \begingroup
    \def\Int@url{}%
    \def\Int@shows{}%
    \edef\Int@path{\import@path #1#2/}%
    \IfFileExists{\Int@path meta.tex}%
      {\let\InteractiveMeta\Int@read
       \input{\Int@path meta.tex}%
       % Expanded first: \Demo@scan is string surgery on its argument's
       % TOKENS, and would see one macro, not the "://" inside it.
       \ifdefempty{\Int@url}{}{\expandafter\Demo@check\expandafter{\Int@url}}}%
      {\PackageWarning{Hyperlinks}{\string\interactive: no catalogue entry
         `#2' -- \Int@path meta.tex does not exist}}%
    \InteractiveFormat
  \endgroup
}
