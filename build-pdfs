#!/usr/bin/env bash
# build-pdfs — compile course .tex files into PDFs with latexmk
# Usage: build-pdfs [FILE.tex ...]
#
# With no arguments, compiles every *.tex file in the current directory.
# Each source FILE.tex produces FILE.pdf.
#
# Output mirror via a top-level .MIRRORDIR file: build-pdfs looks upward from the
# build directory for a .MIRRORDIR (at the repo top level, found the way .latexmkrc
# finds .course-machinery). Its first bare line names a base directory (a leading
# ~ is expanded) that mirrors the repo tree, so a source built in
# REPO/integrals/lectures ships to BASE/integrals/lectures. The mirror sub-
# directory is created if absent, but the base itself must exist — otherwise
# (e.g. the cloud is unmounted) build-pdfs warns and builds locally rather than
# scattering a stray tree. By default the build goes straight to the mirror (no
# local copy); add a line reading BOTH to build locally AND copy the PDF to the
# mirror, keeping both. Blank and #-comment lines are ignored; the path and the
# BOTH keyword may appear in either order. A nearer .MIRRORDIR (in a subdirectory)
# wins, letting a subtree mirror elsewhere. (COPY, a songsheets synonym for
# BOTH, is deliberately not wired here; it warns and is ignored.)
#
# Named destinations for selected views: besides the bare mirror-base line, a
# .MIRRORDIR may carry `LABEL: path' lines (e.g. `TA-dir: ~/shared/calc-ta'). A view
# in the magic comment below may name one with a colon suffix — `instructor:TA-dir'
# — which drops that view's PDF, flat, into the labelled directory IN ADDITION to
# the mirror. The labelled directory must already exist; a missing label or
# directory warns and skips that one extra copy without failing the build. This
# keeps machine-specific paths out of the (git-tracked) source: the source names a
# label, the git-ignored .MIRRORDIR maps it to a path.
#
# Views via a magic comment: a `%! views: ...' line in the leading comment block
# of a source (before \documentclass) requests extra PDFs. Four views are wired:
#   solutions -> also build FILE-SOLUTIONS.pdf, with \def\ShowSolutions{}
#                injected so \begin{solution} content the student build omits
#                is shown.
#   hints     -> also build FILE-HINTS.pdf, with \def\ShowHints{} injected so
#                \begin{hint} content is shown. Independent of solutions -- a hint
#                is student-facing help, so list both views for both PDFs.
#   projector -> also build FILE-PROJECTOR.pdf, with \def\ProjectorView{}
#                injected so the `LectureNotes' class switches to the room copy
#                (17pt, wider text, tighter top margin) instead of the handout.
#   instructor-> also build FILE-INSTRUCTOR.pdf, the instructor bundle: injects
#                \ShowSolutions + \ShowHints + \ShowInstructorNotes, so the
#                instructor copy shows solutions, hints, the slate staff notes,
#                and the page-edge frame. A view is a bundle of layers. (The
#                instructor copy IS the staff copy -- TAs get it too; there is no
#                separate marker tier.)
# Any other view name warns and is skipped.
# View PDFs follow the same mirror / BOTH handling as the default build. Any view
# may take a `:LABEL' suffix (see above) to also drop a flat copy into a named
# directory. `default' is a pseudo-view naming the base (student) PDF itself, wired
# only so it too can carry such a label -- a bare `default' is a harmless no-op.
#
# NB the class reads these as \ifdefined, so the same source builds both ways
# with no option at the call site -- see LectureNotes.cls / Assessment.cls.
#
# Cover page via a magic comment: a `%! coverpage: yes' line in the same leading
# block additionally writes FILE_COVERPAGE.pdf, page 1 of the finished PDF on its
# own, for printing an assessment's cover separately. `no' or no line at all is
# off; any other value warns. It is taken from the base (student) PDF only, not
# from any view, and follows the same mirror / BOTH handling as that PDF.
#   Why page 1 is cut out of the built PDF rather than selected during the run:
# the cover's own numbers are two-pass values. \printtotalpoints is a totcount
# sum written to the .aux at end-of-document, and the footer's "Page 1 of N" is
# \pageref{LastPage}. The LaTeX package for this, `pagesel', suppresses the .aux
# and aborts the job after the last selected page, so it prints the point total
# WRONG -- the reason this feature is a post-process. Needs ghostscript, which
# build-images already requires; without it the extract is skipped with a warning
# and the build still succeeds.
#
# Auxiliary files (.aux/.log/etc.) go to a per-directory folder under
# $XDG_CACHE_HOME/latexmk/ -- ~/.cache/latexmk/ when that is unset -- so they
# clutter neither the repo nor the output directory.
# The folder is keyed by the directory's repo-relative path (so two topics'
# same-named subdirectories never share latexmk state).
# TEXINPUTS comes from a .latexmkrc in the build directory, and this script
# installs it: latexmk reads only the rc in its startup directory and never walks
# up, so before compiling, build-pdfs drops a verbatim copy of
# .course-machinery/latexmkrc-shared into the source's own directory whenever the
# one there is missing or out of date. A new topic folder therefore needs no
# manual step. A copy whose `managed by build-pdfs' marker line has been deleted
# is treated as hand-tuned and never touched.

# Bash 4+ is required (associative arrays, mapfile, ${var,,}). Written in 3.2-
# compatible syntax and placed before any of those, so an old bash reaches this
# message instead of failing with "declare: -A: invalid option" further down.
# macOS still ships bash 3.2 as /bin/bash and always will (it is GPLv2).
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  printf '%s: requires bash 4.0 or newer (running %s).\n' \
    "${0##*/}" "${BASH_VERSION:-not bash}" >&2
  printf 'macOS ships bash 3.2; install a newer one (e.g. `brew install bash`)\n' >&2
  printf 'and make sure it comes before /bin/bash on your PATH.\n' >&2
  exit 1
fi

set -uo pipefail

# LATEXMK-AUX-CONTRACT -- the ~/.cache/latexmk aux-dir scheme is derived
# independently in FIVE places. `rg LATEXMK-AUX-CONTRACT' lists them all:
#   1. ~/.config/vim/custom/vimtex.vim        s:TexCacheRoot / s:TexAuxKey
#   2. this file                              cache_root / aux_key
#   3. songs-machinery/build-pdfs             basename-only variant
#   4. ~/.config/scripts/bin/pr-latexmk       verbatim copy of (2)
#   5. scripts/bin/machine-sync/latexmk-clear prunes the directory
# Change one, change all -- divergence is silent (an unreadable log reads as
# "no errors", not "wrong path"). (3) and (5) hardcode $HOME/.cache and would
# need updating first if XDG_CACHE_HOME were ever set.
#
# Where auxiliary files live. Honours XDG_CACHE_HOME; without it, the default is
# the same ~/.cache path this has always used, so nothing moves for anyone who
# has not set the variable. NB two other consumers assume this root -- see
# TODO.md -- so if you ever set XDG_CACHE_HOME, they need to follow.
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}

# Where the machinery lives: this script sits at its top level, so its own path
# is the answer. Resolved ONCE, here, and absolute -- build_file cd's into each
# source's directory, after which a relative $0 would point nowhere.
machinery_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# Unwrap pdflatex's 79-column log lines so multi-line warnings keep their
# "on input line N" tails intact for log parsers -- vim's quickfix reads these
# logs (custom/vimtex.vim), and vimtex exports the same value for its own
# compiles. pdflatex picks the value up from the environment (kpathsea).
export max_print_line=2000

usage() {
  # Reprint the header block (line 2 to the first blank line), stripping the
  # leading "# ", so -h stays in sync with the comment above.
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

# Honour -h/--help anywhere in the arguments, not just first -- `build-pdfs
# foo.tex --help' should print help, not count --help as a failed build.
for arg in "$@"; do
  case $arg in
    -h | --help)
      usage
      exit 0
      ;;
  esac
done

# A `LABEL: path' named-destination line: a label (letters, digits, _ or -),
# a colon, then REQUIRED whitespace. The space is load-bearing -- it keeps a
# Windows-style bare path like C:/course-pdfs parseable as a path (see
# NOTE-ON-WINDOWS.md in the course-demo repo, one level up from this submodule).
# The ONE classifier, shared by parse_dest_file (which
# skips these lines) and resolve_label (which reads them), so the two parsers
# can never disagree about what counts as a label line.
is_label_line() {
  [[ $1 =~ ^[A-Za-z0-9_-]+:[[:space:]] ]]
}

# Parse a .MIRRORDIR file for its mirror base: blank and #-comment lines are ignored,
# an optional BOTH keyword and the bare base path may appear in either order, and
# `LABEL: path' named-destination lines are skipped here (resolve_label reads
# those). Echoes two lines — the mode (MOVE or BOTH) then the base path (a leading
# ~ expanded) — or warns and echoes nothing if the file names no base at all.
# VALIDATING the base is the caller's job (read_mirrordir requires it to exist; it
# creates the mirror sub-directory itself). (COPY, a songsheets synonym for BOTH,
# is deliberately not wired here: it warns and is ignored, so a songsheets
# .MIRRORDIR carried over cannot silently lose its mirror base to the keyword.)
parse_dest_file() {
  local f=$1 line trimmed lower path="" mode="MOVE"
  while IFS= read -r line || [[ -n $line ]]; do
    # Trim surrounding whitespace (covers a trailing CR too).
    trimmed=${line#"${line%%[![:space:]]*}"}
    trimmed=${trimmed%"${trimmed##*[![:space:]]}"}
    [[ -z $trimmed || ${trimmed:0:1} == "#" ]] && continue   # blank / comment
    lower=${trimmed,,}
    if [[ $lower == both ]]; then
      mode="BOTH"                  # keep a local copy too
      continue
    fi
    if [[ $lower == copy ]]; then
      echo "build-pdfs: $f: COPY is a songsheets keyword, not recognised here -- ignored" >&2
      continue
    fi
    # A `LABEL: path' line is a named view destination, resolved separately by
    # resolve_label -- never the bare mirror-base path.
    is_label_line "$trimmed" && continue
    if [[ -z $path ]]; then
      path=$trimmed                # first non-keyword line = path
      # `TA-dir:/x' (no space after the colon) is NOT a label line, so it just
      # became the mirror base -- almost certainly a mistyped label. Warn but
      # carry on; read_mirrordir's base-must-exist check is the backstop.
      # ({2,} spares a Windows drive letter like C:/ the false alarm.)
      if [[ $trimmed =~ ^[A-Za-z0-9_-]{2,}:[^[:space:]] ]]; then
        echo "build-pdfs: $f: '$trimmed' taken as the mirror base, but it looks like a label line missing the space after ':'" >&2
      fi
    fi
  done <"$f"

  if [[ -z $path ]]; then
    echo "build-pdfs: $f has no directory path, building locally" >&2
    return 0
  fi
  printf '%s\n%s\n' "$mode" "${path/#\~/$HOME}"
}

# Echo the path of the .MIRRORDIR governing the cwd: the nearest ancestor holding a
# .MIRRORDIR (the repo top level, the way .latexmkrc finds .course-machinery), or
# also its own root when found. Echoes two lines — the .MIRRORDIR file path then the
# directory that holds it — or nothing when no .MIRRORDIR exists above. Shared by the
# mirror resolver and the label resolver so both agree on which .MIRRORDIR is in force.
find_mirrordir_file() {
  local root=$PWD
  while [[ $root != / && ! -f $root/.MIRRORDIR ]]; do
    root=$(dirname -- "$root")
  done
  [[ -f $root/.MIRRORDIR ]] || return 0
  printf '%s\n%s\n' "$root/.MIRRORDIR" "$root"
}

# Resolve the mirror directory from the governing top-level .MIRRORDIR file. Reads a
# base directory from it (first bare non-comment line; a leading ~ expands; an
# optional BOTH line keeps a local copy too). The PDF ships to the base with the
# cwd's path relative to the .MIRRORDIR's own directory appended, so
# REPO/integrals/lectures mirrors to BASE/integrals/lectures. That mirror sub-
# directory is created if missing, but the base itself must exist — if it doesn't,
# warn and build locally rather than materialising a stray tree. Echoes two lines
# (mode, dest) on success, or nothing when the caller should build locally.
read_mirrordir() {
  local finfo f root info base mode rel dest
  finfo=$(find_mirrordir_file)
  [[ -n $finfo ]] || return 0          # no .MIRRORDIR anywhere above -> build locally
  { read -r f; read -r root; } <<<"$finfo"

  info=$(parse_dest_file "$f")
  [[ -n $info ]] || return 0
  { read -r mode; read -r base; } <<<"$info"
  if [[ ! -d $base ]]; then
    echo "build-pdfs: .MIRRORDIR base '$base' is not a directory, building locally" >&2
    return 0
  fi

  # Mirror the cwd's path relative to the .MIRRORDIR's directory under the base.
  rel=${PWD#"$root"}; rel=${rel#/}
  dest=$base${rel:+/$rel}
  if ! mkdir -p -- "$dest"; then
    echo "build-pdfs: could not create .MIRRORDIR path '$dest', building locally" >&2
    return 0
  fi
  printf '%s\n%s\n' "$mode" "$dest"
}

# Resolve a named view destination from the governing .MIRRORDIR: find the first
# `LABEL: path' line whose label matches $1, expand a leading ~, and require the
# path to be an existing directory. Echoes the directory on success, or warns and
# echoes nothing (no .MIRRORDIR, no such label, or the path is missing / not a
# directory) so the caller skips that one flat copy without failing the build.
resolve_label() {
  local label=$1 finfo f root line trimmed path
  finfo=$(find_mirrordir_file)
  if [[ -z $finfo ]]; then
    echo "build-pdfs: view label '$label' needs a .MIRRORDIR, skipping extra copy" >&2
    return 0
  fi
  { read -r f; read -r root; } <<<"$finfo"

  while IFS= read -r line || [[ -n $line ]]; do
    trimmed=${line#"${line%%[![:space:]]*}"}
    trimmed=${trimmed%"${trimmed##*[![:space:]]}"}
    # Same shape test as parse_dest_file skips, so a line one parser treats as
    # a label the other can never treat as the mirror base (and vice versa).
    is_label_line "$trimmed" || continue
    [[ $trimmed == "$label:"* ]] || continue
    path=${trimmed#"$label":}                       # strip 'LABEL:'
    path=${path#"${path%%[![:space:]]*}"}           # trim leading space
    path=${path%"${path##*[![:space:]]}"}           # trim trailing space
    path=${path/#\~/$HOME}
    break
  done <"$f"

  if [[ -z ${path:-} ]]; then
    echo "build-pdfs: view label '$label' not found in $f, skipping extra copy" >&2
    return 0
  fi
  if [[ ! -d $path ]]; then
    echo "build-pdfs: view label '$label' path '$path' is not a directory, skipping extra copy" >&2
    return 0
  fi
  printf '%s\n' "$path"
}

# Drop one built PDF, flat, into the .MIRRORDIR destination named by a view label.
# Additive: this is an extra copy on top of the mirror, never a replacement. A
# label that does not resolve (resolve_label already warned) is skipped, and a
# failed copy warns but does not abort the build.
#   $1 directory the built PDFs live in   $2 pdf filename   $3 view label
ship_label() {
  local pdfdir=$1 file=$2 label=$3 dest
  dest=$(resolve_label "$label")
  [[ -n $dest ]] || return 0
  if cp -- "$pdfdir/$file" "$dest/"; then
    echo "    -> $label: $file"
  else
    echo "build-pdfs: could not copy $file to '$dest' for label '$label'" >&2
  fi
}

# Install the build directory's .latexmkrc from the machinery's master copy, so
# latexmk finds the machinery on TEXINPUTS (see the header). Called from inside
# build_file, after the cd, so `.latexmkrc' here means the SOURCE's directory.
#
# Three ways to do nothing, in order: an older submodule with no master to copy
# (stay silent -- the directory's own copy, if any, still works); a copy whose
# marker line has been deleted, which means someone tuned it by hand and owns it
# now; and a copy that already matches. That last test is a content comparison
# rather than an unconditional cp so mtimes stay put and `git status' stays quiet
# -- $(...) strips trailing newlines from both sides, which is harmless here.
# Deliberately not rsync: its default quick-check is size+mtime, and a submodule
# checkout restamps mtimes, so identical files would copy anyway; -c would fix
# that but Git for Windows ships no rsync (see NOTE-ON-WINDOWS.md in the
# course-demo repo, one level up from this submodule).
ensure_latexmkrc() {
  local src=$machinery_dir/latexmkrc-shared
  [[ -e $src ]] || return 0
  if [[ -e .latexmkrc ]]; then
    grep -q 'managed by build-pdfs' .latexmkrc || return 0
    [[ "$(cat .latexmkrc)" == "$(cat "$src")" ]] && return 0
  fi
  cp -- "$src" .latexmkrc && echo "    .latexmkrc: installed"
}

# LATEXMK-AUX-CONTRACT -- this function is the ORIGINAL; pr-latexmk holds a
# verbatim copy and vimtex.vim's s:TexAuxKey mirrors it in vimscript. Improve it
# here, then re-copy; see the roster by cache_root above.
#
# Aux-dir key for the current directory: its path RELATIVE TO THE REPO ROOT
# (the nearest ancestor holding .course-machinery, found the way .latexmkrc
# finds it), slashes flattened to '-'. The old key was the bare directory name,
# so same-named directories in different topics (differentiation/problems and
# curve-sketching/problems) shared one latexmk aux dir and cross-contaminated
# its state. Outside any repo, fall back to the bare name as before.
aux_key() {
  local root=$PWD rel
  while [[ $root != / && ! -d $root/.course-machinery ]]; do
    root=$(dirname -- "$root")
  done
  if [[ -d $root/.course-machinery ]]; then
    rel=${PWD#"$root"}; rel=${rel#/}
    printf '%s' "${rel:+${rel//\//-}}"
    [[ -n $rel ]] || printf 'repo-root'
  else
    printf '%s' "${PWD##*/}"
  fi
}

# Read one key out of a source's leading magic-comment block. Recognises lines of
# the form `%! KEY: value' (flexible spacing) and echoes the value, trailing
# whitespace trimmed, one line per matching line. Scanning stops at the first
# line that is neither blank nor a `%'-comment, so only the leading block
# (before \documentclass) is consulted.
#
# The block is the house idiom for per-file build requests and now has more than
# one key here (`views', `coverpage'), so the scan lives in ONE place and each
# key's own parsing sits on top of it. build-d2l-import.py reads its `d2l-*' keys
# out of the same block with a single regex, for the same reason.
#   $1 key  $2 file
read_magic() {
  local key=$1 file=$2 line val
  while IFS= read -r line; do
    # First real (non-blank, non-comment) line ends the magic-comment block.
    if [[ -n $line && ${line#\%} == "$line" ]]; then
      break
    fi
    # $key unquoted so it lands in the regex as a literal word; every key here is
    # a plain identifier, so there is nothing in it for the regex engine to read.
    if [[ $line =~ ^%![[:space:]]*$key[[:space:]]*:[[:space:]]*(.*)$ ]]; then
      val=${BASH_REMATCH[1]}
      val=${val%"${val##*[![:space:]]}"}    # trim trailing space
      printf '%s\n' "$val"
    fi
  done <"$file"
}

# The `%! views: a, b, c' request: split read_magic's value on commas and echo one
# view token per line, whitespace trimmed. One token per LINE rather than one
# space-separated string, because a token may carry a space -- a `:LABEL' naming
# a .MIRRORDIR destination like `instructor:TA dir' -- and build_file's mapfile
# depends on the line split to keep it whole.
read_views() {
  local file=$1 val tok toks
  while IFS= read -r val; do
    IFS=',' read -ra toks <<<"$val"
    for tok in "${toks[@]}"; do
      # Trim surrounding whitespace.
      tok=${tok#"${tok%%[![:space:]]*}"}
      tok=${tok%"${tok##*[![:space:]]}"}
      [[ -n $tok ]] && printf '%s\n' "$tok"
    done
  done < <(read_magic views "$file")
}

# Build a view of a document: inject a \def before \input to flip a class toggle,
# writing to a distinct -jobname so the view lands at its own PDF. Forced with -g
# because the source is unchanged, so latexmk's up-to-date check would otherwise
# skip the rebuild. The -pdflatex override reproduces the default invocation with
# the \def prepended (hence the nested quoting).
#   $1 jobname  $2 source  $3 auxdir  $4 jobname suffix
#   $5 injected TeX  $6 -outdir path (empty for a local build)
compile_view() {
  local jobname=$1 src=$2 auxdir=$3 suffix=$4 inject=$5 movedir=$6
  latexmk -pdf -g -auxdir="$auxdir" ${movedir:+"-outdir=$movedir"} -jobname="$jobname$suffix" \
    -pdflatex="pdflatex %O -interaction=nonstopmode \"$inject \\input{%S}\"" \
    "$src"
}

# Whether a source asks for a cover-page extract: `%! coverpage: yes'. An
# unrecognised value warns and is ignored, the way an unknown view name does, so
# a typo is visible rather than silently off. A repeated key takes the last one.
# An absent key and an empty value both mean "not asked for", and say nothing.
#   $1 file
wants_coverpage() {
  local file=$1 val
  val=$(read_magic coverpage "$file" | tail -n 1)
  case $val in
    "" | no) return 1 ;;
    yes)     return 0 ;;
    *)
      echo "build-pdfs: coverpage '$val' not understood (expected yes or no), skipping" >&2
      return 1
      ;;
  esac
}

# Extract page 1 of a built PDF to FILE_COVERPAGE.pdf, so a test's cover can be
# printed on its own (a different paper, a different count) without printing the
# paper behind it.
#
# Deliberately a POST-PROCESS rather than a LaTeX page-selection package. The
# obvious package, `pagesel', cannot work here: it calls \nofiles by default, so
# no .aux is written, and it aborts the job after the last selected page. The
# cover's own numbers are two-pass values read back from that .aux --
# \printtotalpoints is a totcount total written at end-of-document
# (Exercises.sty), and the footer's "Page 1 of N" is \pageref{LastPage} -- so a
# run that never reaches \end{document} prints the total WRONG. Cutting the page
# out of a normally-built PDF cannot be wrong.
#
# gs, not a new dependency: build-images already requires it. -dAutoRotatePages
# =/None because pdfwrite otherwise re-orients a page from its text direction,
# which would turn a [legalpaper] cover the wrong way.
#
# Never fatal, and never returns false: a missing gs or a failed extraction warns
# and leaves the build's own success alone.
#
# gs's chatter is captured rather than printed, and shown only if it FAILS. Even
# under -q a one-page extract of a hyperref'd document always reports the links
# it had to drop ("Destination page 3 lies outside the valid page range",
# "Outline has invalid link that was discarded") -- inherent to taking one page
# out of a linked document, so it is noise every time, and noise in a build log
# reads as breakage.
#   $1 directory the built PDF lives in   $2 jobname
extract_coverpage() {
  local pdfdir=$1 job=$2 out="$2_COVERPAGE.pdf" log
  if ! command -v gs >/dev/null 2>&1; then
    echo "build-pdfs: ghostscript (gs) not found, skipping $out" >&2
    return 0
  fi
  if log=$(gs -q -dBATCH -dNOPAUSE -dFirstPage=1 -dLastPage=1 \
              -sDEVICE=pdfwrite -dAutoRotatePages=/None \
              -sOutputFile="$pdfdir/$out" "$pdfdir/$job.pdf" 2>&1); then
    echo "    + $out (cover page)"
  else
    echo "build-pdfs: could not extract the cover page of $job.pdf" >&2
    [[ -n $log ]] && printf '%s\n' "$log" >&2
  fi
  # Explicit: the last statement above can be false, and this must never be the
  # thing that fails a build.
  return 0
}

# Build one .tex file. Runs in a subshell so the cd stays local to this build.
build_file() {
  local src=$1 dir base jobname auxkey auxdir outinfo mode outdir movedir pdfdir
  local views view name label suffix inject varaux
  dir=$(dirname -- "$src")
  base=$(basename -- "$src")
  jobname=${base%.tex}

  (
    # Compile in the source's own directory so the PDF lands next to the source
    # (latexmk's out-dir defaults to cwd) and the .latexmkrc there is picked up --
    # which is also why ensure_latexmkrc runs here, once we are in that directory.
    cd "$dir" || exit
    ensure_latexmkrc
    auxkey=$(aux_key)
    auxdir="$cache_root/latexmk/$auxkey-$jobname"
    mkdir -p "$auxdir" || exit

    # Output mirror: a governing top-level .MIRRORDIR mirrors the PDF to its base
    # tree (see header). read_mirrordir echoes two lines (mode, dest) or nothing.
    # MOVE (default): -outdir writes the PDF straight to the mirror. BOTH: build
    # locally (out-dir defaults to cwd), then copy the PDF to the mirror. movedir
    # carries the -outdir path for the MOVE case only, so BOTH keeps its local
    # build.
    mode=""; outdir=""; movedir=""
    outinfo=$(read_mirrordir)
    if [[ -n $outinfo ]]; then
      { read -r mode; read -r outdir; } <<<"$outinfo"
      if [[ $mode == BOTH ]]; then
        echo "    -> mirror: $outdir (local copy kept)"
      else
        movedir="$outdir"
        echo "    -> mirror: $outdir"
      fi
    fi

    # -interaction=nonstopmode: without it a TeX error drops pdflatex to its
    # interactive `?' prompt and the build hangs waiting for input. The view
    # builds already run nonstop (compile_view's -pdflatex override); this
    # keeps the base build's failure mode the same as theirs.
    latexmk -pdf -interaction=nonstopmode -auxdir="$auxdir" ${movedir:+"-outdir=$movedir"} "$base" || exit
    echo "    ok: $jobname.pdf"
    if [[ $mode == BOTH ]]; then
      cp -- "$jobname.pdf" "$outdir/" || exit
    fi

    # Where the built PDFs actually live, for the flat `:LABEL' copies below: the
    # mirror dir in MOVE mode, else the local build dir (BOTH keeps a local copy;
    # no .MIRRORDIR builds locally).
    pdfdir="."; [[ -n $movedir ]] && pdfdir="$movedir"

    # Cover page requested via `%! coverpage: yes'. Taken from the BASE build
    # only, never from a view -- a solutions or instructor cover is the same
    # sheet of paper, and it is the student cover that gets printed on its own.
    # Placed here, before the views loop, for that reason: it belongs to the
    # build just finished. $pdfdir is already the right directory in both output
    # modes, so only the extra BOTH copy needs a mode test.
    if wants_coverpage "$base"; then
      extract_coverpage "$pdfdir" "$jobname"
      # An `if' (not `&&') for the same reason as at the end of the views loop
      # below -- and it matters more here, since a source with no `%! views:'
      # line makes this block the subshell's last statement, where a trailing
      # false would have build_file report the whole file FAILED. The -f test
      # keeps a skipped extraction (no gs) from failing the copy.
      if [[ $mode == BOTH && -f "${jobname}_COVERPAGE.pdf" ]]; then
        cp -- "${jobname}_COVERPAGE.pdf" "$outdir/" || exit
      fi
    fi

    # Extra views requested via `%! views: ...' in the source's leading comment.
    # A view is just a jobname SUFFIX plus the \def(s) to inject -- the case sets
    # those two and one shared block below does the rest, so a new view is a
    # one-line arm. Each view gets its own aux dir (so it never clobbers the main
    # build's log) and follows the same MOVE/BOTH output handling as the default
    # build above. A `view:LABEL' token additionally drops a flat copy into the
    # named .MIRRORDIR destination; `default:LABEL' does the same for the base PDF.
    # mapfile, not `for view in $(...)': read_views emits one token per line,
    # and word-splitting would shred a token containing a space (a label like
    # `instructor:TA dir') and glob-expand any stray * against the build dir.
    mapfile -t views < <(read_views "$base")
    for view in "${views[@]}"; do
      name=$view; label=""
      if [[ $view == *:* ]]; then name=${view%%:*}; label=${view#*:}; fi
      case $name in
        # The base PDF is already built; only a :LABEL does anything here.
        default)    [[ -n $label ]] && ship_label "$pdfdir" "$jobname.pdf" "$label"
                    continue ;;
        solutions)  suffix="-SOLUTIONS";  inject="\\def\\ShowSolutions{}" ;;
        hints)      suffix="-HINTS";      inject="\\def\\ShowHints{}" ;;
        projector)  suffix="-PROJECTOR";  inject="\\def\\ProjectorView{}" ;;
        # A view is a BUNDLE of content layers: instructor = solutions + hints
        # + the staff-notes tier (see InstructorNotes.sty's view model).
        instructor) suffix="-INSTRUCTOR"; inject="\\def\\ShowSolutions{}\\def\\ShowHints{}\\def\\ShowInstructorNotes{}" ;;
        *)
          echo "build-pdfs: view '$name' not yet supported, skipping" >&2
          continue
          ;;
      esac
      varaux="$cache_root/latexmk/$auxkey-$jobname$suffix"
      mkdir -p "$varaux" || exit
      compile_view "$jobname" "$base" "$varaux" "$suffix" "$inject" "$movedir" || exit
      echo "    + $jobname$suffix.pdf ($name)"
      if [[ $mode == BOTH ]]; then cp -- "$jobname$suffix.pdf" "$outdir/" || exit; fi
      # An `if' (not `&&') so a label-less view leaves exit status 0 -- this is
      # the loop's (and so the subshell's) last statement, and a trailing false
      # here would make build_file wrongly report the whole file FAILED.
      if [[ -n $label ]]; then ship_label "$pdfdir" "$jobname$suffix.pdf" "$label"; fi
    done
  )
}

# Collect the files to build: explicit arguments, or every *.tex in cwd.
if [[ $# -gt 0 ]]; then
  files=("$@")
else
  shopt -s nullglob
  files=(*.tex)
  shopt -u nullglob
fi

if [[ ${#files[@]} -eq 0 ]]; then
  echo "build-pdfs: no .tex files found" >&2
  exit 1
fi

failed=()
for src in "${files[@]}"; do
  if [[ ! -f $src ]]; then
    echo "build-pdfs: skipping '$src' (not a file)" >&2
    failed+=("$src")
    continue
  fi
  echo "==> $src"
  if ! build_file "$src"; then
    echo "build-pdfs: FAILED on '$src'" >&2
    failed+=("$src")
  fi
done

if [[ ${#failed[@]} -gt 0 ]]; then
  echo "build-pdfs: ${#failed[@]} of ${#files[@]} failed: ${failed[*]}" >&2
  exit 1
fi
