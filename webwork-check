#!/usr/bin/env bash
#
# webwork-check — verify the WeBWorK problem trees in this course's topic repos
# Usage: webwork-check [--paths] [--drift] [TOPIC ...]
#
# Two independent checks. With no flags, both run.
#
#   --paths   Every reference to a problem resolves. There are two kinds:
#
#             - `source_file` lines, in the .def files in the course's WEBWORK/
#               directory (_assessments/webwork-assignments/ is the old name for
#               it, still honoured) and in any .def under a topic's
#               webwork-sets/, except the generated webwork-sets/_for-upload/.
#             - symlinks, in every group directory under a topic's
#               webwork-sets/. Each must resolve to a file. In a SETTLED group
#               directory it must also be relative and land inside that topic's
#               own webwork/ -- a link still pointing at an upstream clone
#               means the problem was never forked -- and a .pg there that is
#               not a link is an error too. A draft directory, named
#               *--CANDIDATES-CLAUDE, may link anywhere.
#
#             This is the check that would have caught the Module 6
#             renumbering hazards, where a set referenced a problem upstream had
#             quietly renumbered away. Finding NO references of either kind is
#             itself a failure -- see the note at the end of the check.
#
#   --drift   Every .pg file under a topic's webwork/diffyqs/ and webwork/opl/
#             either matches the reference clone it was copied from, or records
#             the blob hash it was copied from and is checked against that.
#             This is what the source-shaped layout buys: it answers "did
#             upstream fix something I should look at, and have I accidentally
#             edited a file I'm supposed to be tracking?"
#
# TOPIC restricts --drift, and the topic half of --paths, to named topic
# directories; default is every one with a webwork/ or webwork-sets/ in it. The
# course-level .def files are always checked: each names its own topics, so
# there is nothing per-topic to narrow.
#
# WEBWORK_SETS_DIR overrides where the .def files are looked for; DIFFYQS_CLONE,
# OPL_CLONE and OPL_CONTRIB override the reference clones, and OPL_ROOT moves
# the last two together.
#
# Expected steady state: paths all resolve, drift reports nothing but counts.
# A file you have edited STAYS where it is and records an UPSTREAM-BLOB line;
# webwork/local/ is for problems that are ours outright — written here, or
# rewritten far enough that upstream's author no longer belongs on them.
#
# Exit status is 1 if any check failed, so this is usable in a pre-push hook.
#
# KNOWN GAPS in --paths, both found on math1003's older sets:
#
#   - A server-flat `local/...' path, with no topic in front of it -- the form
#     the diagnostic test's .def uses -- matches none of the source forms below
#     and reports as UNKNOWN SOURCE, although it may be fine on the server.
#   - A gateway quiz's `group:<name>' pool references are not modelled at all,
#     so a gateway .def written that way can never pass.

set -uo pipefail

# Reference clones. These are read-only upstreams, never edited in place.
#
# The OPL clone has TWO problem trees side by side, and the distinction matters
# because a course can draw on either:
#
#   OpenProblemLibrary/  the curated library, served at templates/Library/
#   Contrib/             contributed collections, served at templates/Contrib/
#
# They are siblings, so a single OPL_CLONE pointing at OpenProblemLibrary/
# cannot see Contrib/ at all -- which is why every Contrib problem used to be
# reported GONE, and every `source_file = Contrib/...' line as UNKNOWN SOURCE.
# OPL_CLONE keeps its old meaning so existing overrides still work.
DIFFYQS_CLONE=${DIFFYQS_CLONE:-$HOME/2teach/diffyqs-webwork-clone}
OPL_ROOT=${OPL_ROOT:-$HOME/2teach/webwork-open-problem-library-clone}
OPL_CLONE=${OPL_CLONE:-$OPL_ROOT/OpenProblemLibrary}
OPL_CONTRIB=${OPL_CONTRIB:-$OPL_ROOT/Contrib}

# This script lives in the MACHINERY, which is mounted at
# <course>/.course-machinery/ -- so the course repo is its parent, not its own
# directory. Getting this wrong is not a small error: REPO is what every topic
# path, every problem lookup and SETS_DIR below are built from, so a wrong
# answer means the script quietly examines an empty tree.
MACHINERY=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO=${COURSE_ROOT:-$(dirname "$MACHINERY")}

if [ ! -d "$REPO/.course-machinery" ]; then
    echo "$(basename "${BASH_SOURCE[0]}"): cannot find the course repo." >&2
    echo "  Looked in: $REPO" >&2
    if [ -n "${COURSE_ROOT:-}" ]; then
        echo "  (from COURSE_ROOT)" >&2
    else
        echo "  (the parent of $MACHINERY)" >&2
    fi
    echo "  That has no .course-machinery/ in it, so it is not a course repo." >&2
    echo "  Set COURSE_ROOT if the machinery is mounted somewhere unusual." >&2
    exit 2
fi

# Where the COURSE-LEVEL set definitions live. Since 2026-09-13 that is only the
# sets that draw on several topics -- a gateway, a diagnostic, a review. A
# single-section practice set is curated inside its topic, as group directories
# of symlinks under <topic>/webwork-sets/, and its .def is generated from them.
# That is safe for a topic repo meant to be reused by another course, because
# what it commits is only membership and order; dates, headers and set type are
# the generator's parameters. So this directory may now legitimately be absent.
# Must come after REPO, which it reads.
#
# WEBWORK/ is the current name. It replaced _assessments/webwork-assignments/
# on 2026-09-10: math1003 organises its top-level directories by AUDIENCE
# (SYLLABUS/, TAs/, ADMIN/, TESTS/), and a lowercase _assessments/ with a
# nested second level fits neither that scheme nor the TESTS/ sibling it sits
# beside. The old path is still honoured so a course that has not moved yet
# keeps working -- math3503 is the one that has not. Drop the fallback once it
# has, and this becomes a single line again.
if [ -n "${WEBWORK_SETS_DIR:-}" ]; then
    SETS_DIR=$WEBWORK_SETS_DIR
elif [ -d "$REPO/WEBWORK" ]; then
    SETS_DIR=$REPO/WEBWORK
else
    SETS_DIR=$REPO/_assessments/webwork-assignments
fi

# Fail loudly on a missing reference clone. Without this a moved or renamed
# clone is silently indistinguishable from upstream having deleted every file
# it holds, and the run buries the real cause under a screen of GONE lines --
# which is exactly what happened when the OPL clone was renamed to
# -clone (2026-09-02).
for _c in "$DIFFYQS_CLONE" "$OPL_CLONE" "$OPL_CONTRIB"; do
    if [ ! -d "$_c" ]; then
        echo "webwork-check: reference clone not found: $_c" >&2
        echo "  Set DIFFYQS_CLONE / OPL_ROOT / OPL_CLONE / OPL_CONTRIB, or fix" >&2
        echo "  the defaults at the top" >&2
        echo "  of this script if a clone has moved." >&2
        exit 2
    fi
done

usage() { sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

do_paths=0
do_drift=0
topics=()

for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
        --paths)   do_paths=1 ;;
        --drift)   do_drift=1 ;;
        -*)        echo "webwork-check: unknown option $arg" >&2; exit 2 ;;
        *)         topics+=("$arg") ;;
    esac
done

# No check selected means run both.
if [ "$do_paths" -eq 0 ] && [ "$do_drift" -eq 0 ]; then
    do_paths=1
    do_drift=1
fi

# Default to every topic directory that has a webwork/ tree or set directories.
if [ ${#topics[@]} -eq 0 ]; then
    for d in "$REPO"/*/; do
        d=${d%/}
        [ -d "$d/webwork" ] || [ -d "$d/webwork-sets" ] || continue
        topics+=("$(basename "$d")")
    done
fi

failed=0

# ---------------------------------------------------------------------------
# --paths
#
# A source_file line can point at one of several places, and the script has to
# understand all of them because the sets are mid-migration: they currently
# reference the upstream trees on the server, and will later reference this
# repo's own trees. Both forms must verify.
#
#   diffyqs-webwork/sec_2.1/prob01.pg   → the diffyqs clone   (pre-flip)
#   Library/Rochester/.../ur_de_1_1.pg  → the OPL clone       (pre-flip)
#   Contrib/CCCS/CollegeAlgebra/3.1/x.pg → the OPL's Contrib/ (pre-flip)
#   <topic>/diffyqs/sec_2.1/prob01.pg   → this repo           (post-flip)
#   <topic>/opl/Rochester/.../x.pg      → this repo           (post-flip)
#   <topic>/contrib/CCCS/.../x.pg       → this repo           (post-flip)
#   <topic>/local/whatever.pg           → this repo           (post-flip)
#
# The four post-flip forms all resolve the same way, by stripping the topic
# name. What the second level says is WHERE THE PROBLEM CAME FROM, and the
# names match the upstream trees one for one: opl/ is OpenProblemLibrary/,
# contrib/ is its SIBLING Contrib/, diffyqs/ is Lebl's repo, local/ is ours.
# Contrib used to sit under opl/, which read as "the Contrib part of the OPL"
# -- a tree that does not exist. Moved to a sibling 2026-09-11.
# ---------------------------------------------------------------------------

# Running totals across both kinds of reference, for the verdict at the end.
refs=0
bad=0

# One .def file, reported under LABEL.
check_def() {
    local def=$1 label=$2 rel src dn=0 dbad=0

    while IFS= read -r rel; do
        dn=$((dn + 1))
        case "$rel" in
            diffyqs-webwork/*) src="$DIFFYQS_CLONE/${rel#diffyqs-webwork/}" ;;
            Library/*)         src="$OPL_CLONE/${rel#Library/}" ;;
            Contrib/*)         src="$OPL_CONTRIB/${rel#Contrib/}" ;;
            */diffyqs/*|*/opl/*|*/contrib/*|*/local/*)
                # Topic-rooted: strip the leading topic name, which is the
                # server-side directory, and look inside this repo.
                src="$REPO/${rel%%/*}/webwork/${rel#*/}" ;;
            *)
                echo "  ? UNKNOWN SOURCE  $label: $rel"
                dbad=$((dbad + 1)); continue ;;
        esac
        if [ ! -f "$src" ]; then
            echo "  ✗ MISSING  $label: $rel"
            dbad=$((dbad + 1))
        fi
    done < <(grep -h '^source_file' "$def" | sed 's|.*= *||')

    refs=$((refs + dn))
    bad=$((bad + dbad))
    if [ "$dbad" -eq 0 ]; then
        printf '  %-44s %3d references, all resolve\n' "$label" "$dn"
    else
        printf '  %-44s %3d references, %d BROKEN\n' "$label" "$dn" "$dbad"
    fi
}

# ---------------------------------------------------------------------------
# Group directories
#
# A section's practice set is curated as a run of group directories under
# <topic>/webwork-sets/, named <section>_<Title>-<nn>-<Group>, each holding
# symlinks named NN-originalname.pg. The directory is the record of which
# problems are in the set and in what order; the .def is generated from it.
#
# Two kinds, told apart by name:
#
#   ...-<nn>-<Group>                    SETTLED. Committed. Every link must be
#                                       RELATIVE (../../webwork/...), so it
#                                       works on every machine, and must land in
#                                       this topic's own webwork/. A link into an
#                                       upstream clone means the problem was
#                                       never forked, and a link into another
#                                       topic crosses a repo boundary.
#   ...-<nn>-<Group>--CANDIDATES-CLAUDE A DRAFT for review. Gitignored. Links
#                                       point into the upstream clones, because
#                                       nothing has been forked yet, so only
#                                       "does it resolve" applies.
#
# Other files in a group directory -- a README.md of notes -- are ignored. A
# real .pg file in a settled one is not: the problem would then exist twice,
# and the copy outside webwork/ escapes the drift check.
# ---------------------------------------------------------------------------

# One group directory in TOPIC.
check_group() {
    local dir=$1 topic=$2 name link shown target landed own inside n=0 gbad=0 settled=1

    name=$(basename "$dir")
    case "$name" in *--CANDIDATES-CLAUDE) settled=0 ;; esac

    # Compare PHYSICAL paths (pwd -P), so a topic reached through a symlink
    # still counts as itself. Empty if the topic has no webwork/ at all, and
    # then no settled link can land in it.
    own=$(cd "$REPO/$topic/webwork" 2> /dev/null && pwd -P)

    for link in "$dir"/*; do
        shown="$topic/webwork-sets/$name/$(basename "$link")"
        if [ -L "$link" ]; then
            n=$((n + 1))
            target=$(readlink "$link")

            # -f follows the link, so this is "does it reach a real file".
            if [ ! -f "$link" ]; then
                echo "  ✗ BROKEN     $shown -> $target"
                gbad=$((gbad + 1))
                continue
            fi
            [ "$settled" -eq 1 ] || continue

            # Unforked before absolute: a link into an upstream clone is
            # usually absolute too, and "never forked" is the finding that
            # matters. The directory it lands in is resolved from the link's
            # own directory, which is what a relative target is relative to.
            landed=$(cd "$dir" && cd "$(dirname "$target")" && pwd -P)
            # Test $own for empty first: as a pattern, an empty one is `/*',
            # which matches every absolute path.
            inside=0
            if [ -n "$own" ]; then
                case "$landed/" in "$own"/*) inside=1 ;; esac
            fi
            if [ "$inside" -eq 0 ]; then
                echo "  ✗ NOT FORKED $shown -> $target"
                gbad=$((gbad + 1))
            elif [ "${target#/}" != "$target" ]; then
                echo "  ✗ ABSOLUTE   $shown -> $target"
                gbad=$((gbad + 1))
            fi
        elif [ "$settled" -eq 1 ] && [ -f "$link" ] && [ "${link%.pg}" != "$link" ]; then
            echo "  ✗ NOT A LINK $shown"
            gbad=$((gbad + 1))
        fi
    done

    refs=$((refs + n))
    bad=$((bad + gbad))
    [ "$settled" -eq 1 ] || name="$name (draft)"
    if [ "$n" -eq 0 ] && [ "$gbad" -eq 0 ]; then
        printf '    %-60s no links\n' "$name"
    elif [ "$gbad" -eq 0 ]; then
        printf '    %-60s %3d links, all resolve\n' "$name" "$n"
    else
        printf '    %-60s %3d links, %d FINDINGS\n' "$name" "$n" "$gbad"
    fi
}

check_paths() {
    local def topic sets dir found_groups=0

    echo "Set definition references"
    for def in "$SETS_DIR"/*.def; do
        [ -e "$def" ] || continue
        check_def "$def" "$(basename "$def" .def)"
    done
    for topic in ${topics[@]+"${topics[@]}"}; do
        sets="$REPO/$topic/webwork-sets"
        [ -d "$sets" ] || continue
        # A review .def may sit in a draft directory. The generated ones in
        # _for-upload/ are build output, and are not the record of anything.
        while IFS= read -r def; do
            check_def "$def" "$topic/webwork-sets/${def#"$sets/"}"
        done < <(find "$sets" -path "$sets/_for-upload" -prune -o -name '*.def' -print | sort)
    done
    echo

    echo "Set group directories"
    for topic in ${topics[@]+"${topics[@]}"}; do
        sets="$REPO/$topic/webwork-sets"
        [ -d "$sets" ] || continue
        echo "  $topic/webwork-sets/"
        for dir in "$sets"/*/; do
            dir=${dir%/}
            [ -d "$dir" ] || continue
            [ "$(basename "$dir")" = _for-upload ] && continue
            found_groups=1
            check_group "$dir" "$topic"
        done
    done
    [ "$found_groups" -eq 1 ] || echo "  none"

    # Finding nothing is a FAILURE, not a quiet "no .def files". This check
    # used to be per-topic and globbed <topic>/webwork/*.def; when the sets
    # moved to the course-level directory it went on reporting "no .def files"
    # per topic and still exited 0, so --paths silently checked nothing and
    # webwork-deploy went on trusting it. A check that cannot find its input
    # must say so loudly -- that is the whole point of having it.
    #
    # Since the sets moved into the topics, the input is either kind of
    # reference, so the condition is "neither kind": empty group directories
    # and a .def with no source_file lines count as nothing too.
    if [ "$refs" -eq 0 ]; then
        echo "  ✗ NO PROBLEM REFERENCES FOUND"
        echo "    --paths checked nothing. It looked for .def files in"
        echo "      $SETS_DIR"
        echo "    and for .def files and group directories in"
        echo "      <topic>/webwork-sets/ for: ${topics[*]:-(no topics found)}"
        echo "    If the sets have moved, point WEBWORK_SETS_DIR at them."
        failed=1
        return
    fi
    [ "$bad" -gt 0 ] && failed=1
    return 0
}

# ---------------------------------------------------------------------------
# --drift
#
# Compares this repo's copies against the reference clones.
#
# A file may legitimately differ from upstream — adding a solution does not
# make a problem ours, so an edited problem STAYS under diffyqs/ or opl/ next
# to its unedited siblings. Such a file records the blob hash it was copied
# from, in a header line:
#
#     # UPSTREAM-BLOB: 02b6a97499f4a05af144116dacfc0835c9bcc0ec
#
# That is what makes the two questions drift-checking bundles together
# separable, and it is why the hash is recorded rather than just the commit:
#
#   "have I edited this?"        — my copy vs. the recorded hash
#   "has upstream moved?"        — the CLONE's copy vs. the recorded hash
#
# The second question is the one that matters, and it is answerable for edited
# and unedited files alike. Filing edited problems away in local/ instead would
# have answered it for neither, precisely on the files where an upstream fix is
# most expensive to absorb by hand.
#
# Outcomes:
#
#   DIFFERS  a file with no recorded blob differs from upstream. Unexpected:
#            either take upstream's version, or record a blob hash and say in
#            the header what you changed and why.
#   MOVED    upstream has changed a file we have deliberately modified. Not a
#            failure — news. Read the diff and decide whether to port it.
#   GONE     upstream deleted or renamed it. Your copy still works, but the
#            problem no longer exists upstream — worth knowing before relying
#            on upstream for a fix.
#   AHEAD    upstream has problems in these sections that you do not have,
#            reported as a count only. Usually means new problems were added.
# ---------------------------------------------------------------------------

# Blob hash recorded in a file's header, or empty if it records none.
recorded_blob() {
    sed -n 's/^#[[:space:]]*UPSTREAM-BLOB:[[:space:]]*\([0-9a-f]\{40\}\).*/\1/p' "$1" | head -1
}

check_drift() {
    local topic=$1 kind clone dir f rel up blob upstream n=0 differs=0 gone=0 ahead=0 moved=0 kept=0

    for kind in diffyqs opl contrib; do
        dir="$REPO/$topic/webwork/$kind"
        [ -d "$dir" ] || continue
        case "$kind" in
            diffyqs) clone=$DIFFYQS_CLONE ;;
            opl)     clone=$OPL_CLONE ;;
            contrib) clone=$OPL_CONTRIB ;;
        esac

        while IFS= read -r f; do
            rel=${f#"$dir/"}
            n=$((n + 1))

            # Each kind names its own clone root, chosen above, so the path
            # within it is just the relative path. This used to need a special
            # case, because Contrib/ lived under opl/ while being a SIBLING of
            # OpenProblemLibrary/ upstream; the sibling layout removes it.
            up="$clone/$rel"

            if [ ! -f "$up" ]; then
                echo "  - GONE     $kind/$rel"
                gone=$((gone + 1))
                continue
            fi

            blob=$(recorded_blob "$f")
            if [ -n "$blob" ]; then
                # Deliberately modified. Ask only whether upstream has moved
                # since we copied it; our own divergence is the point.
                kept=$((kept + 1))
                upstream=$(git hash-object "$up")
                if [ "$upstream" != "$blob" ]; then
                    echo "  ! MOVED    $kind/$rel  (upstream changed since we forked it)"
                    echo "             diff $f $up"
                    moved=$((moved + 1))
                fi
            elif ! cmp -s "$f" "$up"; then
                echo "  ~ DIFFERS  $kind/$rel  (no UPSTREAM-BLOB recorded)"
                differs=$((differs + 1))
            fi
        done < <(find "$dir" -name '*.pg' | sort)

        # Only meaningful for diffyqs, where whole sections were taken, so a
        # missing file really is something upstream added. The OPL is copied
        # on selection, so "not present" there is the normal case.
        #
        # local/ is NOT counted here: it now holds only problems that are ours
        # outright, not adopted copies, so it can never fill an upstream gap.
        if [ "$kind" = diffyqs ]; then
            local sec secname here there
            for sec in "$dir"/sec_*; do
                [ -d "$sec" ] || continue
                secname=$(basename "$sec")
                here=$(find "$sec" -name '*.pg' | wc -l)
                there=$(find "$clone/$secname" -name '*.pg' 2>/dev/null | wc -l)
                [ "$there" -gt "$here" ] && ahead=$((ahead + there - here))
            done
        fi
    done

    if [ "$n" -eq 0 ]; then
        printf '  %-22s no problem tree\n' "$topic"
        return
    fi

    if [ "$differs" -eq 0 ] && [ "$gone" -eq 0 ]; then
        printf '  %-22s %3d files, %d match upstream' "$topic" "$n" "$((n - kept))"
    else
        printf '  %-22s %3d files, %d differ, %d gone' "$topic" "$n" "$differs" "$gone"
        failed=1
    fi
    [ "$kept"  -gt 0 ] && printf ', %d modified here' "$kept"
    [ "$moved" -gt 0 ] && printf '  (%d TO REVIEW)' "$moved"
    [ "$ahead" -gt 0 ] && printf '  (upstream has %d more)' "$ahead"
    printf '\n'
}

if [ "$do_paths" -eq 1 ]; then
    check_paths
    echo
fi

if [ "$do_drift" -eq 1 ]; then
    echo "Drift against upstream clones"
    for t in "${topics[@]}"; do check_drift "$t"; done
    echo
fi

if [ "$failed" -eq 0 ]; then
    echo "OK"
else
    echo "FAILED — see above"
fi
exit "$failed"
