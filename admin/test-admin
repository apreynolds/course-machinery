def match_elsewhere(students, sac_marked):
    """Which listed names belong to students writing elsewhere -> {section: {name}}.

    TWO FILES, TWO SPELLINGS OF THE SAME PERSON. The registrar gives one display
    string, "Barrios Martinez, Danna X."; sac-students.xlsx is typed by hand into
    separate last and first columns. So the comparison is folded (case and
    accents dropped, see fold_name) and the first name is allowed to be a PREFIX
    on either side, which is what lets a recorded "Danna" find a listed
    "Danna X." without also letting "Dan" find her.

    SCOPED TO THE SECTION, always. The section is recorded beside the name, two
    students in a course of 634 may well share one, and a cross-section match
    would silently mark the wrong person's row.

    THE WARNINGS ARE THE POINT of doing this at all. A row that matches nobody
    means a typo, a withdrawal, or a section change -- and in the last case the
    order takes a booklet off the wrong section's stack. A row
    that matches two people cannot be resolved from what is written down, so it
    marks neither and says so.
    """
    marked = {}
    for section, wanted in sac_marked.items():
        listed = students.get(section, [])
        for last, first in wanted:
            fold_last, fold_first = fold_name(last), fold_name(first)
            hits = []
            for display_name, _student_id in listed:
                their_last, _, their_first = display_name.partition(",")
                if fold_name(their_last) != fold_last:
                    continue
                theirs = fold_name(their_first)
                if (
                    theirs == fold_first
                    or theirs.startswith(fold_first + " ")
                    or fold_first.startswith(theirs + " ")
                ):
                    hits.append(display_name)

            if not hits:
                if not listed:
                    # The class list for this section is missing entirely, which
                    # is already reported once. Saying it again per student would
                    # bury the freshness table under a name for every SAC row.
                    continue
                warn(
                    f"{SAC_STUDENTS_XLSX.name}: {last}, {first} is recorded in "
                    f"{section} but no one of that name is on {section}'s class "
                    f"list -- withdrawn, a typo, or in a different section now. "
                    f"The order still takes a booklet off {section} for them."
                )
            elif len(hits) > 1:
                warn(
                    f"{SAC_STUDENTS_XLSX.name}: {last}, {first} matches "
                    f"{len(hits)} students in {section}; none marked on the "
                    f"sheet. Add a middle initial to tell them apart."
                )
            else:
                marked.setdefault(section, set()).add(hits[0])
    return marked


def check_one_page_per_sheet(pdf_path, expected_pages):
    """Verify the finished PDF really is one page per section.

    This is the only thing that catches the sheet's worst failure, and LaTeX will
    not do it. A tabular is an unbreakable box: a table too tall for its page is
    not reported as an Overfull \\vbox, it is silently moved to the next page,
    stranding its heading and making the document one page longer. No warning is
    issued anywhere. The usual trigger is a long name wrapping in the name
    column, since a wrapped row is taller -- see TUNING in attendance.sty.

    Counting pages tests the invariant itself rather than any one cause, so it
    also catches whatever the next edit breaks.

    RETURNS TRUE ONLY WHEN IT POSITIVELY VERIFIED the count, because the caller
    deletes the generated .tex on the strength of it. Every other outcome --
    wrong count, unreadable output, no pdfinfo at all -- returns False and keeps
    the source. Unverified is not success: a missing tool must not be able to
    masquerade as a clean build and take the evidence with it.
    """
    pages = pdf_page_count(pdf_path)
    if pages is None:
        # Losing the check is worth saying out loud, because its silence is
        # otherwise indistinguishable from a pass.
        warn(
            "could not count the attendance sheet's pages with pdfinfo, so the "
            "one-page-per-section check was SKIPPED -- count them by hand "
            "before printing"
        )
        return False
    if pages != expected_pages:
        warn(
            f"the PDF has {pages} pages but there are {expected_pages} sections. "
            f"A section's table did not fit its page and moved to the next one, "
            f"stranding its heading -- most likely a long name wrapping in a "
            f"nearly full section. Widen \\attnamewidth or shave \\attrowheight "
            f"in attendance.sty, and DO NOT print until the count matches."
        )
        return False
    return True


def compile_sheet(tex_path):
    """Build the PDF beside the .tex with pr-latexmk -> True if it worked.

    pr-latexmk rather than a bare latexmk call because the aux-dir path is a
    contract shared with vimtex and build-pdfs (LATEXMK-AUX-CONTRACT in its
    header); calling it keeps this script from becoming one more place that
    derives that path. Everything but the PDF goes to ~/.cache/latexmk/.

    ITS OUTPUT IS HELD BACK, and shown only if the build fails. pdflatex writes
    several hundred lines for this document, none of them of interest when it
    works, and they would push the questions already answered off the screen.
    """
    try:
        result = subprocess.run(
            ["pr-latexmk", tex_path.name],
            cwd=tex_path.parent,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,   # one stream, in the order it was written
            text=True,
        )
    except FileNotFoundError:
        die(
            f"pr-latexmk is not on PATH, so {tex_path.name} cannot be compiled. "
            f"It lives in ~/.local/bin."
        )
    if result.returncode != 0:
        print(result.stdout)
    return result.returncode == 0


def render_tex(test_number, sections, students, entries_by_section, elsewhere):
    """Build the whole document: a preamble and one sheet per section.

    THE BOOKLET COUNT IS THE ENVELOPE'S, not the number of names on the page.
    `entries_by_section' is the very rows the envelope sheets are written from,
    so the heading states the figure that is in the TA's envelope by
    construction rather than by a second copy of the arithmetic. The "writing
    elsewhere" figure is likewise the recorded tally rather than the number of
    names actually greyed out below: when a name fails to match, the envelope is
    still short by it, and match_elsewhere has already said so.
    """
    lines = [
        f"% GENERATED by test-admin on {date.today().isoformat()}.",
        "% Do not edit -- rerun the script instead. Git-ignored because it holds",
        "% student names; the layout lives in the tracked attendance.sty.",
        "\\documentclass[11pt,lining]{CourseDocument}",
        "",
        "% attendance.sty owns the page and pulls in courseinfo itself, so there is",
        "% nothing to set here -- see THE PAGE and TUNING in that file.",
        "\\usepackage{attendance}",
        "",
        "\\begin{document}",
        "% empty, not plain: no page number. Titling.sty installs no pagestyle and",
        "% CourseDocument activates neither of its two fancy ones, so this is bare.",
        "\\pagestyle{empty}",
        "",
    ]

    for section, info in sections.items():
        entries = students.get(section, [])
        ta_name = latex_escape(info["ta"]) or "---"
        envelope = entries_by_section[section]
        booklets = envelope["copies"]
        away = envelope["at_sac"]
        marked = elsewhere.get(section, set())
        lines.append(
            f"\\begin{{attendancesheet}}{{{test_number}}}{{{section}}}"
            f"{{{ta_name}}}{{{len(entries)}}}{{{booklets}}}{{{away}}}"
        )
        if entries:
            for display_name, _student_id in entries:
                macro = "StudentElsewhere" if display_name in marked else "Student"
                lines.append(f"  \\{macro}{{{latex_escape(display_name)}}}")
        else:
            lines.append("  \\NoRosterData")
        lines.append("\\end{attendancesheet}")
        lines.append("")

    lines.append("\\end{document}")
    return "\n".join(lines) + "\n"


