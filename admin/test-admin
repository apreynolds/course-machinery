#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% ASKING
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# Every question has a default, shown in capitals or in brackets, and Enter takes
# it. --yes takes all of them without asking, which is also what makes the script
# runnable where there is no keyboard to answer on.
#
# THE REPORT IS FLUSHED BEFORE EVERY QUESTION. say() and warn() hold their lines
# back so that they are not lost above a wall of build output; a question is the
# moment they have to be on screen, because they are what is being asked about.
ASSUME_YES = False


def read_answer(prompt):
    """One line typed at the keyboard, stripped; "" under --yes."""
    flush_report(tally=False)
    if ASSUME_YES:
        return ""
    try:
        return input(prompt).strip()
    except EOFError:
        # No keyboard: run from a script, or with input redirected. Guessing an
        # answer here would be answering for someone who was never asked.
        print()
        die("there is no terminal to answer on. Rerun with --yes to accept "
            "every default.")
    except KeyboardInterrupt:
        print()
        die("stopped. Nothing further was written.")


def confirm(question, default=True):
    """A yes/no question -> True or False. Enter gives the default."""
    hint = "[Y/n]" if default else "[y/N]"
    while True:
        answer = read_answer(f"{question} {hint} ").casefold()
        if answer == "":
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False
        print("  Please answer y or n.")


def proceed_or_stop(question):
    """Ask whether to carry on; a no ends the run here, cleanly."""
    if not confirm(question):
        print("Stopped. Nothing further was written.")
        raise SystemExit(0)


def ask_number(question, default, note=""):
    """A whole number, zero or more. Enter gives the default.

    `note' says where the default came from -- "4 yes + 3 unknown + 5 cushion"
    -- so that accepting it is a decision and not a shrug.
    """
    shown = f"{default} = {note}" if note else str(default)
    while True:
        answer = read_answer(f"{question} [{shown}]: ")
        if answer == "":
            return default
        if answer.isdigit():
            return int(answer)
        print("  Please type a whole number, or press Enter for the default.")


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% THE TEST FILES
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# A test is two documents, one per lecture day: test-2a-tue and test-2b-thu. Each
# is a .tex in the repo's TESTS/ and, once built, a PDF and a -SOLUTIONS PDF in
# the mirror -- the directory tree .MIRRORDIR names, which is where build-pdfs
# sends everything it builds.
#
# THE PDF IS LOOKED AT FOR ONE NUMBER: how many pages a booklet has. That used
# to be typed on the command line every time, on the grounds that it could not
# be derived; it can, because the booklet Crowdmark produces has exactly the
# pages of the PDF it was given. Measuring it also means it cannot be stale.

def pdf_page_count(pdf_path):
    """How many pages a PDF has, by asking pdfinfo -> an int, or None.

    None covers every way of not knowing: no pdfinfo on this machine (it is
    poppler's, not a given), a file it cannot read, output with no Pages line.
    The callers decide what not knowing costs.
    """
    try:
        result = subprocess.run(
            ["pdfinfo", str(pdf_path)], capture_output=True, text=True, check=True
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None
    for line in result.stdout.splitlines():
        if line.startswith("Pages:"):
            text = line.split(":", 1)[1].strip()
            return int(text) if text.isdigit() else None
    return None


def modified(path):
    """When a file was last written, as a datetime."""
    return datetime.fromtimestamp(path.stat().st_mtime)


def find_test_files(test_number, pages_override):
    """Look at each day's test PDF -> {day key: pages in one booklet}.

    Says what it found, one row per day, and warns about what is not ready:

      no PDF            the test has not been built; nothing to measure
      PDF older than    the .tex was edited after the build, so the PDF -- and
      its .tex          the one already uploaded anywhere -- is not the test
      no -SOLUTIONS     wanted eventually, but the order does not wait on it

    A MISSING PDF IS FATAL unless --pages was given, because the page count is
    multiplied into the order and there is no honest guess at it. With --pages
    everything here is advice and the number typed is used for both days.
    """
    mirror = find_mirror_dir()
    tests_dir = mirror / "TESTS" if mirror else None
    say(paint(f"test {test_number}'s files in "
              f"{tests_dir if tests_dir else '(no mirror found)'}", "bold"))
    if mirror is None:
        warn(
            f"no usable .MIRRORDIR at {REPO_ROOT}, so the built test PDFs "
            f"cannot be found. It names the directory build-pdfs sends PDFs to."
        )

    pages = {}
    for key, day in DAYS.items():
        # test-2?-tue.pdf: the letter is the version (a, b) and is whatever the
        # test was called, so it is matched and not assumed. The pattern ends at
        # the day, so -SOLUTIONS and -COVERPAGE files do not match it.
        pattern = f"test-{test_number}?-{day['file']}.pdf"
        found = sorted(tests_dir.glob(pattern)) if tests_dir else []

        if not found:
            say(f"  {day['calendar']}  " + paint(f"no {pattern}", "red"))
            if pages_override is None:
                die(
                    f"no {pattern} in {tests_dir}. Build the test first "
                    f"(build-pdfs), or pass --pages P to say how many pages a "
                    f"booklet has and carry on without it."
                )
            count_warning()
            pages[key] = pages_override
            continue

        if len(found) > 1:
            warn(
                f"{len(found)} files match {pattern} "
                f"({', '.join(p.name for p in found)}); using {found[0].name}."
            )
        pdf = found[0]
        built = modified(pdf)
        measured = pdf_page_count(pdf)
        notes = []

        # The .tex has the PDF's name. Edited after the build means the PDF is
        # not the current test -- the commonest way to print the wrong thing.
        tex = (REPO_ROOT / "TESTS" / pdf.with_suffix(".tex").name) if REPO_ROOT else None
        if tex is None or not tex.exists():
            notes.append(paint("no .tex in the repo's TESTS/", "yellow"))
            count_warning()
        elif modified(tex) > built:
            notes.append(paint(
                f".tex EDITED SINCE ({modified(tex).strftime('%-d %b %H:%M')}) "
                f"-- rebuild", "red"))
            count_warning()

        solutions = pdf.with_name(pdf.stem + "-SOLUTIONS.pdf")
        if not solutions.exists():
            notes.append(paint("no -SOLUTIONS yet", "yellow"))
            count_warning()
        elif tex is not None and tex.exists() and modified(tex) > modified(solutions):
            notes.append(paint("-SOLUTIONS older than the .tex", "yellow"))
            count_warning()
        else:
            notes.append(paint("with -SOLUTIONS", "green"))

        if pages_override is not None:
            pages[key] = pages_override
            if measured is not None and measured != pages_override:
                warn(
                    f"--pages {pages_override} was given, but {pdf.name} has "
                    f"{measured} pages. Using {pages_override}, as told."
                )
        elif measured is None:
            die(
                f"could not count the pages of {pdf.name} (is pdfinfo "
                f"installed? it comes with poppler). Pass --pages P to say how "
                f"many pages a booklet has."
            )
        else:
            pages[key] = measured

        say(
            f"  {day['calendar']}  {pdf.name:<20} {pages[key]:>2} pages  "
            f"built {built.strftime('%-d %b %H:%M')}  " + ", ".join(notes)
        )

        # The job is ordered double-sided, so an odd count leaves a blank side
        # and makes "N leaves" in the description a rounded number.
        if pages[key] % 2:
            warn(
                f"{pdf.name} has {pages[key]} pages, which is odd, but the job "
                f"is ordered double-sided: the last leaf prints on one side "
                f"only. Check the booklet."
            )

    return pages


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% THE CLASS LISTS
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

# What the class lists are called, e.g.
#   section-rosters_MATH_1003_FR01A_2026-08-23_9_06 PM.csv
ROSTER_GLOB = f"section-rosters_MATH_{COURSE_NUMBER}_*.csv"

# The nominal section AND the export time, both taken from that filename.
#
# See WHY THIS SCRIPT EXISTS above for why the section here is load-bearing. The
# timestamp is what lets the shared folder simply accumulate: the newest export
# per instructor wins and nobody has to delete anything.
#
# THE SECTION CODE IS CAPTURED GENERICALLY, not matched against a pattern. It
# used to be FR\d{2}A, which is right for this course and wrong for the next one
# along -- MATH 1013's sections are FR01B, so that pattern would match nothing
# and the run would end at "no class lists in ...", a message pointing nowhere
# near the cause. What vouches for a code now is membership in
# course-sections.csv, tested in select_current_exports; that check is the only
# validation left, so do not weaken it.
#
# Nothing anchors the end, so a second download in one browser session --
# "... 9_06 PM (1).csv" -- still parses.
FILENAME_SECTION_RE = re.compile(
    rf"section-rosters_MATH_{COURSE_NUMBER}_([A-Z0-9]+)_"
    rf"(\d{{4}}-\d{{2}}-\d{{2}}_\d{{1,2}}_\d{{2}} [AP]M)"
)

# The registrar's timestamp format: 2026-08-23_9_06 PM. %I is the 12-hour clock
# and tolerates the unpadded hour.
EXPORT_TIME_FORMAT = "%Y-%m-%d_%I_%M %p"

# The suffix that overrides it. The asterisks are literal in the export, hence
# the escaping; the trailing $ anchors it so a student whose name somehow
# contained the phrase mid-string would not be silently truncated.
CROSSLIST_RE = re.compile(
    rf"\s+cross-listed as MATH\*{COURSE_NUMBER}\*([A-Z0-9]+)\s*$"
)

# Characters TeX would read as markup if a name contained them. Applied one
# character at a time (see latex_escape), which is what keeps the backslash rule
# from then mangling the backslashes the other rules just introduced.
LATEX_SPECIALS = {
    "\\": r"\textbackslash{}",
    "&": r"\&",
    "%": r"\%",
    "$": r"\$",
    "#": r"\#",
    "_": r"\_",
    "{": r"\{",
    "}": r"\}",
    "~": r"\textasciitilde{}",
    "^": r"\textasciicircum{}",
}


def latex_escape(text):
    """Make a student's name safe to typeset.

    One pass, character by character, so a replacement's own backslash is never
    re-escaped by a later rule. Accented letters pass straight through: the
    course builds with pdflatex under T1 (Typefaces.sty:26), which handles them
    from UTF-8 source. Scripts outside the Latin alphabet do NOT survive that,
    so they are flagged separately in check_typesettable.
    """
    return "".join(LATEX_SPECIALS.get(ch, ch) for ch in text)


def check_typesettable(name, section):
    """Warn about characters pdflatex+T1 cannot set, before the build fails.

    T1 covers the Latin alphabet and its accents. A name in Greek, Cyrillic,
    Chinese or Arabic would stop the compile with an error naming a font, not a
    student, so it is worth saying plainly here whose name it was.
    """
    for ch in name:
        if ord(ch) < 128:
            continue
        try:
            unicode_name = unicodedata.name(ch)
        except ValueError:
            unicode_name = "unnamed character"
        if not unicode_name.startswith("LATIN"):
            warn(
                f"{section}: {name!r} contains {ch!r} ({unicode_name}), which "
                f"pdflatex with T1 fonts cannot typeset -- the build may fail"
            )
            return


def export_time(path, stamp_text):
    """When this class list was exported.

    The filename's timestamp is preferred because it records when the registrar
    produced the data, which is the thing that goes stale. The file's mtime only
    records when the file happened to land in the folder -- a re-sync or a copy
    between machines can move it, and OneDrive is exactly that kind of folder.
    mtime is the fallback for when the registrar changes the filename format.
    """
    try:
        return datetime.strptime(stamp_text, EXPORT_TIME_FORMAT)
    except ValueError:
        warn(
            f"{path.name}: cannot read the export time {stamp_text!r}; falling "
            f"back to the file's modification time, which may be later than the "
            f"actual export"
        )
        return datetime.fromtimestamp(path.stat().st_mtime)


def select_current_exports(roster_dir, sections):
    """Pick the newest class list per INSTRUCTOR from a folder that accumulates.

    Instructors drop a fresh export in every week or two and never delete
    anything, so the folder holds many generations at once. Returns
    {instructor: (path, nominal_section, exported)}.

    GROUPED BY INSTRUCTOR, NOT BY SECTION CODE, and that is the whole subtlety.
    An instructor's export covers all of their sections whichever one it is
    nominally named for, so the same instructor may file FR07A in September and
    FR09A in October. Keyed by section code those look like two independent
    sources and both would be read, silently double-counting every section that
    instructor teaches. Keyed by instructor, October simply supersedes September.
    """
    if not roster_dir.is_dir():
        die(
            f"class-list folder not found:\n  {roster_dir}\n"
            f"If this is the shared OneDrive folder, it may not be mounted or "
            f"synced yet. Pass --roster-dir to build from somewhere else -- but "
            f"note that an old local copy will produce confidently wrong sheets."
        )

    roster_files = sorted(roster_dir.glob(ROSTER_GLOB))
    # The anonymised sample is not a class list.
    roster_files = [p for p in roster_files if not p.stem.endswith("-DEMO")]
    if not roster_files:
        die(f"no {ROSTER_GLOB} files in {roster_dir}")

    current = {}
    for path in roster_files:
        match = FILENAME_SECTION_RE.search(path.name)
        if not match:
            # A WARNING, NOT AN ERROR: this is a shared folder that will collect
            # stray files over a term, and one of them must not stop the build.
            # Safe to be lenient because a class list skipped here is not lost
            # quietly -- that instructor's sections turn up in the freshness
            # report as absent and in the PDF as "No class-list data" pages.
            warn(
                f"{path.name}: not a recognisable class-list filename, skipped. "
                f"If this is a class list that was renamed, restore the "
                f"registrar's original name -- the filename is the only record "
                f"of which section the un-suffixed students belong to."
            )
            continue

        nominal_section, stamp_text = match.group(1), match.group(2)
        if nominal_section not in sections:
            warn(
                f"{path.name}: section {nominal_section} is not in "
                f"course-sections.csv, skipped"
            )
            continue

        instructor = sections[nominal_section]["instructor"] or nominal_section
        exported = export_time(path, stamp_text)
        if instructor not in current or exported > current[instructor][2]:
            current[instructor] = (path, nominal_section, exported)

    if not current:
        die(f"no usable class lists in {roster_dir}")

    return current, len(roster_files)


def report_freshness(current, sections, stale_days, total_files, roster_dir):
    """Say which lists were used, how old they are, and who has not filed one.

    Printed every run rather than only on trouble: the point of asking several
    people to export regularly is that some of them will forget, so this is the
    nudge list. It also makes clear that superseded files were ignored, not lost.
    """
    # Every instructor named in course-sections.csv, in the order the sections
    # appear, so the report reads FR01A-group first and is stable run to run.
    instructors = []
    for info in sections.values():
        if info["instructor"] and info["instructor"] not in instructors:
            instructors.append(info["instructor"])

    say(paint(
        f"using {len(current)} of {total_files} class list(s) in {roster_dir}",
        "bold",
    ))

    # The freshness table is a table, so its rows carry no "!" marker even when
    # they are the problem -- routing the bad ones through warn() would put a
    # marker on some rows of a table and not others. They still count towards the
    # tally, via count_warning(); they say so in the column where the eye is
    # already looking.
    today = datetime.now()

    for instructor in instructors:
        if instructor not in current:
            say(
                f"  {instructor:<14} {'--':<7} "
                + paint("NO CLASS LIST -- ask for an export", "red")
            )
            count_warning()
            continue

        _path, nominal_section, exported = current[instructor]
        age = (today - exported).days
        line = f"  {instructor:<14} {nominal_section:<7} exported {exported.strftime('%-d %b')}"
        if age < 0:
            # Not worth a real code path, but "(-21 days ago)" reads as a bug.
            # A future date means a clock or a filename is wrong, so say that.
            line += paint("  (dated in the future -- check the filename)", "red")
            count_warning()
        elif age > stale_days:
            line += paint(f"  ({age} days ago)  STALE", "yellow")
            count_warning()
        else:
            line += paint(f"  ({age} days ago)", "green")
        say(line)


def collect_students(current, known_sections):
    """Read the selected class lists and sort the students into sections.

    Returns {section: [(display_name, student_id), ...]}. Sections with no
    students are simply absent; the caller still gives them a page.
    """
    students = {}
    # (section, student id) already taken. Selection should already have removed
    # superseded generations, so this is a safety net rather than the mechanism.
    seen = set()

    for path, nominal_section, _exported in current.values():
        rows_read = 0
        rows_duplicate = 0

        # utf-8-sig: the export carries a byte-order mark, which would otherwise
        # ride along on the first column name and break the DictReader lookup.
        with path.open(encoding="utf-8-sig", newline="") as handle:
            for row in csv.DictReader(handle):
                raw_name = (row.get("Student Name") or "").strip()
                if not raw_name:
                    continue  # the export ends with a blank line
                rows_read += 1

                student_id = (row.get("Student ID") or "").strip()

                suffix = CROSSLIST_RE.search(raw_name)
                if suffix:
                    section = suffix.group(1)
                    display_name = raw_name[: suffix.start()].strip()
                else:
                    section = nominal_section
                    display_name = raw_name

                if section not in known_sections:
                    warn(
                        f"{path.name}: student in section {section}, which is "
                        f"not in course-sections.csv -- skipped"
                    )
                    continue

                key = (section, student_id or display_name.casefold())
                if key in seen:
                    rows_duplicate += 1
                    continue
                seen.add(key)

                check_typesettable(display_name, section)
                students.setdefault(section, []).append((display_name, student_id))

        if rows_duplicate:
            # Reported per file rather than per row: the case this catches is a
            # stale download sitting beside a fresh one, where every row is a
            # duplicate and one line is more use than two hundred.
            warn(
                f"{path.name}: {rows_duplicate} of {rows_read} rows were already "
                f"seen in another file"
                + (
                    " -- this looks like a second copy of a list already read; "
                    "consider removing the older download"
                    if rows_duplicate == rows_read
                    else ""
                )
            )

    # Sorted by the name as printed, which is "Last, First", so this is a sort by
    # last name. casefold rather than lower so it behaves on accented capitals.
    for section in students:
        students[section].sort(key=lambda entry: entry[0].casefold())

    # A student in two sections is a registrar problem worth seeing, and it is
    # cheap to look for now that everything is in one place.
    id_owner = {}
    for section, entries in students.items():
        for display_name, student_id in entries:
            if not student_id:
                continue
            if student_id in id_owner:
                other_section, other_name = id_owner[student_id]
                if other_section != section:
                    warn(
                        f"student ID {student_id} appears in both "
                        f"{other_section} ({other_name}) and {section} "
                        f"({display_name})"
                    )
            else:
                id_owner[student_id] = (section, display_name)

    return students


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% ENROLMENT
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# course-sections.csv says how many are registered in each section, and every
# number in the order is computed from it. It is hand-maintained, so it drifts;
# the class lists just read are the correction. The disagreements are shown and
# the file is rewritten only on a yes.

def plan_enrolment_updates(sections, students, current, stale_days):
    """What the class lists say course-sections.csv has wrong. Applies nothing.

    THE EXPORT IS THE AUTHORITY ONLY WHERE THERE IS ONE. A section is considered
    only when its instructor filed a class list; otherwise its count is UNKNOWN,
    which is not the same as zero and must not be written as one. That distinction
    is the whole safety of this function: one absent download covers all of that
    instructor's sections at once, so guessing there would empty six full rooms
    on paper and order them a single spare booklet each.

    A SECTION WHOSE LIST WAS READ AND HOLDS NOBODY GOES TO 0. The export is
    trusted that far, deliberately -- see the plan's note. It still earns a line
    in the table, because a section emptying out is worth seeing rather than
    inferring from a number that quietly became zero.

    Staleness is carried, not acted on: an old export still updates, and says how
    old it was, so a figure taken from a download predating a hand-correction is
    visible in the same glance as everything else being checked.
    """
    updates, agreed, unchecked = [], 0, 0
    today = datetime.now()

    for section, info in sections.items():
        instructor = info["instructor"]
        if instructor not in current:
            unchecked += 1
            continue

        live = len(students.get(section, []))
        if live == info["registered"]:
            agreed += 1
            continue

        _path, _nominal, exported = current[instructor]
        age = (today - exported).days
        updates.append({
            "section": section,
            "old": info["registered"],
            "new": live,
            "instructor": instructor,
            "exported": exported,
            "age": age,
            "stale": age > stale_days,
        })

    return updates, agreed, unchecked


def write_enrolment(updates):
    """Rewrite just the Enrolment cells the class lists corrected.

    LINE-ORIENTED, NOT A CSV ROUND-TRIP. course-sections.csv is hand-maintained
    and tracked, so the diff after a run should be the rows that actually moved
    and nothing else. Rewriting it through csv.writer would be simpler and would
    also requote, reorder or re-line-end the whole file at the first difference of
    opinion about dialect -- turning a two-line correction into a 25-line diff
    that nobody can review. This is only safe because the file has been checked to
    hold no field containing a comma or a quote; if that ever changes, this has to
    become a real CSV rewrite.

    THE CAPACITY HALF IS PRESERVED. The cell is `registered/capacity' and a class
    list knows nothing about capacity, so only the left half is ever touched.

    Written to a temporary file and moved into place, so an interrupted run
    cannot leave a half-written section list -- this is the course's definition of
    itself, and every other script reads it.
    """
    if not updates:
        return

    lines = SECTIONS_CSV.read_text(encoding="utf-8").split("\n")
    wanted = {u["section"]: u for u in updates}

    for index, line in enumerate(lines):
        if not line.strip():
            continue
        fields = line.split(",")
        update = wanted.pop(fields[0].strip(), None)
        if update is None:
            continue
        capacity = fields[1].split("/", 1)[1] if "/" in fields[1] else ""
        fields[1] = f"{update['new']}/{capacity}" if capacity else str(update["new"])
        lines[index] = ",".join(fields)

    if wanted:
        # Never a partial write: the file this script is about to replace is the
        # one that says which sections exist.
        die(
            f"{SECTIONS_CSV.name} has no row for "
            f"{', '.join(sorted(wanted))}, so it was left untouched. The section "
            f"list changed underneath this run."
        )

    scratch = SECTIONS_CSV.with_suffix(".csv.new")
    scratch.write_text("\n".join(lines), encoding="utf-8")
    scratch.replace(SECTIONS_CSV)


def apply_enrolment(sections, updates):
    """Carry the corrections into the section list already in memory.

    So that everything computed after this -- the booklets, the envelopes, the
    figure in each sheet's heading -- uses the corrected numbers without the
    file being read a second time. Separate from write_enrolment because a dry
    run wants exactly this half: the numbers a real run would produce, with
    nothing written.
    """
    for update in updates:
        sections[update["section"]]["registered"] = update["new"]


def report_enrolment(updates, agreed, unchecked):
    """Say what the class lists would change, before anything is changed.

    THE THREE COUNTS ARE KEPT APART. "Already correct" and "unchecked" are
    different claims -- one means a class list agreed, the other means no class
    list existed to ask -- and adding them together would overstate how much of
    the file has actually been verified.
    """
    if not updates:
        say(paint(f"course-sections.csv: {agreed} section(s) already correct"
                  + (f", {unchecked} unchecked (no class list filed)"
                     if unchecked else ""), "green"))
        return

    say(paint(
        f"course-sections.csv disagrees with the class lists in "
        f"{len(updates)} section(s)", "bold"))
    for u in updates:
        old = "?" if u["old"] is None else u["old"]
        # A negative age is a clock or a filename, not a fresh export -- the same
        # case report_freshness flags. "(-1 days)" reads as an arithmetic bug, so
        # say what it actually means.
        when = (
            paint("(dated in the future)", "red") if u["age"] < 0
            else f"({u['age']} days)"
        )
        line = (
            f"    {u['section']:<7} {old:>3} -> {u['new']:<3}  "
            f"{u['instructor']}, exported {u['exported'].strftime('%-d %b')} "
            f"{when}"
        )
        if u["stale"]:
            line += paint("  STALE", "yellow")
        say(line)
    say(
        f"    {agreed} section(s) already correct"
        + (f"; {unchecked} unchecked (no class list filed)." if unchecked else ".")
    )


