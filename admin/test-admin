#% THE CALENDAR
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

CALENDAR_CSV = (DATA_DIR or SCRIPT_DIR) / "calendar-dates.csv"

# Spelt out for the form's Date Required: "Monday 28 September" rather than
# "Mon 28 Sep". calendar-dates.csv abbreviates because it is building a table
# where the column is narrow; an answer on a form is not.
MONTHS = {
    "Jan": "January", "Feb": "February", "Mar": "March", "Apr": "April",
    "May": "May", "Jun": "June", "Jul": "July", "Aug": "August",
    "Sep": "September", "Oct": "October", "Nov": "November", "Dec": "December",
}

# How a test announces itself in the `tutorial' column of calendar-dates.csv.
# The trailing number is captured rather than matched so that it can be compared
# as a number: searching for test 1 must not find "TEST 10". IGNORECASE because
# that column is prose for the printed schedule, not a machine field.
TEST_IN_TUTORIAL_RE = re.compile(r"\btest\s*0*(\d+)\b", re.IGNORECASE)


def read_calendar():
    """calendar-dates.csv -> a list of rows, or [] if it is not there.

    NOT FATAL WHEN ABSENT. Every number in the order comes from
    course-sections.csv; the calendar contributes only the two test dates and the
    Monday the order is wanted by, which are nice to have printed and are not worth refusing
    to produce an order over. An unmarked test is reported by find_test_days.
    """
    if not CALENDAR_CSV.exists():
        return []
    with CALENDAR_CSV.open(encoding="utf-8-sig", newline="") as handle:
        return list(csv.DictReader(handle))


def find_test_days(calendar, test_number):
    """Which dates test N is written on -> {day key: "Tue 22 Sep"}, and its week.

    READS THE `tutorial' COLUMN, which already says what happens in that slot --
    "Help session" most weeks, "TEST 1" when there is a test. That column is not
    a marker invented for this script: coursetables.sty prints it in the schedule
    table, so marking a test there is one edit that both moves the deadline here
    and tells students in the printed schedule. A `test' column of its own would
    have been a second place to record the same fact, and two places drift.

    MATCHED CASE-INSENSITIVELY, and loosely. That cell is prose bound for a
    printed table, so its capitalisation belongs to whoever is writing the
    schedule -- "TEST 1" reads best there and the script has no business
    insisting on it. The number is parsed out and compared as a number rather
    than matched as text, so looking for test 1 never matches "TEST 10", and
    trailing detail ("TEST 1 -- Ch. 1-3") does not stop it being found.

    ONLY THE TUESDAY ROW IS MARKED, because that is how the tutorial column
    already works: the pair of rows share one slot id (tut02 on both Tue 22 Sep
    and Thu 24 Sep) and the schedule table emits the cell once for the week. So
    the marked row gives the slot, and THE SLOT GIVES BOTH DATES -- see the
    pairing below.

    A test that has not been marked yet is a warning and not an error; see MONDAY
    in the deadline code for what is lost. Returns ({}, None) in that case.
    """
    if not calendar:
        return {}, None

    marked = []
    for row in calendar:
        found = TEST_IN_TUTORIAL_RE.search((row.get("tutorial") or ""))
        if found and int(found.group(1)) == int(test_number):
            marked.append(row)

    if not marked:
        warn(
            f"test {test_number} is not marked in {CALENDAR_CSV.name}, so its "
            f"dates and the date the order is required are left generic. Put "
            f"`TEST {test_number}' in the `tutorial' column of the row it is "
            f"written on -- the same column that says `Help session' in the "
            f"weeks without a test."
        )
        return {}, None

    if len(marked) > 1:
        warn(
            f"{CALENDAR_CSV.name} marks test {test_number} on "
            f"{len(marked)} rows "
            f"({', '.join((r.get('date') or '?').strip() for r in marked)}); "
            f"using the first."
        )
    row = marked[0]
    slot = (row.get("id") or "").strip()
    week = (row.get("week") or "").strip()

    # THE PAIRING. A tutorial slot is two rows sharing an id -- tut02 is both
    # Tue 22 Sep and Thu 24 Sep -- so the id is what says "the same tutorial,
    # the other day", which is exactly the question being asked. Falling back to
    # the week when there is no usable id (week 1's placeholder id is `---')
    # keeps a marked test from losing its dates over a detail of the calendar.
    if slot and slot != "---":
        partners = [r for r in calendar if (r.get("id") or "").strip() == slot]
    else:
        partners = [
            r for r in calendar
            if (r.get("week") or "").strip() == week
            and (r.get("type") or "").strip() == "tutorial"
        ]

    dates = {}
    for partner in partners:
        stamp = (partner.get("date") or "").strip()
        for key, day in DAYS.items():
            if stamp.startswith(day["calendar"] + " "):
                dates.setdefault(key, stamp)
                break

    for key, day in DAYS.items():
        if key not in dates:
            warn(
                f"{CALENDAR_CSV.name} has no {day['calendar']} row for test "
                f"{test_number}'s tutorial slot, though the course tutors that "
                f"day. That day's order is dated generically."
            )

    return dates, week or None


def find_monday(calendar, week):
    """The Monday of a week, spelt out -> "Monday 28 September", or None.

    MONDAY. The order is wanted by the Monday before the test, and that needs no date
    arithmetic and no year: that Monday is ALREADY A ROW of calendar-dates.csv,
    so it is looked up rather than computed. Nothing here has to know that 2026
    is not a leap year or that the term starts in September.

    Two weeks in a term break the lookup, and both are warned about rather than
    papered over: a week whose Monday is a holiday (the pickup would fall on a
    closed campus), and a week with no Monday row at all (the fall break is one
    merged `9--13 Nov' row).
    """
    if not calendar or week is None:
        return None

    for row in calendar:
        if (row.get("week") or "").strip() != week:
            continue
        stamp = (row.get("date") or "").strip()
        if not stamp.startswith("Mon "):
            continue
        if (row.get("type") or "").strip() == "no class":
            note = (row.get("note") or "").strip() or "no class"
            warn(
                f"the Monday before this test is {stamp} -- {note}. Date "
                f"Required says so anyway; choose another day on the form "
                f"if Print Services is closed."
            )
        parts = stamp.split()
        if len(parts) == 3 and parts[2] in MONTHS:
            return f"Monday {parts[1]} {MONTHS[parts[2]]}"
        return stamp

    warn(
        f"week {week} of {CALENDAR_CSV.name} has no Monday row, so Date "
        f"Required is left generic. (The fall break is one merged row, which is "
        f"the usual cause.)"
    )
    return None


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% THE ARITHMETIC
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

# The label a SAC row carries in the tables. Not a section, so it has no TA, no
# room of ours and no enrolment -- see build_day for why it is a row at all.
SAC_LABEL = "SAC"

# A print-job.csv value mentioning any of these is ABOUT the SAC block, and is
# left out of the order entirely when a day has no such block. The alternative
# is a form field reading "set aside the last 0 booklets (booklets 0 to 0 of
# 393)", which is worse than saying nothing: it is an instruction, it is
# addressed to someone who will act on it, and it is nonsense.
SAC_PLACEHOLDERS = ("{sac}", "{sac_first}", "{sac_last}")


def split_by_day(sections):
    """course-sections.csv's order, partitioned on the Day column.

    STRICT ON PURPOSE. A Day this does not recognise is fatal, because the
    alternative is the failure this whole script exists to avoid: a section
    silently absent from its day's count, an order short by thirty booklets, and
    nothing anywhere saying so until a TA is handed an envelope too thin. The
    section order WITHIN a day is the CSV's own, which is what makes the booklet
    numbering reproducible -- rerun it and the same section gets the same range.
    """
    by_day = OrderedDict((key, []) for key in DAYS)
    for code, info in sections.items():
        day = info["day"]
        if day not in by_day:
            die(
                f"{code} has Day {day!r} in course-sections.csv, which is not "
                f"one of {', '.join(repr(k) for k in DAYS)}. Fix the spelling "
                f"-- a day this script does not recognise would leave the "
                f"section out of the order entirely."
            )
        if info["registered"] is None:
            die(
                f"{code} has no readable enrolment in course-sections.csv. The "
                f"column is \"registered/capacity\", e.g. 22/25."
            )
        by_day[day].append((code, info))

    for day, rows in by_day.items():
        if not rows:
            warn(f"no sections have Day {day!r}; that day's order will be empty.")
    return by_day


def size_sac_block(rows, sac_counts, cushion):
    """How many booklets the SAC needs for one day -> (number, how it was reached).

    Every `yes' plus every `unknown' in the day's sections, then the cushion --
    a small margin for a booking made after the order went in, or a student who
    changes their mind on the morning. The cushion is what the flat ballpark used
    to be, shrunk to the size of the uncertainty that is actually left.

    The second value spells the sum out ("4 yes + 3 unknown + 5 cushion"), for
    the question that offers this number as a default.
    """
    yes = unknown = 0
    for code, _info in rows:
        tally = sac_counts.get(code, {})
        yes += tally.get("yes", 0)
        unknown += tally.get("unknown", 0)
    return (
        yes + unknown + cushion,
        f"{yes} yes + {unknown} unknown + {cushion} cushion",
    )


def build_day(day_key, rows, spare, sac_counts, sac_block, pages):
    """One day's booklet plan: a row per section, then the SAC block, then totals.

    THE STACK IS THE POINT. What comes back from Print Services is one pile of
    identical booklets per day, so the only thing that divides it is counting
    from the top. Every row therefore carries a contiguous range, they abut
    exactly, the first starts at 1 and the last ends at the total.

    A SECTION IS SHORT BY ITS SAC WRITERS. Someone who writes at the SAC needs a
    booklet at the SAC and not one in their tutorial room, so they come out of
    their section's count and go into the block below. Students whose column is
    still blank do NOT come out -- they are counted in both places, deliberately;
    see WHO WRITES AT THE SAC in courseadmin.py.

    THE SAC BLOCK IS LAST so that its instruction to Print Services can be "the
    last N booklets" -- a thing someone can do at the end of a run without
    counting past it. It is a row in the same table, sharing the same numbering,
    because a separate count is what made the spreadsheet's note contradict
    itself.
    """
    entries, cursor = [], 1
    enrolled = at_sac = 0
    for code, info in rows:
        leaving = sac_counts.get(code, {}).get("yes", 0)
        # Never below zero, however wrong the shared file is: a section with more
        # SAC rows than registered students is a data error worth surviving, and
        # read_sac_students has already said so.
        copies = max(0, info["registered"] - leaving) + spare
        entries.append({
            "label": code,
            "ta": info["ta"] or "--",
            "room": info["room"] or "--",
            "enrolled": info["registered"],
            "at_sac": leaving,
            "copies": copies,
            "first": cursor,
            "last": cursor + copies - 1,
        })
        enrolled += info["registered"]
        at_sac += leaving
        cursor += copies

    sac_entry = None
    if sac_block:
        sac_entry = {
            "label": SAC_LABEL,
            "ta": "--",
            "room": SAC_LABEL,
            "enrolled": None,
            "at_sac": 0,
            "copies": sac_block,
            "first": cursor,
            "last": cursor + sac_block - 1,
        }
        entries.append(sac_entry)
        cursor += sac_block

    return {
        "key": day_key,
        "short": DAYS[day_key]["short"],
        "long": DAYS[day_key]["long"],
        "calendar": DAYS[day_key]["calendar"],
        "entries": entries,
        "sac": sac_entry,
        "sections": len(rows),
        "enrolled": enrolled,
        "at_sac": at_sac,
        "spare": spare,
        "booklets": cursor - 1,
        # Pages in ONE booklet, and so the last page of this day's whole stack:
        # the Crowdmark PDF is the booklet repeated, so booklet 403 of an 8-page
        # test ends on page 3224. That is where the PDF is split.
        "pages": pages,
        "last_page": (cursor - 1) * pages,
    }


def split_instruction(plan):
    """Where to cut one day's Crowdmark PDF, as a sentence.

    Crowdmark can only generate a test for the whole course, so each day's
    download holds a booklet for every student -- several hundred more than that
    day needs. Only the first `booklets' of them are printed.

    TWO WAYS TO SAY IT, and no tool named. Splitting the PDF first is kinder to
    Print Services, who then print the file they were sent; telling them where
    to stop does the same job with nothing but the page number. Either way the
    number is the same, and it is all this script contributes.
    """
    return (
        f"Split the Crowdmark PDF after page {plan['last_page']} (the end of "
        f"booklet {plan['booklets']}), or ask Print Services to print pages "
        f"1-{plan['last_page']} only."
    )


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% THE OUTPUT
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# NOTHING IS HARD-WRAPPED. Every answer in an order sits on one logical
# line however long it is, because these lines exist to be selected and pasted
# into a web form: a description broken over two lines pastes as a description
# with a newline in it. The terminal may soft-wrap them, which costs nothing.

def placeholders(plan, test_number, test_date, monday):
    """Everything a print-job.csv value may interpolate, for one day."""
    return {
        "course": COURSE_NAME,
        "test": test_number,
        "day": plan["short"],
        "day_long": plan["long"],
        "date": test_date or plan["long"].capitalize(),
        "sections": plan["sections"],
        "enrolled": plan["enrolled"],
        "at_sac": plan["at_sac"],
        "spare": plan["spare"],
        "sac": plan["sac"]["copies"] if plan["sac"] else 0,
        "sac_first": plan["sac"]["first"] if plan["sac"] else 0,
        "sac_last": plan["sac"]["last"] if plan["sac"] else 0,
        "booklets": plan["booklets"],
        "pages": plan["pages"],
        # Sheets of paper in one booklet: half the pages, rounded up.
        "leaves": -(-plan["pages"] // 2),
        "last_page": plan["last_page"],
        # Left generic when the calendar cannot say, which is exactly what the
        # spreadsheet always did -- see find_test_days.
        "monday": monday or "Monday",
    }


def fill(template, values, field):
    """Interpolate one print-job.csv value, or say precisely what is wrong with it.

    A bad placeholder in a data file must not surface as a bare KeyError
    traceback: the person who typed it is editing a CSV, not reading Python.
    """
    try:
        return template.format(**values)
    except KeyError as unknown:
        die(
            f"{PRINT_JOB_CSV.name}: field `{field}' uses {{{unknown.args[0]}}}, "
            f"which is not a thing this script can fill in. Available: "
            f"{', '.join('{' + k + '}' for k in sorted(values))}."
        )
    except (IndexError, ValueError):
        die(
            f"{PRINT_JOB_CSV.name}: field `{field}' has a stray {{ or }} in its "
            f"value. Double them ({{{{ and }}}}) to mean a literal brace."
        )


def render_envelopes(plans, test_number, dates):
    """The TA split: one table per day, columns sized to the data."""
    out = [
        f"{COURSE_NAME} -- Test {test_number} -- ENVELOPE SPLIT",
        f"Generated by test-admin on {date.today().isoformat()}. "
        f"Do not edit -- rerun the script.",
        "",
        "Each day's print job comes back as ONE stack of identical booklets.",
        "Count from the top: every section's range below is contiguous with the",
        "next, and the SAC block is the tail of the stack.",
        "",
        "atSAC is how many of that section write at the SAC instead; their",
        "booklets are in the SAC block, not the section's envelope.",
    ]

    for plan in plans:
        entries = plan["entries"]
        stamp = dates.get(plan["key"])
        heading = plan["long"] + (f" -- {stamp}" if stamp else "")

        # Sized to the widest cell rather than fixed, so a course with longer TA
        # names or room codes still lines up.
        w_sec = max(7, max(len(e["label"]) for e in entries))
        w_ta = max(2, max(len(e["ta"]) for e in entries))
        w_room = max(4, max(len(e["room"]) for e in entries))
        w_num = max(len(str(plan["booklets"])), 3)

        # Built once so the rule under the table and the totals row can be laid
        # out against the header rather than against a recount of the widths.
        head = (
            f"  {'Section':<{w_sec}}  {'TA':<{w_ta}}  {'Room':<{w_room}}  "
            f"{'Enrol':>5}  {'atSAC':>5}  {'Copies':>6}"
        )
        names_width = w_sec + w_ta + w_room + 4

        out += ["", heading, "-" * len(heading), head + "  Booklets"]
        for entry in entries:
            enrolled = "-" if entry["enrolled"] is None else str(entry["enrolled"])
            span = f"{entry['first']:>{w_num}}-{entry['last']:>{w_num}}"
            at_sac = "-" if entry["enrolled"] is None else str(entry["at_sac"])
            out.append(
                f"  {entry['label']:<{w_sec}}  {entry['ta']:<{w_ta}}  "
                f"{entry['room']:<{w_room}}  {enrolled:>5}  {at_sac:>5}  "
                f"{entry['copies']:>6}  {span}"
            )
        total_label = f"{plan['sections']} sections"
        out.append("  " + "-" * (len(head) - 2))
        out.append(
            f"  {total_label:<{names_width}}  "
            f"{plan['enrolled']:>5}  {plan['at_sac']:>5}  {plan['booklets']:>6}"
        )

    return "\n".join(out) + "\n"


def print_job_days(plans, fields, test_number, dates, monday):
    """Each day's order as data: a title, summary lines, the form's answers.

    One list feeds both outputs -- the text a dry run prints and the workbook --
    so the two cannot disagree about what was ordered.
    """
    days = []
    for plan in plans:
        stamp = dates.get(plan["key"])
        values = placeholders(plan, test_number, stamp, monday)
        rows = [
            (label, fill(template, values, name))
            for name, label, template in fields
            if plan["sac"] or not any(p in template for p in SAC_PLACEHOLDERS)
        ]
        days.append({
            "sheet": f"{plan['calendar']} order",
            "title": plan["long"] + (f" -- {stamp}" if stamp else ""),
            "summary": [
                f"{plan['booklets']} booklets x {plan['pages']} pages "
                f"= {plan['last_page']} pages to print",
                f"({plan['enrolled']} enrolled"
                + (f" - {plan['at_sac']} at SAC" if plan["at_sac"] else "")
                + f" + {plan['spare']} spare x {plan['sections']} sections"
                + f" + {plan['sac']['copies'] if plan['sac'] else 0} for the SAC)",
                split_instruction(plan),
            ],
            "rows": rows,
        })
    return days


# The settings of print-job.csv worth showing above an order, and what to call
# them. Not form answers -- these are where the form IS, and who the file drop
# is addressed to.
ORDER_LINKS = (
    ("form_url", "Form"),
    ("filedrop_url", "File drop"),
    ("filedrop_recipients", "Send to"),
)


def render_print_job(days, settings, test_number):
    """The web form's answers as text, for a dry run's terminal."""
    out = [f"{COURSE_NAME} -- Test {test_number} -- PRINT SERVICES ORDER"]
    for name, caption in ORDER_LINKS:
        if settings.get(name):
            out.append(f"{caption + ':':<11}{settings[name]}")
    out += [
        "",
        f"{len(days)} SEPARATE ORDERS, one per lecture day. The file you upload is",
        "the booklet repeated, so Quantity stays 1 and the booklet count is stated",
        "in the description instead.",
        "",
        "Values are never wrapped: each sits on one line, ready to copy whole.",
    ]

    for day in days:
        rule = "=" * 70
        out += ["", rule, day["title"]]
        out += ["  " + line for line in day["summary"]]
        out.append(rule)
        for label, value in day["rows"]:
            out += ["", label, "    " + value]

    return "\n".join(out) + "\n"


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% THE WORKBOOK
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# What is written to disk: one workbook, TWO SHEETS PER DAY, because each day is
# its own order and its own stack of paper.
#
# THE ENVELOPE SHEETS COME FIRST. An order sheet is read once, on the day the
# order is placed; an envelope sheet is opened again and again for the rest of
# the test's life, as booklets are handed out and then ticked off. The sheets a
# workbook opens on should be the ones it is opened for.
#
# The envelope sheets are not only output: their `Scanned' column is ticked by
# hand as each section's tests are scanned and uploaded, which is why main()
# refuses to overwrite the workbook without --force.

# The column of an envelope sheet that holds the checkboxes, and the row its
# header sits on. Named because checkbox_xlsx addresses cells by coordinate.
SCANNED_COLUMN = "I"
HEADER_ROW = 4

BOLD = Font(bold=True)
TITLE = Font(bold=True, size=14)
DIM = Font(italic=True, color="666666")


def add_envelope_sheet(workbook, plan, test_number, stamp, generated):
    """One day's TA split, as a sheet -> (its name, the cells to make checkboxes).

    The cells are returned rather than converted here because checkbox_xlsx works
    on the SAVED file: openpyxl cannot write a checkbox, so the workbook is saved
    with plain booleans and the boxes are added afterwards.
    """
    sheet = workbook.create_sheet(f"{plan['calendar']} envelopes")
    sheet["A1"] = (
        f"{COURSE_NAME} -- Test {test_number} -- {plan['long']}"
        + (f" -- {stamp}" if stamp else "")
    )
    sheet["A1"].font = TITLE
    sheet["A2"] = (
        f"Generated by test-admin on {generated}. Count from the top of "
        f"the stack: each range follows on from the one above, and the SAC "
        f"block is the tail."
    )
    sheet["A2"].font = DIM

    headers = ["Section", "TA", "Room", "Enrol", "atSAC", "Copies",
               "First", "Last", "Scanned"]
    for column, text in enumerate(headers, start=1):
        cell = sheet.cell(row=HEADER_ROW, column=column, value=text)
        cell.font = BOLD
        cell.border = Border(bottom=Side(style="thin"))

    row = HEADER_ROW
    cells = []
    for entry in plan["entries"]:
        row += 1
        is_sac = entry["enrolled"] is None
        sheet.append([
            entry["label"],
            None if is_sac else entry["ta"],
            None if is_sac else entry["room"],
            None if is_sac else entry["enrolled"],
            None if is_sac else entry["at_sac"],
            entry["copies"],
            entry["first"],
            entry["last"],
            # A real boolean: the checkbox is only a way of displaying it.
            False,
        ])
        sheet[f"{SCANNED_COLUMN}{row}"].alignment = Alignment(horizontal="center")
        cells.append(f"{SCANNED_COLUMN}{row}")

    # The totals, as numbers rather than formulas: they describe an order
    # that has been placed, and must not change if someone edits a row.
    row += 1
    sheet.append([f"{plan['sections']} sections", None, None,
                  plan["enrolled"], plan["at_sac"], plan["booklets"]])
    for cell in sheet[row]:
        cell.font = BOLD
        cell.border = Border(top=Side(style="thin"))

    for letter, width in zip("ABCDEFGHI", (10, 18, 16, 7, 7, 8, 7, 7, 10)):
        sheet.column_dimensions[letter].width = width
    sheet.freeze_panes = f"A{HEADER_ROW + 1}"
    return sheet.title, cells


def add_order_sheet(workbook, day, settings, test_number, generated):
    """One day's answers to the web form, as a sheet: one cell per answer.

    Two columns, the form's question and its answer, in the form's own order:
    reading down the sheet and down the web page is the same motion. Copying a
    cell copies its whole value, so the long ones are wrapped for reading
    without any risk of a newline reaching the form.
    """
    sheet = workbook.create_sheet(day["sheet"])
    sheet["A1"] = f"{COURSE_NAME} -- Test {test_number} -- {day['title']}"
    sheet["A1"].font = TITLE
    for line in day["summary"]:
        sheet.append([line])
    sheet.append([f"Generated by test-admin on {generated}."])
    sheet.cell(row=sheet.max_row, column=1).font = DIM

    # The links, as live hyperlinks: the form is the next thing opened.
    sheet.append([])
    for name, caption in ORDER_LINKS:
        if not settings.get(name):
            continue
        target = settings[name]
        sheet.append([caption, target])
        cell = sheet.cell(row=sheet.max_row, column=2)
        # Anything that is not a web address is one or more email addresses;
        # a mailto: link takes several, separated by commas and no spaces.
        if "://" in target:
            cell.hyperlink = target
        else:
            cell.hyperlink = "mailto:" + target.replace(" ", "")
        cell.style = "Hyperlink"

    sheet.append([])
    sheet.append(["Form field", "Value"])
    for cell in sheet[sheet.max_row]:
        cell.font = BOLD
        cell.border = Border(bottom=Side(style="thin"))
    for label, value in day["rows"]:
        sheet.append([label, value])
        for cell in sheet[sheet.max_row]:
            cell.alignment = Alignment(wrap_text=True, vertical="top")

    sheet.column_dimensions["A"].width = 44
    sheet.column_dimensions["B"].width = 90


def write_workbook(path, plans, days, settings, test_number, dates, generated):
    """test-N.xlsx: every day's envelope sheet, then every day's order sheet.

    `generated' is the date printed on each sheet.
    """
    workbook = Workbook()
    # A new Workbook arrives holding one empty sheet; every sheet here is named,
    # so that one goes.
    workbook.remove(workbook.active)

    checkbox_cells = {}
    for plan in plans:
        name, cells = add_envelope_sheet(
            workbook, plan, test_number, dates.get(plan["key"]), generated
        )
        checkbox_cells[name] = cells
    for day in days:
        add_order_sheet(workbook, day, settings, test_number, generated)

    workbook.save(path)
    for sheet_name, cells in checkbox_cells.items():
        checkbox_xlsx.add_checkboxes(path, sheet_name, cells)


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% THE FOLLOW-THROUGH
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# The files are the easy half. What actually gets a test printed is a handful of
# things done by hand on three websites, in an order that matters, a few times a
# term -- rarely enough to forget one. So the run does not end when the workbook
# is written: it walks through those steps one at a time and waits at each.
#
# NOTHING HERE IS CHECKED. The script cannot see Crowdmark or Print Services; a
# `y' is taken on trust. The point is only that each step is put in front of
# whoever is running this, with the numbers it needs, and cannot be passed
# without being answered.

def find_coverpages(test_number):
    """The test's cover-page PDFs in the mirror -> a list of paths, maybe empty.

    The cover page is a view of the test (build-pdfs' `coverpage'), handed to
    students ahead of time. Matched loosely -- test-2a-tue-COVERPAGE.pdf and
    test-1a-tue_COVERPAGE.pdf have both been its name.
    """
    mirror = find_mirror_dir()
    if mirror is None:
        return []
    return sorted((mirror / "TESTS").glob(f"test-{test_number}*COVERPAGE.pdf"))


def follow_through_steps(test_number, plans, settings, workbook_path):
    """What is left to do by hand -> a list of (title, [detail lines]).

    In the order it has to happen: the file must exist before it can be named on
    the order form, and the order is what tells Print Services a file is coming.
    """
    day_names = " and ".join(f"Test {test_number} ({plan['calendar']})"
                             for plan in plans)
    order_sheets = " and ".join(f"`{plan['calendar']} order'" for plan in plans)
    pages_per_day = [
        f"{plan['calendar']}  pages 1-{plan['last_page']}  "
        f"(booklets 1-{plan['booklets']})"
        for plan in plans
    ]

    steps = [
        (
            "Set the test up in Crowdmark and download the booklets",
            [
                f"One assessment per day: {day_names}.",
                "Crowdmark makes a booklet for every student in the course on "
                "each, so both downloads are far longer than what gets printed.",
            ],
        ),
        (
            "Label the questions in Crowdmark",
            [f"In both assessments: {day_names}."],
        ),
        (
            "Split each Crowdmark PDF",
            [
                "Keep the first part of each; the rest is spare booklets.",
                *pages_per_day,
                "(Or leave the PDFs whole and tell Print Services to print "
                "only those pages.)",
            ],
        ),
        (
            f"Place both orders with Print Services -- {len(plans)} separate orders",
            [
                settings.get("form_url", ""),
                f"The answers are in {workbook_path.name}, sheets {order_sheets}.",
                f"({workbook_path.parent})",
            ],
        ),
        (
            "Drop the files",
            [
                settings.get("filedrop_url", ""),
                f"Send to: {settings.get('filedrop_recipients', '')}",
                "One file per day -- the split PDFs from step 3.",
            ],
        ),
    ]

    coverpages = find_coverpages(test_number)
    if coverpages:
        detail = [str(path) for path in coverpages]
    else:
        detail = [
            paint(f"No test-{test_number}*COVERPAGE.pdf was found in the "
                  f"mirror's TESTS/.", "red"),
            "Build it first (build-pdfs, with `coverpage' among the test's "
            "views), then hand it out.",
        ]
    steps.append(("Make the cover page available to students", detail))

    # A setting missing from print-job.csv leaves an empty line; drop those
    # rather than print a blank where a link should be.
    return [(title, [line for line in lines if line.strip()])
            for title, lines in steps]


def show_step(number, total, title, lines, lead="NEXT STEP"):
    """Print one step: a numbered heading, then its details indented."""
    print()
    print(paint(f"{lead} ({number} of {total}): {title}", "bold"))
    for line in lines:
        print(f"    {line}")


def walk_follow_through(steps, asking):
    """Put each step on screen and wait for it to be done.

    THERE IS NO DEFAULT. Every other question in this script takes Enter for
    its usual answer; here Enter alone asks again, because the one thing this
    must not do is let a step go by on a reflex. The answers are:

      y   done -- on to the next step
      s   skip: not done, carry on anyway. It is listed again at the end.
      q   stop here. The steps not reached are printed in full, so they are
          still on the screen to work from.

    `asking' is False for --yes and --dry-run. Neither can vouch that a step
    was done, so every step is printed as still to do and none is asked about.
    """
    total = len(steps)
    if not asking:
        print()
        print(paint("STILL TO DO, by hand:", "bold"))
        for number, (title, lines) in enumerate(steps, start=1):
            show_step(number, total, title, lines, lead="STEP")
        return

    not_done = []
    for number, (title, lines) in enumerate(steps, start=1):
        show_step(number, total, title, lines)
        answer = ""
        while answer not in ("y", "s", "q"):
            try:
                answer = input(
                    "  Enter y once this is done  (s = skip for now, "
                    "q = stop here): "
                ).strip().casefold()
            except (EOFError, KeyboardInterrupt):
                # Ctrl-D or Ctrl-C at this point means "stop", not "crash".
                print()
                answer = "q"

        if answer == "s":
            not_done.append(title)
        elif answer == "q":
            # This step and everything after it, in full: stopping must not
            # cost the instructions for what is left.
            remaining = steps[number:]
            if remaining:
                print()
                print(paint("Stopped. Also still to do:", "yellow"))
                for later, (later_title, later_lines) in enumerate(
                        remaining, start=number + 1):
                    show_step(later, total, later_title, later_lines,
                              lead="STEP")
            not_done.append(title)
            not_done += [later_title for later_title, _lines in remaining]
            break

    print()
    if not_done:
        print(paint(f"NOT DONE YET ({len(not_done)} of {total}):", "yellow"))
        for title in not_done:
            print(f"    {title}")
    else:
        print(paint(f"All {total} steps done.", "green"))


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% THE RUN
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

def parse_count(value):
    """An argument that must be a whole number, zero or more."""
    if value.isdigit():
        return int(value)
    raise argparse.ArgumentTypeError(
        f"{value!r} is not a whole number, zero or more"
    )


def parse_pages(value):
    """Check --pages before it multiplies into a page count."""
    if value.isdigit() and int(value) > 0:
        return int(value)
    raise argparse.ArgumentTypeError(
        f"{value!r} is not a positive whole number of pages, e.g. 8"
    )


def main():
    global ASSUME_YES

    parser = argparse.ArgumentParser(
        description=f"Everything {COURSE_NAME} test N needs on paper: the "
        f"per-section attendance sheets, the Print Services order, and which "
        f"booklets go in which TA's envelope.",
        epilog="Run once per test. It asks before each step that needs a "
        "decision; Enter accepts the default shown, and --yes accepts them "
        "all. Instructors drop their class-list exports in the shared folder "
        "UNRENAMED and delete nothing; the newest per instructor is used.",
    )
    parser.add_argument(
        "test_number",
        metavar="N",
        type=parse_test_number,
        help="test number, e.g. 2 (a positive whole number)",
    )
    parser.add_argument(
        "--yes",
        action="store_true",
        help="answer every question with its default, asking nothing; the "
        "steps done by hand are then listed rather than asked about",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="go through every step and print the result, but write no files "
        "-- not the workbook, not the attendance sheets, not "
        "course-sections.csv",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="replace an existing test-N.xlsx, losing any `Scanned' ticks in it",
    )
    parser.add_argument(
        "--spare",
        type=parse_count,
        metavar="N",
        help="extra booklets per section, without being asked (default: "
        "print-job.csv's spare_per_section)",
    )
    parser.add_argument(
        "--sac",
        type=parse_count,
        metavar="N",
        help="the SAC block, exactly N on each day, without being asked "
        "(default: count sac-students.xlsx and add sac_cushion)",
    )
    parser.add_argument(
        "--pages",
        type=parse_pages,
        metavar="P",
        help="pages in one booklet, for when the test PDFs cannot be measured "
        "(default: the page count of each day's test PDF)",
    )
    parser.add_argument(
        "--keep-tex",
        action="store_true",
        help="keep the generated attendance-sheet .tex after a good build, so "
        "a sheet can be hand-corrected and recompiled",
    )
    parser.add_argument(
        "--roster-dir",
        type=Path,
        default=DEFAULT_ROSTER_DIR,
        help="where the class-list exports are (default: the shared OneDrive "
        "folder, exported-classlists)",
    )
    parser.add_argument(
        "--stale-days",
        type=int,
        default=DEFAULT_STALE_DAYS,
        metavar="DAYS",
        help=f"flag a class list older than this (default: {DEFAULT_STALE_DAYS})",
    )
    args = parser.parse_args()
    ASSUME_YES = args.yes
    test_number = args.test_number

    fields, settings = read_print_job()
    sections = read_sections()

    # ASKED FOR FIRST, before any question, so that a run which is going to be
    # refused is refused before anyone has answered four prompts. A dry run
    # writes nothing and so has nothing to be refused over.
    workbook_path = OUTPUT_DIR / f"test-{test_number}.xlsx"
    if not args.dry_run:
        ensure_output_dir()
        if workbook_path.exists() and not args.force:
            die(
                f"{workbook_path.name} already exists in {OUTPUT_DIR}, and may "
                f"have `Scanned' boxes ticked in it. This is run once per test. "
                f"Rerun with --dry-run to see today's figures without writing "
                f"anything, or with --force to replace the workbook and lose "
                f"its ticks."
            )

    # --- 1. THE TEST FILES ---------------------------------------------------
    pages = find_test_files(test_number, args.pages)
    proceed_or_stop("Are these the tests to print?")

    # --- 2. THE CLASS LISTS --------------------------------------------------
    current, total_files = select_current_exports(args.roster_dir, sections)
    report_freshness(current, sections, args.stale_days, total_files, args.roster_dir)
    proceed_or_stop("Carry on with these class lists?")
    students = collect_students(current, sections)

    # --- 3. ENROLMENT --------------------------------------------------------
    # CORRECTED BEFORE ANYTHING IS COUNTED, so the sheets, the envelopes and the
    # order are all computed from one set of numbers. A no leaves the file as it
    # is and orders from what it says -- the file is the authority either way,
    # and the only question is whether to bring it up to date first.
    updates, agreed, unchecked = plan_enrolment_updates(
        sections, students, current, args.stale_days
    )
    report_enrolment(updates, agreed, unchecked)
    if updates:
        if confirm(f"Update {SECTIONS_CSV.name} with these?"):
            apply_enrolment(sections, updates)
            if args.dry_run:
                say(f"  dry run: {SECTIONS_CSV.name} not written, but the "
                    f"figures below use the corrected numbers.")
            else:
                write_enrolment(updates)
                say(f"  {SECTIONS_CSV.name} updated. Now double-check these "
                    f"against {CATALOG_HINT}.")
        else:
            say(f"  {SECTIONS_CSV.name} left as it is; the order uses its "
                f"figures.")

    # --- 4. THE NUMBERS ------------------------------------------------------
    by_day = split_by_day(sections)

    # WHERE THE SAC NUMBER COMES FROM, in order of preference: --sac if it was
    # given, then what is typed at the question, whose default is the shared
    # file's count plus the cushion -- or print-job.csv's ballpark when that
    # file cannot be read. The ballpark over-prints on purpose: a missing shared
    # file should waste paper, not strand a student.
    sac_counts, sac_marked, sac_available = read_sac_students(sections)
    if not sac_available:
        sac_counts = {}
    # Matched now rather than when the sheets are built, so a SAC row that fits
    # nobody on a class list is on screen while the SAC numbers are being chosen.
    elsewhere = match_elsewhere(students, sac_marked)

    cushion = int(settings["sac_cushion"])
    if args.spare is not None:
        spare = args.spare
    else:
        spare = ask_number(
            "Spare booklets per section", int(settings["spare_per_section"])
        )

    blocks = {}
    for key, rows in by_day.items():
        if args.sac is not None:
            blocks[key] = args.sac
            continue
        if sac_available:
            default, note = size_sac_block(rows, sac_counts, cushion)
        else:
            default = int(settings["sac_fallback"])
            note = f"the ballpark; {SAC_STUDENTS_XLSX.name} could not be read"
        blocks[key] = ask_number(
            f"SAC booklets, {DAYS[key]['long'].capitalize()}", default, note
        )

    plans = [
        build_day(key, rows, spare, sac_counts, blocks[key], pages[key])
        for key, rows in by_day.items()
    ]

    if all(not plan["sac"] for plan in plans):
        warn(
            "no SAC copies are being ordered, so the print-job.csv fields that "
            "describe the SAC block are left out of the order. Check that no "
            "student has arranged to write at the SAC for this test."
        )

    calendar = read_calendar()
    dates, week = find_test_days(calendar, test_number)
    monday = find_monday(calendar, week)
    days = print_job_days(plans, fields, test_number, dates, monday)

    # The envelope split, as text: what the numbers just chosen come to.
    flush_report(tally=False)
    print()
    print(render_envelopes(plans, test_number, dates))

    # The size of each day's order, in one line each. Said just before the
    # follow-through, whose steps are the numbers put to use.
    def say_orders():
        say(paint(f"test {test_number}", "bold"))
        for plan in plans:
            say(
                f"  {plan['long']:<10} {plan['sections']:>2} sections  "
                f"{plan['enrolled']:>4} enrolled  "
                + paint(f"{plan['booklets']:>4} booklets", "bold")
                + f" x {plan['pages']} pages = {plan['last_page']} pages"
            )

    steps = follow_through_steps(test_number, plans, settings, workbook_path)

    # THE SHEET STATES WHAT IS IN THE ENVELOPE. Each section's row of the
    # envelope split is handed to its attendance sheet, so the booklet count in
    # the heading is the envelope's by construction. The SAC's row is not a
    # section and has no sheet.
    entries_by_section = {
        entry["label"]: entry
        for plan in plans
        for entry in plan["entries"]
        if entry["enrolled"] is not None
    }
    tex = render_tex(test_number, sections, students, entries_by_section,
                     elsewhere)

    if args.dry_run:
        print(render_print_job(days, settings, test_number))
        say_orders()
        say("")
        say("dry run: nothing written, so the steps below are only listed.")
        flush_report()
        walk_follow_through(steps, asking=False)
        return

    # --- 5. THE ATTENDANCE SHEETS ---------------------------------------------
    BUILD_DIR.mkdir(exist_ok=True)
    tex_path = BUILD_DIR / f"test-{test_number}-attendance-sheet.tex"
    tex_path.write_text(tex, encoding="utf-8")
    print(f"building {tex_path.stem}.pdf ({len(sections)} sheets) ...")

    pdf_path = tex_path.with_suffix(".pdf")
    if not compile_sheet(tex_path) or not pdf_path.exists():
        die(
            f"pr-latexmk failed -- read its log above, and inspect "
            f"{tex_path.name}, which is still there. The workbook was not "
            f"written."
        )

    # Checked where it was built, then moved whatever the verdict: a PDF with a
    # stranded heading is still worth looking at, and the warning says not to
    # print it. The page count only decides what happens to the .tex below.
    verified = check_one_page_per_sheet(pdf_path, len(sections))
    delivered = OUTPUT_DIR / pdf_path.name
    shutil.move(str(pdf_path), str(delivered))

    # THE SOURCE GOES WHEN THE PDF IS PROVEN GOOD, and only then. It is pure build
    # residue -- reproducible from the class lists by rerunning, read by nothing
    # else, and a second plaintext copy of every student's name that no longer has
    # to sit on the disk once the PDF it exists to make is verified.
    #
    # KEPT WHENEVER THE GUARD DID NOT PASS, including when it could not run at
    # all. A wrong page count is exactly the moment the source is worth having:
    # it is the one failure LaTeX reports nowhere, and the fix is a length in
    # attendance.sty followed by a look at what actually overflowed.
    if args.keep_tex:
        kept = f"{tex_path.name} kept (--keep-tex)"
    elif verified:
        tex_path.unlink()
        kept = None
    else:
        kept = None
        warn(
            f"{tex_path.name} was KEPT rather than cleaned up, because the "
            f"page-count check above did not pass. Fix what it reports, then "
            f"rerun with --force."
        )

    # --- 6. THE WORKBOOK -----------------------------------------------------
    write_workbook(workbook_path, plans, days, settings, test_number, dates,
                   date.today().isoformat())

    say_orders()
    say("")
    say(paint(f"written to {OUTPUT_DIR}", "bold"))
    say(f"  {delivered.name}")
    say(f"  {workbook_path.name}")
    if kept:
        say(f"  ({kept})")
    # The tally of warnings goes out HERE, before the first step: "check before
    # printing" is advice about the order that is about to be placed.
    flush_report()

    # --- 7. THE FOLLOW-THROUGH -----------------------------------------------
    # --yes cannot vouch that anything was done by hand, so it lists the steps
    # rather than waving them through.
    walk_follow_through(steps, asking=not args.yes)


if __name__ == "__main__":
    main()
