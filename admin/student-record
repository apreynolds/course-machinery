def new_record(key):
    return {
        "key": key, "id": "", "name": "", "email": "", "section": "", "day": "",
        "class_rows": [], "d2l": None, "live": False, "dropped": None,
        "moved": [], "other_sections": [], "sac": None, "sac_by_name": False,
    }


def build_records(class_rows, export, sac_rows, sections):
    """Join the three sources -> {key: record}, where the key is the student ID.

    A class-list row with no ID is keyed by its folded name instead, so it still
    gets a record even though nothing else can be joined to it.
    """
    records = {}
    for row in class_rows:
        key = row["id"] or fold_name(row["name"])
        record = records.setdefault(key, new_record(key))
        record["class_rows"].append(row)

    if export:
        for student_id, student in export["students"].items():
            record = records.setdefault(student_id, new_record(student_id))
            record["d2l"] = student

    for key, record in records.items():
        rows = record["class_rows"]
        live = [row for row in rows if not row["dropped"]]
        gone = [row for row in rows if row["dropped"]]
        student = record["d2l"]

        record["id"] = next((row["id"] for row in rows if row["id"]), key if student else "")
        record["name"] = (
            rows[0]["name"] if rows
            else f"{student['last']}, {student['first']}"
        )
        record["email"] = next((row["email"] for row in rows if row["email"]), "") or (
            student["email"] if student else ""
        )

        if live:
            record["live"] = True
            record["section"] = live[0]["section"]
            record["other_sections"] = sorted(
                {row["section"] for row in live} - {record["section"]}
            )
            # A dropped row in the same section means they left and came back.
            record["moved"] = sorted(
                (row["section"], row["dropped"]) for row in gone
                if row["section"] != record["section"]
            )
        elif gone:
            latest = max(gone, key=lambda row: row["dropped"])
            record["section"] = latest["section"]
            record["dropped"] = latest["dropped"]

        info = sections.get(record["section"])
        record["day"] = info["day"] if info else ""

    attach_sac(records, sac_rows)
    return records


def read_csv_rows(path):
    """A CSV as a list of dicts, or an empty list if it isn't there."""
    if not path.is_file():
        return []
    with path.open(encoding="utf-8-sig", newline="") as handle:
        return list(csv.DictReader(handle))


def read_known_staff(sections, staff_path):
    """Who the course already knows is teaching staff -> IDs, emails, names, initials.

    D2L's gradebook also holds everyone on the teaching team. They come from three
    places, each written its own way, hence the several sets:

      TAs-and-other-staff.csv  anyone, by ID, email or "First Last"
      course-sections.csv      TAs, as "First Last"
      instructors.csv          instructors, as "F. Last", with an email

    THE STAFF FILE'S ID AND EMAIL ARE WHAT MAKE THIS RELIABLE, since they survive a
    TA who goes by Rick and is Richard in D2L. The names remain for a new TA who is
    in course-sections.csv and not yet in the staff file.
    """
    names = {fold_name(info["ta"]) for info in sections.values() if info["ta"]}
    ids, initials, emails = set(), set(), set()
    # For showing a TA's email: the staff file's emails, under each folded name.
    emails_by_name = {}

    for row in read_csv_rows(INSTRUCTORS_CSV):
        instructor = fold_name(row.get("Instructor") or "")
        if instructor:
            initials.add(instructor)
        email = (row.get("Email") or "").strip().casefold()
        if email:
            emails.add(email)

    # In the shared folder, which may not have synced: say so, since otherwise this
    # looks like staff who have all become strangers.
    if not staff_path.is_file():
        warn(f"{staff_path} not found, so staff are recognised by name only.")

    for row in read_csv_rows(staff_path):
        # This file's column names are hand-typed, so their capitals don't matter.
        columns = {(key or "").strip().casefold(): value for key, value in row.items()}
        name = fold_name(columns.get("name") or "")
        if name:
            names.add(name)
        # Cleaned as D2L's are, in case a spreadsheet or a `#' got in the way.
        staff_id = gradebook.clean_org_id(columns.get("id"))
        if staff_id:
            ids.add(staff_id)
        email = (columns.get("email") or "").strip()
        if email:
            emails.add(email.casefold())
            emails_by_name.setdefault(name, []).append(email)
    return {"ids": ids, "names": names, "initials": initials, "emails": emails,
            "emails_by_name": emails_by_name}


def is_known_staff(record, staff):
    """Is this D2L-only record one of the people read_known_staff found?

    Only ever asked of someone on no class list, so a student who shares a TA's
    name cannot be hidden by it. Someone matching on nothing gets named by --check
    and can go in TAs-and-other-staff.csv.
    """
    student = record["d2l"]
    first, last = fold_name(student["first"]), fold_name(student["last"])
    return (
        record["id"] in staff["ids"]
        or f"{first} {last}" in staff["names"]
        or f"{first[:1]}. {last}" in staff["initials"]
        or student["email"].casefold() in staff["emails"]
    )


def attach_sac(records, sac_rows):
    """Put each SAC row on its student: by ID, or failing that by name."""
    for row in sac_rows:
        record = records.get(row["id"]) if row["id"] else None
        by_name = False
        if record is None:
            fold_last, fold_first = fold_name(row["last"]), fold_name(row["first"])
            matches = [r for r in records.values()
                       if same_person(r["name"], fold_last, fold_first)]
            # Their own section settles it if a namesake is elsewhere in the course.
            in_section = [r for r in matches if r["section"] == row["section"]]
            matches = in_section or matches
            if len(matches) != 1:
                what = f"matches {len(matches)} students" if matches else "matches nobody"
                warn(f"sac-students.xlsx row {row['number']} {what}, so it is on no "
                     f"record. Add its student ID.")
                continue
            record, by_name = matches[0], True
        record["sac"] = row
        record["sac_by_name"] = by_name


class Course:
    """Everything read for one run, in one place to pass around."""

    def __init__(self, args):
        self.as_of = args.as_of
        self.sections = read_sections()

        self.current, _total, _superseded = select_current_exports(args.roster_dir, self.sections)
        class_rows = []
        for path, nominal_section, _exported in self.current.values():
            class_rows.extend(read_class_list(path, nominal_section))

        # Module-level in courseadmin, so that its messages name the right file.
        courseadmin.SAC_STUDENTS_XLSX = args.sac_workbook
        _counts, _marked, self.sac_read, sac_rows = read_sac_students(self.sections)

        self.export_path, self.export_stamp, self.export = None, None, None
        if args.grades_dir.is_dir():
            self.export_path, self.export_stamp = gradebook.newest_export(args.grades_dir)
        if self.export_path:
            self.export = gradebook.read_d2l_export(self.export_path)
        else:
            warn(f"no D2L grades export in {args.grades_dir}, so no grades are shown.")

        self.records = build_records(class_rows, self.export, sac_rows, self.sections)
        self.enrolled = [r for r in self.records.values() if r["live"]]
        self.known_staff = read_known_staff(self.sections, args.staff)

        self.scheme, self.assessments = None, []
        if args.scheme.is_file() and args.assessments.is_file():
            self.scheme = gradebook.read_grading_scheme(args.scheme)
            self.assessments = gradebook.read_assessments(self.scheme, args.assessments)
        elif self.export:
            warn(f"{args.scheme.name} or {args.assessments.name} is missing, so no "
                 f"grades are shown.")

        self.progress = {}
        self.graded = bool(self.export and self.assessments)
        if self.graded:
            gradebook.check_items(self.assessments, self.export["items"])
            self.progress = gradebook.find_marked_items(
                self.assessments, self.scheme, self.export,
                [(r["id"], r["day"]) for r in self.enrolled],
            )
            self.class_stats, self.section_stats = self.all_statistics()

    def absent_instructors(self):
        named = {info["instructor"] for info in self.sections.values() if info["instructor"]}
        return sorted(named - set(self.current))

    def ids_in(self, section=None):
        return [r["id"] for r in self.enrolled if not section or r["section"] == section]

    def all_statistics(self):
        """Every listed item's figures, for the class and for each section."""
        items = self.export["items"]
        listed = [item for a in self.assessments for item in a["items"] if item in items]
        by_section = {}
        for record in self.enrolled:
            by_section.setdefault(record["section"], []).append(record["id"])

        class_stats, section_stats = {}, {}
        everyone = self.ids_in()
        students = self.export["students"]
        for item in listed:
            max_points = items[item]["max"]
            class_stats[item] = gradebook.item_statistics(item, max_points, everyone, students)
            for section, ids in by_section.items():
                section_stats[(item, section)] = gradebook.item_statistics(
                    item, max_points, ids, students)
        return class_stats, section_stats

    def standing_of(self, record):
        grades = record["d2l"]["grades"] if record["d2l"] else {}
        return gradebook.standing(
            grades, record["day"], self.assessments, self.scheme,
            self.export["items"], self.progress, self.as_of,
        )

    def source_lines(self, record=None):
        """Where the figures came from, and how old that is."""
        lines = []
        today = datetime.now()
        if record and record["section"] in self.sections:
            instructor = self.sections[record["section"]]["instructor"]
            if instructor in self.current:
                exported = self.current[instructor][2]
                lines.append(f"class list  {instructor}'s, {exported.strftime('%Y-%m-%d')} "
                             f"({(today - exported).days} days old)")
        elif not record:
            for instructor, (_path, _section, exported) in self.current.items():
                lines.append(f"class list  {instructor}'s, {exported.strftime('%Y-%m-%d')} "
                             f"({(today - exported).days} days old)")
        if self.export_stamp:
            # The clock in the filename may not be local, so only the date is claimed.
            lines.append(f"D2L export  {self.export_stamp.strftime('%Y-%m-%d')}, "
                         f"{self.export_path.name}")
        absent = self.absent_instructors()
        if absent:
            lines.append(paint(f"NO CLASS LIST from {', '.join(absent)}: "
                               f"their students' sections are unknown", "yellow"))
        return lines


#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#% ONE RECORD, AS TEXT
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

def percent(value):
    return "--" if value is None else f"{value:.1f}%"


def shade(text, value):
    """Colour already-formatted text by a percentage: failing, weak, or fine.

    Takes the text separately so that padding can happen first: the escape codes
    would otherwise count towards the width and throw the columns out.
    """
    if value is None:
        return paint(text, "dim")
    if value < 50:
        return paint(text, "red")
    return paint(text, "yellow" if value < 70 else "green")


def points(value):
    """30.0 as 30 and 22.5 as 22.5."""
    return f"{value:g}"


def describe(evaluation, record, course, counts=True):
    """One assessment's line: what they got, and how that compares.

    `counts' is False for a homework track that is not the student's better one.
    A blank there is no cause for alarm, since nobody is meant to do both.
    """
    item, status = evaluation["item"], evaluation["status"]
    label = f"  {item:<34}"
    due = evaluation["assessment"]["due"]

    if status == "not-in-export":
        return label + paint("not in the D2L export", "red")
    if status == "exempt":
        return label + "Exempt"
    if status == "missing" and not counts:
        return label + paint("blank", "dim")
    if status == "missing":
        return label + paint(f"MISSING, counts as 0 (due {due})", "red")
    if status == "pending":
        recorded, expected = course.progress.get(item, (0, 0))
        return label + paint(f"not marked yet ({recorded} of {expected} recorded)", "dim")
    if status == "not-due" and evaluation["score"] is None:
        when = f"due {due}" if due else "no due date set"
        return label + paint(f"not due, {when}", "dim")

    text = (f"{points(evaluation['score'])}/{points(evaluation['max'])}  "
            + shade(f"{percent(evaluation['percent']):>6}", evaluation["percent"]))
    if status == "not-due":
        text += paint("  still open", "dim")
    if "times" in evaluation:
        text += f"  x{evaluation['times']}"

    class_mean = course.class_stats.get(item, {}).get("mean")
    section_mean = course.section_stats.get((item, record["section"]), {}).get("mean")
    text += paint(f"   class {percent(class_mean)}", "dim")
    if section_mean is not None:
        text += paint(f"  {record['section']} {percent(section_mean)}", "dim")
    if evaluation["note"]:
        text += "  " + paint(evaluation["note"], "yellow")
    return label + text


def render_grades(record, course):
    if not record["d2l"]:
        return [paint("Not in the D2L export, so no grades.", "yellow")]

    result = course.standing_of(record)
    due, total = result["due_weight"], sum(e["weight"] for e in course.scheme.values())
    lines = [paint("MARK SO FAR  ", "heading") + shade(percent(result["mark"]), result["mark"])
             + f"   ({due:g}% of the {total:g}% has come due)", ""]

    for name, category in result["categories"].items():
        heading = f"{name} ({category['weight']:g}%)"
        if category["rule"] == "ranked-1-2-3":
            heading += (f"   ranked {percent(category['value'])}"
                        f"   plain average {percent(category['average'])}")
        elif category["rule"] == "best-track":
            if category["undetermined"]:
                heading += "   " + paint("left out: its better track is not due yet", "yellow")
            elif category["best_track"]:
                heading += f"   {category['best_track']} {percent(category['value'])}"
        else:
            heading += f"   {percent(category['value'])}"
        lines.append(paint(heading, "heading"))

        if category["rule"] == "best-track":
            for track, info in category["tracks"].items():
                lines.append(f" {track}: {percent(info['value'])}, {info['due']} due so far")
                counts = track == category["best_track"]
                lines.extend(describe(e, record, course, counts) for e in info["evaluations"])
            if category["both_tracks"]:
                lines.append(" " + paint("Has work in more than one track.", "yellow"))
        else:
            lines.extend(describe(e, record, course) for e in category["evaluations"])
        lines.append("")
    return lines


def render_record(record, course):
    lines = [paint(record["name"], "heading") + f"   {record['id'] or 'no ID'}   {record['email']}"]

    info = course.sections.get(record["section"])
    if info:
        lines.append(f"{record['section']}  {info['day']}  Room: {info['room']}  "
                     f"TA: {info['ta'] or '--'}  Instructor: {info['instructor'] or '--'}")
    elif record["section"]:
        lines.append(f"{record['section']} (not in course-sections.csv)")

    if record["live"]:
        status = paint("Registered", "green")
        for section, when in record["moved"]:
            status += f", moved from {section} on {when}"
        if record["other_sections"]:
            status += paint(f", ALSO LISTED IN {', '.join(record['other_sections'])}", "red")
    elif record["dropped"]:
        status = paint(f"DROPPED {record['dropped']}", "red")
    else:
        status = paint("Not on any class list", "yellow")
    lines.append(f"Status: {status}")

    sac = record["sac"]
    if sac:
        text = paint(f"on the list, writes-at-sac: {sac['where']}", "cyan")
        if sac["section"] != record["section"] and record["section"]:
            text += paint(f", list says {sac['section']}", "yellow")
        if record["sac_by_name"]:
            text += paint(", matched by name, so please confirm", "yellow")
    elif course.sac_read:
        text = "not on the list"
    else:
        text = paint("could not read the list", "yellow")
    lines.append(f"SAC: {text}")
    lines.append("")

    if course.graded:
        lines.extend(render_grades(record, course))
    lines.extend(paint(line, "dim") for line in course.source_lines(record))
    return "\n".join(lines)


