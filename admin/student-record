#% THE MODES
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

def sorted_records(course):
    return sorted(course.records.values(), key=lambda r: fold_name(r["name"]))


def encode_for_printf(text):
    """Make text safe as one fzf field, for printf %b to turn back.

    A field cannot contain a newline, because a line is one student. The escape
    character is encoded too, since fzf's --ansi would otherwise consume it.
    """
    return (text.replace("\\", "\\\\").replace("\033", "\\0033")
            .replace("\n", "\\n").replace("\t", " "))


def run_search(course, query):
    if not shutil.which("fzf"):
        die("fzf is not on PATH. --show QUERY works without it.")

    # Fields: name, section, ID, email-or-status, then two that are not displayed:
    # the record, for the preview, and the bare email, for copying.
    lines = []
    for record in sorted_records(course):
        shown = record["email"]
        if record["dropped"]:
            shown += "  DROPPED"
        elif not record["class_rows"]:
            shown += "  no class list"
        lines.append("\t".join([
            record["name"].ljust(32), record["section"].ljust(7), record["id"].ljust(9),
            shown, encode_for_printf(render_record(record, course)), record["email"],
        ]))

    # Warnings would vanish behind fzf's screen, so they are counted in its header.
    warnings = len(courseadmin.report_warnings)
    courseadmin.report_warnings.clear()
    header = [paint(line, "dim") for line in course.source_lines() if "D2L" in line or "NO CLASS" in line]
    if warnings:
        header.append(f"{warnings} warning(s): see student-record --check")
    header.append("Enter copies email, Tab marks several, Esc leaves")

    # printf %b is run by fzf's shell, and a bash builtin and a zsh builtin agree on it.
    command = ["fzf", "--ansi", "--multi", "--delimiter=\t", "--with-nth=1,2,3,4",
               "--tabstop=2", "--preview", "printf '%b' {5}",
               "--preview-window=down,65%,wrap", "--header", "\n".join(header),
               "--query", query or ""]
    result = subprocess.run(command, input="\n".join(lines), stdout=subprocess.PIPE, text=True)

    # fzf exits 130 on Esc and 1 on no match; neither is a mistake worth reporting.
    if result.returncode != 0 or not result.stdout.strip():
        return
    emails = []
    for line in result.stdout.splitlines():
        email = line.split("\t")[5] if line.count("\t") >= 5 else ""
        if email:
            emails.append(email)
    if not emails:
        print("No email on record for that selection.")
        return

    copy_emails(emails)


def copy_emails(emails):
    """Print emails and put them on the clipboard, ready for Outlook's To line."""
    joined = "; ".join(emails)
    print(paint(joined, "dim"))
    try:
        subprocess.run(["pbcopy"], input=joined, text=True, check=True)
        print(paint(f"Copied {len(emails)} email(s).", "green"))
    except (FileNotFoundError, subprocess.CalledProcessError):
        print("Could not reach the clipboard; the text is above.")


def run_emails(course, section):
    """Copy the email of everyone registered in one section, leaving out drops."""
    section = section.strip().upper()
    if section not in course.sections:
        die(f"{section} is not in course-sections.csv.")

    # Without that instructor's class list, nobody can be placed in this section.
    instructor = course.sections[section]["instructor"]
    if instructor not in course.current:
        die(f"no class list from {instructor}, so who is in {section} is unknown.")

    # A student registered in two sections belongs on both of their lists.
    records = [r for r in sorted_records(course) if r["live"]
               and (r["section"] == section or section in r["other_sections"])]
    if not records:
        die(f"nobody is registered in {section}, according to {instructor}'s class list.")

    exported = course.current[instructor][2]
    print(paint(f"{section}: {len(records)} registered", "heading")
          + paint(f", from {instructor}'s class list of {exported.strftime('%Y-%m-%d')} "
                  f"({(course.as_of - exported.date()).days} days old)", "dim"))
    info = course.sections[section]
    print(paint("Tutorial: ", "cyan")
          + f"{info['day'] or 'no day listed'}, {info['room'] or 'no room listed'}")
    if info["ta"]:
        ta_emails = course.known_staff["emails_by_name"].get(fold_name(info["ta"]))
        print(paint("TA: ", "cyan") + f"{info['ta']}, "
              f"{', '.join(ta_emails) if ta_emails else 'no email in the staff file'}")
    else:
        print(paint("TA: ", "cyan") + "none listed")
    for record in records:
        if not record["email"]:
            print(paint(f"No email on record for {record['name']}", "yellow"))

    emails = [r["email"] for r in records if r["email"]]
    if emails:
        copy_emails(emails)
    return 0


def run_d2l_import(course, grades_dir):
    """Write a file for D2L's grade import, holding each student's mark so far.

    The format is D2L's: an identifier, "<item> Points Grade", and an End-of-Line
    Indicator of #. The item is named by grade_so_far_item in admin-settings.csv,
    and it is itself in the export, which is harmless: it is not in assessments.csv,
    so last week's value plays no part in this week's.

    STUDENTS WILL SEE THIS, so it refuses when a class list is missing rather than
    write a file that quietly skips a whole instructor, and it ends with what to
    look at before uploading. Only registered students get a row, so staff and
    students who have dropped are never touched.
    """
    item = courseadmin.SETTINGS.get("grade_so_far_item")
    if not item:
        die("add a grade_so_far_item row to admin-settings.csv, naming the D2L grade item.")
    if not course.graded:
        die("there are no grades to work from. See student-record --check.")
    absent = course.absent_instructors()
    if absent:
        die(f"no class list from {', '.join(absent)}, so their sections can't be worked out.")
    if item not in course.export["items"]:
        die(f"{item!r} is not in the D2L export. Is that its exact name in D2L, "
            f"and is the export newer than the item?")

    # The marks are out of 100, and the item need not be.
    maximum = course.export["items"][item]["max"]
    rows, marks, no_d2l, no_mark = [], [], [], []
    for record in sorted_records(course):
        if not record["live"]:
            continue
        if not record["d2l"]:
            no_d2l.append(record)
            continue
        mark = course.standing_of(record)["mark"]
        if mark is None:
            no_mark.append(record)
            continue
        marks.append(mark)
        rows.append([record["id"], f"{mark * maximum / 100:.1f}", "#"])

    path = grades_dir / f"grade-so-far-import-{course.as_of}.csv"
    with path.open("w", encoding="utf-8", newline="") as handle:
        writer = csv.writer(handle)
        writer.writerow(["OrgDefinedId", f"{item} Points Grade", "End-of-Line Indicator"])
        writer.writerows(rows)

    print(paint(f"{item}: {len(rows)} students, as of {course.as_of}", "heading"))
    average = gradebook.mean(marks)
    print("  mean " + shade(percent(average), average)
          + paint(f"  from the export of {course.export_stamp.strftime('%Y-%m-%d')}", "dim"))
    for label, group in (("not in D2L", no_d2l), ("nothing due yet", no_mark)):
        for record in group:
            print(paint(f"  left out, {label}: {record['name']}, {record['section']}", "yellow"))

    print(paint("\nBefore you upload", "heading"))
    clear = True
    for assessment in course.assessments:
        if not assessment["due"] or assessment["due"] >= course.as_of:
            continue
        for test in assessment["items"]:
            recorded, expected = course.progress.get(test, (0, 0))
            if recorded == expected:
                continue
            clear = False
            if gradebook.is_marked(test, course.progress):
                print(paint(f"  {test}: {recorded} of {expected} recorded, "
                            f"so {expected - recorded} blank(s) count as 0", "yellow"))
            else:
                print(paint(f"  {test}: {recorded} of {expected} recorded, "
                            f"so it is taken as not marked and left out", "yellow"))
    if clear:
        print(paint("  every test and exam that has come due is fully recorded", "green"))

    flush_report(tally=False)
    print(paint(f"\nWrote {path}", "green"))
    return 0


def run_show(course, query):
    wanted = fold_name(query)
    found = [
        record for record in sorted_records(course)
        if wanted in fold_name(" ".join([record["name"], record["id"], record["email"]]))
    ]
    for record in found:
        print(render_record(record, course))
        print()
    if not found:
        print(f"No student matches {query!r}.")
        absent = course.absent_instructors()
        if absent:
            print(f"That does not rule them out: no class list from {', '.join(absent)}.")
    return 0 if found else 1


def statistic_row(stats):
    text = (shade(f"{percent(stats['mean']):>6}", stats["mean"])
            + f"  median {percent(stats['median']):>6}  " + paint(f"n={stats['n']:<4}", "dim"))
    return text + (f" exempt={stats['exempt']}" if stats["exempt"] else "")


def run_class(course, section):
    if not course.graded:
        die("there are no grades to summarise. See student-record --check.")
    section = section.strip().upper()
    if section and section not in course.sections:
        die(f"{section} is not in course-sections.csv.")

    # A section writes on one day, so the other day's version of a test isn't its own.
    day = course.sections[section]["day"] if section else ""

    records = [r for r in course.enrolled if not section or r["section"] == section]
    ids = [r["id"] for r in records]
    print(paint(f"MATH {COURSE_NUMBER}{' ' + section if section else ''}: "
                f"{len(records)} registered, as of {course.as_of}", "heading"))
    print(paint("Dropped students are left out; blanks are left out of averages.\n", "dim"))

    items = course.export["items"]
    students = course.export["students"]
    for category in course.scheme:
        print(paint(category, "heading"))
        for assessment in course.assessments:
            if assessment["category"] != category:
                continue
            due = f"due {assessment['due']}" if assessment["due"] else "no due date"
            print(f" {assessment['title']}  " + paint(f"({due})", "dim"))
            for item in assessment["items"]:
                if item in items and not gradebook.item_applies(item, day):
                    # Hidden, but someone who wrote it on the other day is still said.
                    stats = gradebook.item_statistics(item, items[item]["max"], ids, students)
                    if stats["n"]:
                        print(paint(f"  {item}: {stats['n']} of this section wrote this version",
                                    "yellow"))
                    continue
                if item not in items:
                    print(f"  {item:<34}" + paint("not in the D2L export", "red"))
                    continue
                stats = gradebook.item_statistics(item, items[item]["max"], ids, students)
                line = f"  {item:<34}{statistic_row(stats)}"
                if item in course.progress and not gradebook.is_marked(item, course.progress):
                    recorded, expected = course.progress[item]
                    line += paint(f"  not marked yet ({recorded}/{expected})", "dim")
                print(line)
        print()

    standings = [(r, course.standing_of(r)) for r in records]
    marks = [s["mark"] for _r, s in standings if s["mark"] is not None]
    if marks:
        print(paint("Mark so far", "heading"))
        average = gradebook.mean(marks)
        below = sum(mark < 50 for mark in marks)
        print("  mean " + shade(percent(average), average)
              + f"  median {percent(gradebook.statistics.median(marks))}  n={len(marks)}  "
              + paint(f"below 50: {below}", "red" if below else "green"))
        both = sum(any(c["both_tracks"] for c in s["categories"].values()) for _r, s in standings)
        undetermined = sum(any(c["undetermined"] for c in s["categories"].values()) for _r, s in standings)
        if both:
            print(f"  {both} with work in more than one homework track")
        if undetermined:
            print(f"  {undetermined} with homework left out: their better track is not due yet")
        print()

    if not section:
        print(paint(f"  {'section':<8}{'day':<7}{'who':<6}{'n':>4}{'mark':>8}", "heading"))
        for code, info in course.sections.items():
            marks = [s["mark"] for r, s in standings
                     if r["section"] == code and s["mark"] is not None]
            average = gradebook.mean(marks)
            print(f"  {code:<8}{info['day']:<7}{info['instructor']:<6}{len(marks):>4}"
                  + shade(f"{percent(average):>8}", average))
        print()

    for line in course.source_lines():
        print(paint(line, "dim"))
    flush_report(tally=False)
    return 0


def count_shade(count):
    """A count of things that ought to be zero: green if it is, yellow if not."""
    return paint(str(count), "yellow" if count else "green")


def print_unmatched(course, listed):
    """Who appears in only one of the class lists and D2L, naming those who matter.

    D2L's gradebook also holds the teaching team, who are on no class list, and who
    may have tried an online assignment and so have marks of no meaning. Marks
    therefore say nothing about who someone is. Everyone not known to be staff is
    named, marks or not; see read_known_staff.

    AN ABSENT CLASS LIST WOULD NAME THAT INSTRUCTOR'S WHOLE CLASS, so in that case
    the counts stand alone and the NO CLASS LIST line above gives the reason.
    """
    only_list = [r for r in course.enrolled if not r["d2l"]]
    only_d2l = [r for r in course.records.values() if not r["class_rows"]]

    print("  on a class list but not in D2L: " + count_shade(len(only_list)))
    # With no export at all, this would be everyone.
    if course.export:
        for record in sorted(only_list, key=lambda r: r["name"]):
            print(paint(f"    {record['name']}, {record['section']}, {record['id']}", "yellow"))

    print(f"  in D2L but on no class list:    {len(only_d2l)}")
    if not only_d2l:
        return
    unknown = [r for r in only_d2l if not is_known_staff(r, course.known_staff)]
    print(f"    known staff:                  {len(only_d2l) - len(unknown)}")
    print("    not known:                    " + count_shade(len(unknown)))
    if course.absent_instructors():
        return
    for record in sorted(unknown, key=lambda r: r["name"]):
        grades = record["d2l"]["grades"]
        count = sum(1 for item in listed if grades.get(item) is not None)
        marks = f", marks on {count} listed item(s)" if count else ""
        print(paint(f"      {record['name']}, {record['id']}{marks}", "yellow"))


def run_check(course):
    print(paint("What was read", "heading"))
    for line in course.source_lines():
        print(f"  {line}")
    print(f"  {len(course.enrolled)} registered, {len(course.records)} records in all")

    listed = {item for a in course.assessments for item in a["items"]}
    print_unmatched(course, listed)

    if course.graded:
        unlisted = {}
        for item, info in course.export["items"].items():
            if item not in listed:
                unlisted.setdefault(info["category"] or "(no category)", []).append(item)
        print(paint("\nIn the D2L export but not in assessments.csv, so not shown", "heading"))
        for category, items in unlisted.items():
            print(f"  {category}: {len(items)}")

        print(paint("\nHand-marked items", "heading"))
        for item, (recorded, expected) in course.progress.items():
            state = (paint("marked", "green") if gradebook.is_marked(item, course.progress)
                     else paint("not marked yet", "dim"))
            print(f"  {item:<34}{recorded:>4} of {expected:<4} {state}")

    flush_report(tally=False)
    return 0


def parse_date(text):
    try:
        return datetime.strptime(text, "%Y-%m-%d").date()
    except ValueError:
        raise argparse.ArgumentTypeError(f"{text!r} is not YYYY-MM-DD")


def main():
    parser = argparse.ArgumentParser(
        description="Look up a student, or a whole class, across the course's records.",
        # Keeps the line breaks in the examples below, which argparse would rewrap.
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  student-record --show smith\n"
            "  student-record --class FR05A\n"
            "  student-record --emails FR05A\n"
            "  student-record --d2l-import\n"
            "  student-record --class --as-of 2026-11-06      as if it were that date\n"
            "  student-record --class --scheme ~/trial.csv    try a different grading scheme\n"
            "\n"
            "--as-of counts everything due before that date, and only the marks in the\n"
            "export. A blank on a test counts as 0 once half its students have marks.\n"
            "\n"
            "--grades-dir always uses the newest export in the folder, so to see an older\n"
            "one, point it at a folder holding only that export."
        ),
    )
    parser.add_argument("query", nargs="?", help="start the interactive search with this")
    parser.add_argument("--show", metavar="QUERY", help="print matching records and stop")
    parser.add_argument("--class", dest="class_section", nargs="?", const="", metavar="SECTION",
                        help="how the class, or one section, is doing")
    parser.add_argument("--emails", metavar="SECTION",
                        help="copy the emails of everyone registered in a section")
    parser.add_argument("--check", action="store_true", help="what was read, and every warning")
    parser.add_argument("--d2l-import", action="store_true",
                        help="write the file that updates D2L's grade so far, beside the exports")
    parser.add_argument("--as-of", type=parse_date, default=date.today(), metavar="YYYY-MM-DD",
                        help="calculate as if it were this date")

    sources = parser.add_argument_group(
        "read something else instead",
        "Rarely needed, since the defaults are the real files. Each one needs a path.",
    )
    sources.add_argument("--roster-dir", type=Path, default=DEFAULT_ROSTER_DIR, metavar="DIR",
                         help="class lists (default: the Team's exported-classlists)")
    sources.add_argument("--sac-workbook", type=Path, default=SAC_STUDENTS_XLSX, metavar="F",
                         help="SAC list (default: the Team's sac-students.xlsx)")
    sources.add_argument("--grades-dir", type=Path, default=GRADES_DIR, metavar="DIR",
                         help="D2L exports (default: the Team's grades-exported-from-d2l)")
    sources.add_argument("--staff", type=Path, default=STAFF_CSV, metavar="F",
                         help="staff list (default: the Team's TAs-and-other-staff.csv)")
    sources.add_argument("--assessments", type=Path, default=ASSESSMENTS_CSV, metavar="F",
                         help="assessments and due dates (default: course-info/assessments.csv)")
    sources.add_argument("--scheme", type=Path, default=GRADING_SCHEME_CSV, metavar="F",
                         help="grading scheme (default: course-info/grading-scheme.csv)")
    args = parser.parse_args()

    course = Course(args)
    if args.check:
        return run_check(course)
    if args.d2l_import:
        return run_d2l_import(course, args.grades_dir)
    if args.class_section is not None:
        return run_class(course, args.class_section)
    if args.emails is not None:
        status = run_emails(course, args.emails)
        # Mostly about marks and the SAC list, so only counted here, as in the search.
        warnings = len(courseadmin.report_warnings)
        courseadmin.report_warnings.clear()
        if warnings:
            print(paint(f"{warnings} warning(s): see student-record --check", "dim"))
        return status
    if args.show is not None:
        status = run_show(course, args.show)
        flush_report(tally=False)
        return status
    run_search(course, args.query)
    return 0


if __name__ == "__main__":
    sys.exit(main())
