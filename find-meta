#!/usr/bin/env bash
# find-meta — search a bank of .tex files (problems, facts or passages) and write
# its import lines
#
# The shared engine behind find-problems, find-facts and find-passages. A "kind"
# (chosen with --kind) fixes three things: the block macro it reads (\ProblemMeta
# / \FactMeta), the import command it emits (\importproblem / \importfact /
# \import), and the key schema (which filters exist, which columns --tsv prints).
# Everything else -- reading a block off disk, matching, emitting -- is shared and
# lives here, in one place.
#
# TWO SHAPES OF BANK, and the difference runs deeper than the schema. A problem or
# fact TAGS ITSELF with a metadata block, and this script reads it. A passage does
# not: the directory is the bank, every .tex in it is an entry, and its title and
# label are computed from its file name. That kind is marked by an empty
# block_macro and takes its own path through the walk, never reaching either of
# the two block parsers -- see "A BANK WITH NO BLOCK" below.
#
# This file is not meant to be called directly: invoke the per-kind shims
# find-problems / find-facts / find-passages, which each `exec' this with the
# right --kind. See ProblemMeta.sty / FactMeta.sty for the block format this
# parses.
#
# Usage: find-meta --kind KIND [--as NAME] [FILTER ...] [--untagged] [--vocab]
#                  [--tsv] [--import [--with LIST] [--from DIR]] [PATH ...]
#
# Run `find-problems --help' (or find-facts, find-passages) for the flags of a
# kind: they differ, since a fact has no type/difficulty and a passage has no
# block, hence no filters, no --untagged and no --vocab -- and requires a PATH.
#
# Filters are ANDed; PAT is an extended regular expression matched
# case-insensitively against each comma-separated item in turn -- so `--topic
# power' finds `power-rule', and `--topic '^power-rule$'' matches only that. A
# filter for a key a file does not set never matches, so it will not report
# untagged files.
#
# Other modes: --untagged (invert: files with NO block -- the tagging backlog),
# --vocab (ignore filters, print the topic/type vocabulary with counts, the
# antidote to `integration' vs `integrals'), --import (paste-ready \import<kind>
# lines; --with LIST injects metadata keys as options where present (which keys
# are injectable depends on the kind -- see the case below); --from DIR
# rewrites the directory argument relative to the importing document's folder),
# and --tsv (one tab-separated row per match, the machine feed for a picker).
#
# An operand may be a directory (walked recursively) or a single .tex file, so a
# picker can ask --import about exactly the files it selected.
#
# The parser is textual and deliberately simple: it wants one key per line inside
# the block, value braced, as the *Meta.sty headers ask for. A block reflowed
# onto one line still compiles but will not be seen here.

# Bash 4+ is required (associative arrays, mapfile, ${var,,}). Written in 3.2-
# compatible syntax and placed before any of those, so an old bash reaches this
# message instead of failing with "declare: -A: invalid option" further down.
# macOS still ships bash 3.2 as /bin/bash and always will (it is GPLv2).
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  printf '%s: requires bash 4.0 or newer (running %s).\n' \
    "${0##*/}" "${BASH_VERSION:-not bash}" >&2
  printf 'macOS ships bash 3.2; install a newer one (e.g. `brew install bash`)\n' >&2
  printf 'and make sure it comes before /bin/bash on your PATH.\n' >&2
  exit 1
fi

set -uo pipefail

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# KIND / SCHEMA
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# --kind and --as are needed before the main option loop (they pick the schema
# and the program name used in messages), so pre-scan for them. The full argv is
# left intact for the loop below, which simply skips these two.
kind="" as=""
_a=("$@")
for ((_i = 0; _i < ${#_a[@]}; _i++)); do
  case ${_a[_i]} in
    --kind) kind=${_a[_i + 1]:-} ;;
    --as)   as=${_a[_i + 1]:-} ;;
  esac
done
prog=${as:-find-meta}

# Everything that differs between one bank and another lives in exactly this case.
# filter_specs are `flag:key' pairs -- each becomes a --flag PATTERN filter on that
# metadata key (the flag is singular by habit: --topic -> topics). tsv_cols /
# vocab_keys are metadata keys in report order. block/emit are the LaTeX macros.
# with_keys are the keys --with may inject as \import<kind> options, in the
# canonical order they are emitted -- per-kind, because a fact's kind/name select
# and title the environment it is wrapped in and a problem has no analogue. A kind
# may leave with_keys EMPTY (a passage does), which --with then refuses outright
# rather than narrowing.
case $kind in
  problem)
    noun="problem"; block_macro="ProblemMeta"; emit_macro="importproblem"
    filter_specs=(topic:topics type:type difficulty:difficulty source:source)
    tsv_cols=(name topics type difficulty source number)
    vocab_keys=(topics type difficulty)
    with_keys=(number name)
    ;;
  fact)
    noun="fact"; block_macro="FactMeta"; emit_macro="importfact"
    # NO kind: filter -- the flag would be `--kind', which this engine already
    # spends on choosing the bank (problem|fact), and the pre-scan would read the
    # filter's value as the bank. --vocab covers the audit need; add it under a
    # different flag name if filtering by kind is ever actually wanted.
    filter_specs=(topic:topics source:source)
    tsv_cols=(name kind topics source number)
    # kind is in the vocabulary for a sharper reason than topics: it names an
    # environment, so `thm' where the bank says `theorem' is a fact that will not
    # box, not merely a split search. --vocab is how that is caught off disk.
    vocab_keys=(topics kind)
    with_keys=(kind name number)
    ;;
  passage)
    # NO BLOCK AT ALL, and this is the only kind of which that is true. Every
    # .tex under a PATH operand IS a passage: the directory is the bank, and a
    # passage's TITLE AND LABEL ARE COMPUTED FROM ITS FILE NAME rather than read
    # out of it. An empty block_macro is the sentinel that says so, and it is a
    # DISPATCH PREDICATE only -- checked at four named places (this usage text,
    # the two rejections below, and the walk's exit) and never handed to awk.
    #
    # The block went on 2026-09-04 with \importpassage, whose \PassageTitle was
    # its only build-time reader. Every key it ever held had restated something:
    # `topics' the file name, `audience' the import graph, `depth' a check the
    # compiler already performs -- and finally `title' the file name again. What
    # a passage bank needed was never a search; it was the passage submodule itself
    # computed for you, which is --import --from, and a picker feed, which is
    # --tsv.
    noun="passage"; block_macro=""; emit_macro="import"
    filter_specs=()
    # Read by --help alone now: the passage walk prints its one derived column
    # itself, having no block to select columns out of.
    tsv_cols=(title)
    # Empty because --vocab is refused for this kind: no block, no vocabulary.
    vocab_keys=()
    # Still empty, but for a new reason -- not "level= belongs to the importing
    # document" but "there is no metadata here to inject". See the guard below.
    with_keys=()
    ;;
  '') echo "$prog: --kind is required (problem|fact|passage)" >&2; exit 2 ;;
  *)  echo "$prog: unknown --kind: $kind (want problem|fact|passage)" >&2; exit 2 ;;
esac

# flag -> key map (for the option loop) and the filter store (key -> pattern,
# only for keys actually asked about).
# The ${a[@]+"${a[@]}"} form, here and below, is for a kind with NO filters (the
# passage bank): a bare "${a[@]}" on an empty array is an unbound-variable error
# under `set -u' on bash 4.0-4.3, which is the floor the check at the top of this
# file advertises. Harmless on 4.4+, required to keep that promise honest.
declare -A flag_key=()
for _spec in ${filter_specs[@]+"${filter_specs[@]}"}; do
  flag_key[${_spec%%:*}]=${_spec#*:}
done
declare -A filt=()

usage() {
  # Help is generated from the active schema so each kind reports its own flags
  # and columns accurately (the three shims do not have the same filters, and a
  # passage takes no --with at all). This replaces find-problems' sed-reprint-the-
  # header trick, which cannot vary per kind.
  local spec flag key cols c verb filterarg

  # A BANK WITH NO BLOCK gets its own help and returns, rather than threading a
  # fifth set of conditionals through the body below. Four of the five chunks
  # would need one anyway -- the summary line, the synopsis, the "reads the
  # block" paragraph (both halves of which are false here) and Modes -- and the
  # early return leaves problem's and fact's help byte-identical, which is the
  # same reason the walk dispatches early rather than parameterising the awk.
  if [[ -z $block_macro ]]; then
    echo "$prog — list the $noun bank, and write its import lines for you"
    echo
    echo "Usage: $prog [--tsv] [--import [--from DIR]] PATH ..."
    echo
    echo "Lists every .tex file under each PATH: a ${noun} bank has no metadata"
    echo "block, so the DIRECTORY IS THE BANK and each file in it is an entry."
    echo "PATH is REQUIRED for that reason -- give the bank itself"
    echo "(\`$prog PASSAGES/passages'), never a course root, or every lecture and"
    echo "assessment in the course is reported as a ${noun}."
    echo
    echo "A ${noun}'s title and label come from its FILE NAME:"
    echo "  webwork-tips.tex  ->  \\section{Webwork Tips}\\label{sec:webwork_tips}"
    echo "Hyphens become spaces, words are capitalised except a short list of"
    echo "particles (of, in, is, for, the, ...), and an already-capitalised word"
    echo "is left alone (how-work-is-marked-TA -> ... Marked TA). It is a starting"
    echo "point to paste and edit, not a title to be trusted."
    echo
    echo "Modes:"
    echo "  --import    print each match as a paste-ready heading and \\$emit_macro:"
    echo "              a \\section/\\label line, a blank, then the \\$emit_macro,"
    echo "              with a blank line between entries."
    echo "    --from DIR    rewrite each directory argument relative to DIR."
    echo "  --tsv       one row per match: path<TAB>title"
    echo
    echo "Not accepted (all meaningless without a block): --untagged, --vocab,"
    echo "--with, and every filter."
    return
  fi

  # A bank with no filters is listed, not searched, and the summary line and the
  # usage synopsis both have to say so -- otherwise --help advertises a [FILTER]
  # slot that the option loop will reject.
  if (( ${#filter_specs[@]} )); then
    verb="search"; filterarg="[FILTER ...] "
  else
    verb="list";   filterarg=""
  fi
  echo "$prog — $verb the $noun bank by its \\$block_macro metadata"
  echo
  echo "Usage: $prog ${filterarg}[--untagged] [--vocab] [--tsv]"
  echo "       ${prog//?/ } [--import [--with LIST] [--from DIR]] [PATH ...]"
  echo
  echo "Reads the \\$block_macro{...} block out of every .tex file under each PATH"
  echo "(default: the current directory, recursively) and reports the files that"
  if (( ${#filter_specs[@]} )); then
    echo "match. With no filters, reports every file that has a block."
  else
    echo "have one."
  fi
  echo
  if (( ${#filter_specs[@]} )); then
    echo "Filters (optional, AND-combined; PAT is a case-insensitive ERE matched"
    echo "against each comma-separated item):"
    for spec in "${filter_specs[@]}"; do
      flag=${spec%%:*}; key=${spec#*:}
      printf '  --%-14s match the %s\n' "$flag PAT" "$key"
    done
  else
    # Say why rather than leaving a gap: a reader who knows the other two banks
    # will look for the filters here and needs to know they are absent by design.
    echo "Filters: none. A ${noun} bank is read, not searched -- the file name is"
    echo "the title, the bank is small, and the picker matches the title column."
  fi
  echo
  echo "Modes:"
  echo "  --untagged  invert: list .tex files with NO \\$block_macro block."
  echo "  --vocab     ignore filters; print the ${vocab_keys[*]} vocabulary with counts."
  echo "  --import    print matches as paste-ready \\$emit_macro lines."
  if (( ${#with_keys[@]} )); then
    echo "    --with LIST   subset of {$(IFS=,; echo "${with_keys[*]}")}: inject those as options where set."
  else
    echo "    --with        not accepted: a $noun has no injectable keys."
  fi
  echo "    --from DIR    rewrite each directory argument relative to DIR."
  cols="path"; for c in "${tsv_cols[@]}"; do cols+="<TAB>$c"; done
  echo "  --tsv       one row per match: $cols"
}

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# ARGUMENTS
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
with_request="" from_dir=""  # --import modifiers (validated below)
mode="list"                 # list | vocab | import | untagged | tsv
paths=()                    # search operands: directories and/or individual files

while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)   usage; exit 0 ;;
    # --kind/--as were consumed in the pre-scan; only stepped over here. The
    # guard matters: `shift 2' with one argument left shifts NOTHING (it fails
    # and leaves $# alone), so a trailing --as would spin this loop forever.
    --kind | --as)
      [[ $# -ge 2 ]] || { echo "$prog: $1 needs a value" >&2; exit 2; }
      shift 2 ;;
    --vocab)       mode="vocab";    shift ;;
    --import)      mode="import";   shift ;;
    --untagged)    mode="untagged"; shift ;;
    --tsv)         mode="tsv";      shift ;;
    --with)        with_request=${2:?--with needs a comma-separated key list}; shift 2 ;;
    --from)        from_dir=${2:?--from needs a directory};                 shift 2 ;;
    --*)
      f=${1#--}
      if [[ -n ${flag_key[$f]:-} ]]; then
        filt[${flag_key[$f]}]=${2:?--$f needs a pattern}; shift 2
      else
        echo "$prog: unknown option: $1" >&2
        echo "Try '$prog --help'." >&2
        exit 2
      fi ;;
    *)             paths+=("$1"); shift ;;
  esac
done

# --with / --from only make sense as modifiers of --import; reject them anywhere
# else so a silent no-op cannot hide a typo.
if [[ -n $with_request || -n $from_dir ]] && [[ $mode != import ]]; then
  echo "$prog: --with/--from only apply with --import" >&2
  exit 2
fi

# --with takes a comma-separated subset of the injectable keys for THIS kind (the
# with_keys set above) -- deliberately closed, so there is no per-key flag creep
# and a typo is refused rather than silently ignored. Collect the request as a set
# for the emitter below.

# A kind may have NO injectable keys (the passage bank), in which case --with is
# not a narrower request but a meaningless one -- say so, rather than falling into
# the loop below and reporting "accepts only  for a passage".
if [[ -n $with_request && ${#with_keys[@]} -eq 0 ]]; then
  printf '%s: a %s has no injectable keys, so --with is not accepted\n' \
    "$prog" "$noun" >&2
  echo "       a $noun carries no metadata at all -- its title and label are" >&2
  echo "       computed from its file name -- so there is nothing to inject into" >&2
  echo "       the emitted line. Edit the heading after pasting." >&2
  exit 2
fi

# The other two flags a BLOCKLESS kind cannot honour. Refused here rather than in
# the option loop above, which parses; this block judges -- the same split the
# --with rejection and the --with/--from-need-import check already observe. Two
# separate messages because they are meaningless for two different reasons, and
# --untagged in particular is the trap: it was genuinely useful for this bank
# until the block went, so a reader will reach for it out of habit.
if [[ -z $block_macro ]]; then
  case $mode in
    untagged)
      printf '%s: --untagged is not accepted for the %s bank\n' "$prog" "$noun" >&2
      echo "       it inverts a membership that no longer exists: with no metadata" >&2
      echo "       block, no file can lack one, and every .tex under PATH is a" >&2
      echo "       $noun. A plain run already lists them all." >&2
      exit 2 ;;
    vocab)
      printf '%s: --vocab is not accepted for the %s bank\n' "$prog" "$noun" >&2
      echo "       it prints the vocabulary of a tag set, and a $noun has no tags." >&2
      exit 2 ;;
  esac
fi

declare -A want=()
if [[ -n $with_request ]]; then
  IFS=, read -ra _wk <<< "$with_request"
  for k in "${_wk[@]}"; do
    k="${k//[[:space:]]/}"                 # tolerate `number, name' and trailing commas
    [[ -z $k ]] && continue                # ...and trailing commas
    _ok=0
    for _allowed in "${with_keys[@]}"; do
      [[ $k == "$_allowed" ]] && { _ok=1; break; }
    done
    if (( _ok )); then
      want[$k]=1
    else
      printf '%s: --with accepts only %s for a %s (got: %s)\n' \
        "$prog" "$(IFS=,; echo "${with_keys[*]}")" "$noun" "$k" >&2
      exit 2
    fi
  done
fi

if [[ -n $from_dir && ! -d $from_dir ]]; then
  echo "$prog: --from: not a directory: $from_dir" >&2
  exit 2
fi

# A BLOCKLESS KIND REQUIRES AN OPERAND, and this is the guard that makes the
# find-passages header comment's advice enforceable rather than advisory. With a
# block, a bare run defaulting to `.' is merely noisy: files without a block drop
# out, so a course root reports the bank and nothing else. Without one there is
# no such filter -- every .tex under `.' would be reported as a passage, and
# --import would emit a \section for every lecture and assessment in the course.
# So refuse, rather than default.
#
# Must sit here: before the existence loop below, and before `find "${paths[@]}"',
# where an empty array is itself an unbound-variable error under `set -u'.
if [[ ${#paths[@]} -eq 0 ]]; then
  if [[ -z $block_macro ]]; then
    printf '%s: a PATH is required -- name the %s bank itself\n' "$prog" "$noun" >&2
    echo "       e.g. \`$prog PASSAGES/passages'. The bank is a sibling submodule," >&2
    echo "       not a directory of the course, and there is no metadata block to" >&2
    echo "       tell its files from any other .tex -- so a bare run from a course" >&2
    echo "       root would report every lecture and assessment as a $noun." >&2
    exit 2
  fi
  paths=(".")
fi

# Operands may be directories (walked recursively) or individual .tex files --
# the picker's accept action passes specific selected files. `find' handles a
# mix of both; we only insist each operand exists.
for p in "${paths[@]}"; do
  if [[ ! -e $p ]]; then
    echo "$prog: no such file or directory: $p" >&2
    exit 2
  fi
done

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# READING A BLOCK
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# Prints one "key<TAB>value" line per key found in the file's \<kind>Meta block,
# or nothing at all if the file has no block. Everything downstream works off
# this, so the parsing rules live in exactly one place. The block macro name is
# the only kind-specific input; it travels via the environment (fm_macro), like
# the tsv filter patterns, to keep it away from awk -v's backslash processing.
read_meta() {
  fm_macro="$block_macro" awk '
    BEGIN { open_re = "\\\\" ENVIRON["fm_macro"] "[[:space:]]*[{]" }

    # The block opens on the line carrying \<Kind>Meta{ ...
    $0 ~ open_re { inblock = 1; next }

    # ... and closes at the first line starting with a brace.
    inblock && /^[[:space:]]*\}/ { inblock = 0; next }

    inblock {
      line = $0

      # Strip trailing LaTeX comments, but not an escaped \% inside a value.
      # Park the escaped ones under a byte that cannot occur in a .tex source,
      # cut at the first surviving %, then put them back.
      gsub(/\\%/, "\001", line)
      sub(/%.*$/, "", line)
      gsub(/\001/, "\\%", line)

      # A key line looks like:  name = {value},
      if (match(line, /^[[:space:]]*[A-Za-z]+[[:space:]]*=/)) {
        key = line
        sub(/[[:space:]]*=.*$/, "", key)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)

        val = line
        sub(/^[^=]*=[[:space:]]*/, "", val)   # drop up to and including the =
        sub(/,[[:space:]]*$/, "", val)        # drop the trailing comma
        gsub(/^\{|\}$/, "", val)              # drop the surrounding braces
        gsub(/\\#/, "#", val)                 # \# is how you must write # in TeX
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)

        printf "%s\t%s\n", key, val
      }
    }
  ' "$1"
}

# Pull one key out of a block dump (as produced by read_meta).
field() {
  local dump=$1 key=$2
  printf '%s\n' "$dump" | awk -F'\t' -v k="$key" '$1 == k { print $2; exit }'
}

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# DERIVING A TITLE AND LABEL (for a bank with no block)
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# The counterpart to read_meta above, and the contrast is the point: one kind
# READS its metadata off disk, the other COMPUTES it from the file name and never
# opens the file at all.
#
# That is also why the passage bank needs no --tsv fast path. The fast path below
# exists because read_meta forks awk plus a field() per key for every file; these
# two fork nothing -- they are pure parameter expansion. With one implementation
# there is nothing for a second to mirror, so the byte-identical-output policy the
# fast path is written under simply does not arise for this kind.
#
# Bank file names are hyphen-separated and lowercase by convention. A `_', `#',
# `$' or `&' in one would land raw inside \section{} and break the build; the
# convention is the guard, not an escaping pass.

# why-learn-math.tex -> Why Learn Math
passage_title() {
  local base=${1##*/} word out="" words=()
  base=${base%.tex}
  # read -ra rather than an unquoted expansion: splitting on the hyphens must not
  # also glob, and a bank file name is not guaranteed free of `*' or `?'.
  IFS=' ' read -ra words <<< "${base//-/ }"
  for word in ${words[@]+"${words[@]}"}; do
    # ${word^} capitalises the FIRST CHARACTER ONLY -- deliberately not
    # ${word,,} then ${word^}, which would turn the bank's how-work-is-marked-TA
    # into `... Ta'. An already-capitalised word is left as its author wrote it.
    case ${word,,} in
      of|in|is|for|the|a|an|and|to|on|at|with)
        # A particle stays lowercase unless it opens the title (`the-art-of-x'
        # -> `The Art of X'). No last-word exception: one sentence of rule is
        # worth more here than strict title-case, since every emitted heading is
        # read and edited before it is kept.
        [[ -z $out ]] && out=${word^} || out+=" ${word,,}" ;;
      *)
        out+="${out:+ }${word^}" ;;
    esac
  done
  printf '%s' "$out"
}

# why-learn-math.tex -> sec:why_learn_math. Exact where the title is only a
# starting point: this is the shape every sectioning label in the courses already
# has, and it matched six of the eight live call sites unchanged when the bank
# moved off \importpassage. Lowercased, so how-work-is-marked-TA.tex gives
# sec:how_work_is_marked_ta rather than shouting mid-label.
passage_label() {
  local base=${1##*/}
  base=${base%.tex}
  base=${base//-/_}
  printf 'sec:%s' "${base,,}"
}

# Print TARGET as a path relative to BASE (both absolutised first). Used by
# --from to make emitted \import<kind> directory arguments relative to the
# importing document. macOS's BSD realpath has no --relative-to, so lean on perl
# -- already a hard dependency of this repo (every .latexmkrc uses it) -- and its
# core File::Spec::abs2rel.
relpath() {
  perl -MFile::Spec -MCwd -e \
    'print File::Spec->abs2rel(Cwd::abs_path($ARGV[0]), Cwd::abs_path($ARGV[1]))' \
    "$1" "$2"
}

# The directory argument of an emitted import line, for the .tex file $1: its own
# directory, made relative to --from when that was given. Extracted so the two
# emitters -- the block kinds' and the blockless bank's -- cannot drift on the one
# piece of arithmetic a paste-ready line actually depends on.
import_dir() {
  if [[ -n $from_dir ]]; then
    relpath "$(dirname "$1")" "$from_dir"
  else
    dirname "$1"
  fi
}

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# MATCHING
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# Does any comma-separated item in $1 match the ERE in $2? An empty pattern
# means "no filter asked for", which matches everything -- including files that
# do not set the key at all.
csv_matches() {
  local list=$1 pattern=$2 item
  [[ -z $pattern ]] && return 0
  local IFS=,
  for item in $list; do
    item="${item#"${item%%[![:space:]]*}"}"     # trim leading whitespace
    item="${item%"${item##*[![:space:]]}"}"     # trim trailing whitespace
    [[ -z $item ]] && continue
    if [[ ${item,,} =~ ${pattern,,} ]]; then return 0; fi
  done
  return 1
}

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# WALK
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# -print0 / read -d '' so paths with spaces survive. Aux and build output never
# live beside the sources here, but two directories hold .tex that are NOT bank
# entries and must be pruned: .git (obvious), and .course-machinery -- the
# tooling submodule, whose manual/ documents \ProblemMeta and \FactMeta by
# SHOWING example blocks, which would otherwise be scraped as phantoms.
# Real banks live in course-content dirs (problems/, facts/, passages/), never in
# there. An explicit operand INSIDE .course-machinery still works (the prune only
# fires on a directory of that name met while descending).
#
# The prune matters MORE for a blockless kind, not less: a phantom there needed a
# convincing example block to be scraped, but every .tex under a passage PATH is
# an entry, so an unpruned manual/ would list its own chapters as passages.
files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(find "${paths[@]}" \( -name .git -o -name .course-machinery \) -prune \
           -o -type f -name '*.tex' -print0 | sort -z)

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# A BANK WITH NO BLOCK
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# Dispatched here, between the walk and the two parsers, so it inherits the
# walk's pruning and its sorted order for free and reaches NEITHER parser. That
# placement is the whole design: both parsers below are dense awk built around a
# block macro, and both are load-bearing for problem and fact -- the fast path is
# written to be byte-identical to the generic loop, an invariant that costs
# something to re-argue. A kind with no block has nothing to gain from either
# (no block to open, no keys to collect, no filters to apply), so it takes its
# own exit rather than threading a sentinel through code the other two run.
#
# --untagged and --vocab cannot arrive here; they were refused at parse time.
if [[ -z $block_macro ]]; then
  case $mode in
    tsv)
      # Two columns, matching the --with-nth=2.. the pickers feed this into.
      for f in ${files[@]+"${files[@]}"}; do
        printf '%s\t%s\n' "$f" "$(passage_title "$f")"
      done
      ;;

    import)
      # Three lines per entry, because the importing document owns the heading
      # now: a \section/\label built from the file name, a blank, then the
      # import. THE BLANK LINE BETWEEN ENTRIES IS EMITTED HERE, not by the
      # caller -- pick-meta pipes this straight to stdout and vim's <Space>ig
      # appends it verbatim, so the tool is the only place that can put it in
      # exactly once.
      _first=1
      for f in ${files[@]+"${files[@]}"}; do
        (( _first )) || echo
        _first=0
        printf '\\section{%s}\\label{%s}\n\n\\%s{%s/}{%s}\n' \
          "$(passage_title "$f")" "$(passage_label "$f")" \
          "$emit_macro" "$(import_dir "$f")" "$(basename "$f")"
      done
      ;;

    *)
      # The human listing. Same indented key: value shape the block kinds use,
      # so a bare run still reads like its two siblings.
      for f in ${files[@]+"${files[@]}"}; do
        echo "$f"
        echo "    title: $(passage_title "$f")"
        echo "    label: $(passage_label "$f")"
      done
      printf '%d %s(s).\n' "${#files[@]}" "$noun" >&2
      ;;
  esac
  exit
fi

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# FAST PATH: --tsv
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# --tsv is the machine feed for an interactive picker, so it has to be quick. The
# generic loop below spawns read_meta plus a field() per key for EVERY file --
# hundreds to thousands of forks -- fine for a human listing but laggy as an fzf
# source. So --tsv gets its own route: a SINGLE awk parses every file in one
# pass, applies the filters itself, and prints the rows. It reuses read_meta's
# exact parsing rules and csv_matches' exact semantics, so the output is
# byte-identical to the generic path -- just ~100x faster. The schema travels via
# the environment (fm_*, flt_*), not awk -v, so awk's backslash-escape processing
# cannot mangle a pattern. Columns/filters are data-driven from the active kind.
if [[ $mode == tsv ]]; then
  [[ ${#files[@]} -eq 0 ]] && exit 0

  cols_csv=$(IFS=,; printf '%s' "${tsv_cols[*]}")
  active=(); for k in "${!filt[@]}"; do active+=("$k"); done
  filt_csv=$(IFS=,; printf '%s' "${active[*]}")

  env_pairs=(fm_macro="$block_macro" fm_cols="$cols_csv" fm_filters="$filt_csv")
  for k in "${active[@]}"; do env_pairs+=("flt_$k=${filt[$k]}"); done

  printf '%s\0' "${files[@]}" \
    | env "${env_pairs[@]}" xargs -0 awk '
      function csv_match(value, pattern,   n, arr, i, item) {
        if (pattern == "") return 1
        n = split(value, arr, ",")
        for (i = 1; i <= n; i++) {
          item = arr[i]
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", item)
          if (item != "" && tolower(item) ~ tolower(pattern)) return 1
        }
        return 0
      }
      # One row per FILE, emitted at the file boundary -- matching the generic
      # path, which dumps a whole file with read_meta and then reads each key
      # with field() (first occurrence wins there too). Emitting per BLOCK
      # would diverge the moment a file held two blocks or lost its closing
      # brace, and the contract is byte-identical output.
      function emit(   ok, i, j, out) {
        if (!had_block) return
        ok = 1
        for (i = 1; i <= nfilt; i++)
          if (!csv_match(v[fk[i]], ENVIRON["flt_" fk[i]])) { ok = 0; break }
        if (ok) {
          out = path
          for (j = 1; j <= ncol; j++) out = out "\t" v[col[j]]
          print out
        }
      }
      BEGIN {
        open_re = "\\\\" ENVIRON["fm_macro"] "[[:space:]]*[{]"
        ncol  = split(ENVIRON["fm_cols"], col, ",")
        nfilt = (ENVIRON["fm_filters"] == "") ? 0 : split(ENVIRON["fm_filters"], fk, ",")
      }
      # New file: emit the row for the file just finished, then reset state.
      # split("",v) empties the array portably.
      FNR == 1 { emit(); path = FILENAME; inblock = 0; had_block = 0; split("", v) }
      $0 ~ open_re { inblock = 1; had_block = 1; next }
      inblock && /^[[:space:]]*\}/ { inblock = 0; next }
      # Key line inside the block -- read_meta parsing rules, verbatim. First
      # occurrence of a key wins, exactly like field() on the generic path.
      inblock {
        line = $0
        gsub(/\\%/, "\001", line); sub(/%.*$/, "", line); gsub(/\001/, "\\%", line)
        if (match(line, /^[[:space:]]*[A-Za-z]+[[:space:]]*=/)) {
          key = line; sub(/[[:space:]]*=.*$/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
          val = line; sub(/^[^=]*=[[:space:]]*/, "", val); sub(/,[[:space:]]*$/, "", val)
          gsub(/^\{|\}$/, "", val); gsub(/\\#/, "#", val); gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
          if (!(key in v)) v[key] = val
        }
      }
      END { emit() }
    '
  # No `exit 0': with pipefail, a failure in awk/xargs must reach the caller.
  exit
fi

matches=()
declare -A meta_of=()

for f in "${files[@]}"; do
  dump=$(read_meta "$f")

  if [[ $mode == untagged ]]; then
    [[ -z $dump ]] && matches+=("$f")
    continue
  fi

  [[ -z $dump ]] && continue          # no block -> not part of the bank

  # --vocab really does ignore the filters (as its help text promises): the
  # vocabulary must cover the whole bank, so every tagged file counts.
  if [[ $mode != vocab ]]; then
    ok=1
    for k in "${!filt[@]}"; do
      csv_matches "$(field "$dump" "$k")" "${filt[$k]}" || { ok=0; break; }
    done
    [[ $ok == 1 ]] || continue
  fi

  matches+=("$f")
  meta_of["$f"]=$dump
done

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# REPORT
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
case $mode in
  vocab)
    # Counts across every block found, per key. Filters are ignored: the point
    # is to see the whole vocabulary before adding to it.
    for key in ${vocab_keys[@]+"${vocab_keys[@]}"}; do
      echo "$key:"
      for f in "${matches[@]}"; do
        field "${meta_of[$f]}" "$key" | tr ',' '\n'
      done | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' \
           | sort | uniq -c | sort -rn | sed 's/^/  /'
      echo
    done
    ;;

  import)
    # \import<kind> is the wrapper a document actually wants (it reboxes the
    # imported file and carries the metadata options); its signature is
    # [opts]{dir/}{file}. The dir/file split is relative to the importing
    # document. Without --from we cannot know that document, so paths come out
    # relative to the search root and usually need a ../ or two (paste and
    # adjust); --from does the ../ for you.
    for f in "${matches[@]}"; do
      file=$(basename "$f")
      dir=$(import_dir "$f")

      # Injected options, in a fixed canonical order regardless of --with order.
      # A file that lacks a requested key is silently skipped for that key. Any
      # `#' has to be re-escaped to `\#': read_meta un-escaped it on the way in
      # (\# -> #), but `\%' it left intact, so % needs no re-escaping here.
      # The `else' branch below is the ordinary fallback again: it is what a
      # problem or fact run without --with takes. (It was briefly the passage
      # bank's only branch; that bank no longer reaches this emitter at all.)
      opts=""
      for key in ${with_keys[@]+"${with_keys[@]}"}; do
        [[ -n ${want[$key]:-} ]] || continue
        v=$(field "${meta_of[$f]}" "$key")
        [[ -n $v ]] || continue
        v=${v//'#'/\\#}
        opts+="${opts:+, }${key}={${v}}"
      done

      if [[ -n $opts ]]; then
        printf '\\%s[%s]{%s/}{%s}\n' "$emit_macro" "$opts" "$dir" "$file"
      else
        printf '\\%s{%s/}{%s}\n' "$emit_macro" "$dir" "$file"
      fi
    done
    ;;

  tsv)
    # Reference implementation of the --tsv columns (the fast path above short-
    # circuits before here and is what actually runs; this mirrors it exactly so
    # the two stay legible side by side). One tab-separated row per match: column
    # 1 is the path -- hidden from the picker's display, but kept because it is
    # what opens/previews the file and feeds back into --import.
    for f in "${matches[@]}"; do
      row=$f
      for key in "${tsv_cols[@]}"; do
        row+=$'\t'$(field "${meta_of[$f]}" "$key")
      done
      printf '%s\n' "$row"
    done
    ;;

  untagged)
    printf '%s\n' "${matches[@]}"
    echo >&2
    echo "${#matches[@]} file(s) with no \\$block_macro block." >&2
    ;;

  list)
    for f in "${matches[@]}"; do
      echo "$f"
      printf '%s\n' "${meta_of[$f]}" | sed 's/^/    /; s/\t/: /'
      echo
    done
    echo "${#matches[@]} match(es)." >&2
    ;;
esac
