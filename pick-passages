#!/usr/bin/env bash
# pick-passages — fzf picker over the passage bank; emits \section + \import.
# A thin shim over pick-meta (the shared picker). Forwards find-passages' PATH
# operands; `--from DIR' makes emitted paths relative to DIR. See pick-meta and
# find-passages.
#
# What comes out, per passage picked, is a heading built from the file name, a
# blank line, then the import -- the shape every call site writes by hand:
#
#     \section{Webwork Tips}\label{sec:webwork_tips}
#
#     \import{../PASSAGES/passages/}{webwork-tips.tex}
#
# The heading is a starting point, not an answer: the title is derived
# mechanically and will want editing (`Well Written' for `Well-written'), and a
# passage imported under an existing heading wants the \section line deleted.
#
# A PATH is required -- name the bank (`pick-passages PASSAGES/passages'), never
# a course root. There is no metadata block to filter on.
exec "$(dirname -- "$0")/pick-meta" --kind passage --as pick-passages "$@"
