#!/usr/bin/env python3
#
# pg-to-latex — scaffold a LaTeX problem file from a WeBWorK .pg problem
# Usage: pg-to-latex [-s SEED] [-o DIR] FILE.pg
#
#   -s, --seed N    freeze this problem seed (default 1234)
#   -o, --out DIR   write <name>.tex here instead of stdout
#   -n, --name STR  basename for the .tex file (default: derived, see below)
#   -h, --help      this text
#
# This is a SCAFFOLD, not a converter. It does the mechanical two thirds and
# leaves the judgement to a human, marked with % TODO. Expect to rewrite the
# body; expect not to have to retype the provenance.
#
# What it does:
#   - runs `pr-pg-render --tex --solution' at a frozen seed, so every $var is
#     already substituted and the solution comes along with the statement
#   - fills \ProblemMeta{} with source and number read from the .pg's own path
#     and its ## tag block
#   - carries the CLAUDE-GENERATED SOLUTION marker across when the .pg has one
#   - strips the WeBWorK furniture that means nothing on paper: answer rules,
#     "help (formulas)", \vskip\baselineskip, and the Book link
#   - splits statement from solution at PG's own `%%% BEGIN SOLUTION' marker and
#     wraps them in problem/solution
#
# What it CANNOT do, and flags instead:
#   - choose which seed to freeze. A branching problem may have a case worth
#     preferring: match-undetermined-coefficient-forms.tex deliberately takes
#     the branch containing the resonant case, because the other branch
#     exercises less. Render a few seeds and pick.
#   - map PG widgets onto Exercises.sty. Several ans_rules usually want qparts;
#     a PopUp set wants matching; a checkbox list wants choices. The scaffold
#     emits the flattened text and marks the spot.
#   - fill topics/type/difficulty. Those are judgements about the problem.
#   - state the randomisation invariant, which needs reading the .pg's setup.
#
# Background: the `webwork' skill's topics/pg-to-latex.md.

import argparse
import pathlib
import re
import subprocess
import sys

# WeBWorK furniture, dropped whole. Each entry is a regex applied line-by-line;
# a line that becomes empty is dropped unless it was already blank.
FURNITURE = [
    r"\{\\answerRule\[[^\]]*\]\{\d+\}\}",     # answer blanks
    r"\{\\bf\\underline\{help \([^)]*\)\}\}", # AnswerFormatHelp
    r"\\vskip\\baselineskip\s*",              # PG's $PAR
    r"\\par\\medskip\s*",                     # PG's solution trailer
    r"^%%% END SOLUTION\s*$",                 # PG's own delimiter
    r"\{\\bf\\underline\{[^}]*\}\}\s*$",      # a bare underlined link remnant
]

SOLUTION_MARK = "%%% BEGIN SOLUTION"
SOLUTION_LEAD = re.compile(r"\\par\\smallskip\{\\bf Solution:\s*\}")


def match_brace(text, open_at):
    """Index just past the brace group starting at text[open_at] == '{'.

    PG's output nests -- the Book link is {\\it ... {\\bf \\underline{...}} } --
    so a non-greedy regex stops at the first close brace and leaves the rest
    behind as stray braces. Counting is the only thing that works.
    """
    depth = 0
    for i in range(open_at, len(text)):
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                return i + 1
    return len(text)          # unbalanced; caller leaves it alone


def drop_group_containing(text, needle):
    """Remove the OUTERMOST {...} group holding `needle`.

    Outermost matters: PG writes the Book link as {\\it {\\bf Book: } ...}, so
    taking the nearest preceding brace removes only the inner {\\bf Book: } and
    leaves the link itself behind.
    """
    while True:
        at = text.find(needle)
        if at == -1:
            return text
        # The earliest preceding '{' whose group still encloses the needle.
        start = None
        for i, ch in enumerate(text[:at]):
            if ch == "{" and match_brace(text, i) > at:
                start = i
                break
        if start is None:
            return text
        text = text[:start] + text[match_brace(text, start):]


def modernise(text):
    """{\\bf X} -> \\textbf{X}, {\\it X} -> \\emph{X}, innermost first."""
    for old, new in (("{\\bf ", "\\textbf{"), ("{\\it ", "\\emph{"),
                     ("{\\bf\\", "\\textbf{\\"), ("{\\it\\", "\\emph{\\")):
        while old in text:
            at = text.find(old)
            end = match_brace(text, at)
            inner = text[at + len(old):end - 1].strip()
            text = text[:at] + new + inner + "}" + text[end:]
    return text


def tag(text, key):
    """Value of a ## Key(value) line from the .pg tag block, or None."""
    m = re.search(rf"^##\s*{key}\((.*?)\)\s*$", text, re.M)
    return m.group(1).strip() if m else None


# Warnings a perfectly good problem emits locally because webwork2 is not here
# to set them. WEBWORK/README.md section 7 lists these as local-render
# artefacts, not breakage. pr-pg-render exits non-zero on any warning, which is
# right for a gate and wrong for a scaffold: three of MATH1003's OS1.1 problems
# load PeriodicRerandomization.pl and so could not be converted at all
# otherwise. webwork-check is the gate; this is not.
SERVER_ARTEFACTS = (
    "numOfAttempts",
    "PeriodicRerandomization.pl",
    "formattedDueDate",
    "studentName",
    "setNumber",
)


def render(pg, seed):
    """The problem's TeX at one seed, statement and solution together."""
    out = subprocess.run(
        ["pr-pg-render", "--tex", "--solution", "--seed", str(seed), str(pg)],
        capture_output=True, text=True)
    if out.returncode != 0:
        noise = out.stderr + out.stdout
        complaints = [ln for ln in noise.splitlines()
                      if ("WARNING" in ln or "uninitialized" in ln or "ERROR" in ln)
                      and not any(a in ln for a in SERVER_ARTEFACTS)]
        if complaints:
            sys.exit(f"pg-to-latex: pr-pg-render failed on {pg}\n{noise}")
        print(f"pg-to-latex: {pg.name} warns only about server-supplied values "
              f"that are empty locally; scaffolding anyway.", file=sys.stderr)
    return out.stdout


def strip_furniture(text):
    text = drop_group_containing(text, "Book:")
    for pat in FURNITURE:
        text = re.sub(pat, "", text, flags=re.M)
    text = modernise(text)
    # Collapse the blank-line runs the removals leave behind.
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def indent(text, spaces):
    pad = " " * spaces
    return "\n".join(pad + ln if ln.strip() else "" for ln in text.split("\n"))


def scaffold(pg, seed):
    src = pg.read_text(encoding="utf-8")
    body = render(pg, seed)

    # <topic>/webwork/<tree>/<section>/<file>.pg -> tree and the rest
    parts = pg.parts
    tree = parts[parts.index("webwork") + 1] if "webwork" in parts else "unknown"
    number = "/".join(parts[parts.index("webwork") + 2:]) if "webwork" in parts else pg.name
    number = re.sub(r"\.pg$", "", number)   # the hand-written files omit it
    source = {"diffyqs": "diffyqs-webwork", "opl": "webwork-open-problem-library"}.get(tree, tree)

    statement, _, solution = body.partition(SOLUTION_MARK)
    solution = SOLUTION_LEAD.sub("", solution, count=1)

    statement = strip_furniture(statement)
    solution = strip_furniture(solution) if solution.strip() else \
        "% TODO no solution in the .pg -- write one, or take it from the answer key."

    claude = ("%\n% CLAUDE-GENERATED SOLUTION\n"
              "% Carried over from the .pg, where it was written by Claude (Opus 5).\n"
              if "CLAUDE-GENERATED SOLUTION" in src else "")

    # COURSE-DIFFICULTY is ours and now exists on tagged problems, so transcribe
    # it rather than asking for it again. The vocabulary is basic / moderate /
    # challenging -- NOT "advanced", which this scaffold used to suggest. The
    # distinction is deliberate (WEBWORK/README.md section 9): "advanced" implies
    # both skippable and later material, and neither is true of a problem that is
    # merely hard to start.
    m = re.search(r'^#\s*COURSE-DIFFICULTY:\s*(basic|moderate|challenging)\s*$',
                  src, re.M)
    difficulty = (f"{{{m.group(1)}}},"
                  if m else "{TODO},   % TODO  basic / moderate / challenging")

    author = tag(src, "Author")
    inst = tag(src, "Institution")
    attrib = f"% Upstream author: {author}" + (f" ({inst})" if inst else "") + "\n" if author else ""

    return f"""\\ProblemMeta{{
  topics     = {{TODO}},   % TODO
  type       = {{TODO}},   % TODO  routine / multi-part / conceptual / applied ...
  difficulty = {difficulty}
  source     = {{{source}}},
  number     = {{{number}}},
}}
% Scaffolded by pg-to-latex from {tree}/{number} at seed {seed}.
{attrib}%
% TODO Frozen from a randomised original. State here what the seed fixed, and
% TODO the invariant checked across the WHOLE random range -- see the .pg's own
% TODO header, which usually records it already.
%
% TODO Check the structure. Several answer blanks usually want \\begin{{qparts}};
% TODO a PopUp set wants \\begin{{matching}}; a checkbox list wants \\begin{{choices}}.
% TODO This scaffold flattens all of them.
{claude}\\begin{{problem}}
{indent(statement, 2)}

  \\begin{{solution}}
{indent(solution, 4)}
  \\end{{solution}}
\\end{{problem}}
"""


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("pg", nargs="?")
    ap.add_argument("-s", "--seed", type=int, default=1234)
    ap.add_argument("-o", "--out")
    ap.add_argument("-n", "--name")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args()

    if args.help or not args.pg:
        # Echo the header block, so -h cannot drift from the comment above.
        for i, line in enumerate(pathlib.Path(__file__).read_text().split("\n")):
            if i == 0:
                continue
            if not line.startswith("#"):
                break
            print(line[2:] if line.startswith("# ") else line[1:])
        return 0

    pg = pathlib.Path(args.pg).resolve()
    if not pg.is_file():
        sys.exit(f"pg-to-latex: no such file: {pg}")

    text = scaffold(pg, args.seed)

    if not args.out:
        print(text, end="")
        return 0

    name = args.name or pg.stem.replace("_", "-")
    dest = pathlib.Path(args.out).expanduser() / f"{name}.tex"
    if dest.exists():
        sys.exit(f"pg-to-latex: refusing to overwrite {dest}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(text, encoding="utf-8")
    print(f"wrote {dest}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
