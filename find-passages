#!/usr/bin/env bash
# find-passages — list the passage bank, and write its import lines for you.
# A thin shim over find-meta (the shared engine). A passage bank is the one kind
# with NO METADATA BLOCK: the directory IS the bank, every .tex in it is a
# passage, and a passage's title and label are computed from its FILE NAME --
# webwork-tips.tex gives \section{Webwork Tips}\label{sec:webwork_tips}. So there
# is nothing to search and nothing to inject: no filters, no --with, no
# --untagged, no --vocab. What this is for is --import --from (the relative
# directory, worked out for you) and --tsv (the picker feed).
#
# A PATH IS REQUIRED, and that is enforced rather than advised. The bank is a
# SIBLING SUBMODULE (teaching/passages/), not a directory inside the course, so
# name it: `find-passages teaching/passages'. With no block to tell a passage
# from any other .tex, a bare run from a course root would report every lecture
# and assessment as a passage -- so it is refused instead.
#
# See find-meta. There is no PassageMeta.sty any more; it went with
# \importpassage on 2026-09-04.
exec "$(dirname -- "$0")/find-meta" --kind passage --as find-passages "$@"
