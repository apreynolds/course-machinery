\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Titling}[2026/07/15 Shared title block for course documents]

% \subtitle + \maketitle, shared by LectureNotes.cls and CourseDocument.cls.
% The structure -- title / subtitle / "Updated <date>" -- lives here, once;
% everything the two classes want done differently (colour, a timestamp, an
% instructor marker) is a hook below, defaulting to plain.
%
% Assessment.cls deliberately does NOT load this. An assessment opens with
% \AssessmentTitle -- a NAME/ID box on an empty pagestyle -- which is a
% different artefact, not a styled title.

% datetime2 is \@date's formatter, so it belongs with the title block rather
% than in either class.
\RequirePackage[en-GB]{datetime2}
\DTMlangsetup[en-GB]{ord=raise,monthyearsep={,\space}}

\newcommand*{\subtitle}[1]{\gdef\@subtitle{#1}}
\newcommand*{\@subtitle}{}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% PER-CLASS HOOKS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Defaults are plain: no colour, no timestamp, no marker. A class overrides with
% \renewcommand.
%
% \TitleColor is a STYLE hook (e.g. \color{HeadingColor}), NOT a colour name.
% That is deliberate: it keeps this file free of any xcolor dependency, since
% only CourseDocument.cls colours anything.
\providecommand{\TitleColor}{}
\providecommand{\TitleStamp}{}  % follows the date, e.g. \space at \DTMcurrenttime
\providecommand{\TitleMarker}{} % follows the stamp; a free title hook, nobody
                                % overrides it now (the instructor-copy signal moved
                                % to the page-edge frame in InstructorNotes.sty).

\def\maketitle{%
  \vspace*{1em}%
  \par{\huge\bfseries\sffamily\TitleColor\@title}%
  \vspace{0.5em}%
  \par{\Large\sffamily\@subtitle}%
  \par{\small\itshape Updated \@date\TitleStamp\TitleMarker}%
  \vspace{0.5em}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% THE RUNNING HEAD
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A lecture's running head is its \booksection coordinate (TextRef.sty), which
% doubles as the document's title: "2.5: The Chain Rule", linked to that section
% of the book. What it LOOKS like belongs here for the same reason \maketitle
% does -- so the documents that carry one agree, and the look is changed in one
% place rather than per class.
%
% Deliberately NOT a \fancypagestyle. A named style would have to own the footer
% too, and the footer is exactly what the classes differ on (LectureNotes swaps a
% page number for a back-to-top arrow on the projector copy). So this supplies
% the head's CONTENT and RULE, each class wires them into its own fancyhdr setup:
%
%   \renewcommand{\headrulewidth}{\CourseHeadRule}
%   \fancyhead[R]{\CourseRunningHead}
%
% No fancyhdr dependency here -- these are read at shipout, by which time the
% class that wanted a head has loaded it.
\newcommand{\CourseHeadRule}{0.4pt}

% \BookSectionHead is TextRef's; \providecommand because Titling loads first and
% a class may use this head without TextRef ever being asked for a coordinate,
% in which case the head is empty and the rule sits over nothing.
\providecommand{\BookSectionHead}{}
% \small: a running head is signage, not content, and at the projector copy's
% 17pt base a full-size head would crowd the material it labels.
\newcommand{\CourseRunningHead}{{\small\scshape\BookSectionHead}}
